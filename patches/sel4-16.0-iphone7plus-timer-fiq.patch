diff --git a/include/plat/iphone7plus/plat/machine/interrupt.h b/include/plat/iphone7plus/plat/machine/interrupt.h
new file mode 100644
index 00000000..589dc07a
--- /dev/null
+++ b/include/plat/iphone7plus/plat/machine/interrupt.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#pragma once
+
+#include <config.h>
+#include <machine/interrupt.h>
+#include <mode/machine.h>
+#include <util.h>
+
+/* The first bring-up target exposes only the kernel's synthetic timer IRQ. */
+#define KERNEL_TIMER_IRQ 0
+#define NUM_SGIS 16
+#define APPLE_CNTV_ENABLE  BIT(0)
+#define APPLE_CNTV_IMASK   BIT(1)
+#define APPLE_CNTV_ISTATUS BIT(2)
+
+static const irq_t irqInvalid = (irq_t) -1;
+extern irq_t apple_timer_active_irq;
+
+static inline bool_t apple_timer_firing(void)
+{
+    word_t control = 0;
+    SYSTEM_READ_WORD(CNT_CTL, control);
+    return (control & (APPLE_CNTV_ENABLE | APPLE_CNTV_IMASK | APPLE_CNTV_ISTATUS)) ==
+           (APPLE_CNTV_ENABLE | APPLE_CNTV_ISTATUS);
+}
+
+static inline irq_t getActiveIRQ(void)
+{
+    if (apple_timer_active_irq == irqInvalid && apple_timer_firing()) {
+        apple_timer_active_irq = KERNEL_TIMER_IRQ;
+    }
+    return apple_timer_active_irq;
+}
+
+static inline bool_t isIRQPending(void)
+{
+    return apple_timer_firing();
+}
+
+static inline void maskInterrupt(bool_t disable, irq_t irq)
+{
+    if (irq != KERNEL_TIMER_IRQ) {
+        return;
+    }
+    word_t control = 0;
+    SYSTEM_READ_WORD(CNT_CTL, control);
+    if (disable) {
+        control |= APPLE_CNTV_IMASK;
+    } else {
+        control &= ~APPLE_CNTV_IMASK;
+    }
+    SYSTEM_WRITE_WORD(CNT_CTL, control);
+    isb();
+}
+
+static inline void ackInterrupt(irq_t irq)
+{
+    if (irq == KERNEL_TIMER_IRQ) {
+        /* timerTick()/ackDeadlineIRQ() deasserts the architectural source. */
+        apple_timer_active_irq = irqInvalid;
+    }
+}
+
+static inline void handleSpuriousIRQ(void)
+{
+    /* A timer-only build cannot safely return from an unknown FIQ source. */
+    halt();
+}
