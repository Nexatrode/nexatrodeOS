diff --git a/src/plat/iphone7plus/config.cmake b/src/plat/iphone7plus/config.cmake
new file mode 100644
index 00000000..8c601cab
--- /dev/null
+++ b/src/plat/iphone7plus/config.cmake
@@ -0,0 +1,37 @@
+#
+# Copyright 2026
+# SPDX-License-Identifier: GPL-2.0-only
+#
+
+declare_platform(iphone7plus KernelPlatformIPhone7Plus PLAT_IPHONE7PLUS KernelSel4ArchAarch64)
+
+if(KernelPlatformIPhone7Plus)
+    declare_seL4_arch(aarch64)
+    # A10 implements AArch64 but is not an Arm Cortex core. A53 is used here
+    # only as the closest supported ARMv8-A kernel configuration; validate the
+    # final PA/cache settings against hardware before treating this as a port.
+    set(KernelArmCortexA53 ON)
+    set(KernelArchArmV8a ON)
+    set(KernelArmHypervisorSupport OFF)
+    config_set(KernelARMPlatform ARM_PLAT "iphone7plus")
+    # Compile fixture only: runtime memory comes from the boot handoff and will
+    # replace this synthetic DRAM node before any kernel image is loaded.
+    list(APPEND KernelDTSList "src/plat/iphone7plus/compile-fixture.dts")
+    declare_default_headers(
+        TIMER_FREQUENCY 24000000
+        MAX_IRQ 0
+        # Temporary build-time value copied from existing Microkit targets;
+        # do not treat it as measured A10 WCET or use it to budget real apps.
+        CLK_MAGIC 375299969u
+        CLK_SHIFT 53u
+        KERNEL_WCET 10u
+        TIMER drivers/timer/arm_generic.h
+        INTERRUPT_CONTROLLER plat/machine/interrupt.h
+    )
+endif()
+
+add_sources(
+    DEP "KernelPlatformIPhone7Plus"
+    CFILES src/plat/iphone7plus/machine/hardware.c src/arch/arm/machine/l2c_nop.c
+           src/drivers/timer/generic_timer.c
+)
diff --git a/src/plat/iphone7plus/machine/hardware.c b/src/plat/iphone7plus/machine/hardware.c
new file mode 100644
index 00000000..98e79aea
--- /dev/null
+++ b/src/plat/iphone7plus/machine/hardware.c
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <machine.h>
+#include <arch/machine.h>
+#include <mode/machine.h>
+#include <plat/platform_gen.h>
+
+void setIRQTrigger(irq_t irq, bool_t trigger)
+{
+    (void)irq;
+    (void)trigger;
+}
+
+bool_t plat_SGITargetValid(word_t target)
+{
+    return target == 0;
+}
+
+void plat_sendSGI(word_t irq, word_t target)
+{
+    (void)irq;
+    (void)target;
+}
+
+irq_t apple_timer_active_irq = irqInvalid;
+
+BOOT_CODE void cpu_initLocalIRQController(void)
+{
+}
+
+BOOT_CODE void initIRQController(void)
+{
+    word_t control = 0;
+
+    /* A10 has no EL2. Use CNTV as seL4's EL1 virtual timer and suppress an
+     * inherited physical-timer source before enabling timer FIQs to userland. */
+    SYSTEM_WRITE_WORD("cntp_ctl_el0", 0);
+    /* init_cpu() already called initTimer(), which enabled CNTV. Preserve
+     * ENABLE while masking it here; init_irqs() later removes IMASK. */
+    SYSTEM_READ_WORD(CNT_CTL, control);
+    control |= APPLE_CNTV_IMASK;
+    SYSTEM_WRITE_WORD(CNT_CTL, control);
+    isb();
+    apple_timer_active_irq = irqInvalid;
+}
