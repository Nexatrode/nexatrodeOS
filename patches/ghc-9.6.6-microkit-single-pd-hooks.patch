+++ b/rts/sel4/TTY.c
@@ -0,0 +1,12 @@
+/*
+ * Terminal cleanup hook for the initial non-interactive seL4 RTS.
+ * POSIX terminal support is not configured for this target.
+ */
+
+#include "Rts.h"
+#include "posix/TTY.h"
+
+void resetTerminalSettings(void)
+{
+    /* There are no termios settings to restore in a Microkit PD. */
+}
