--- /dev/null
+++ b/rts/sel4/OSThreads.c
@@ -0,0 +1,22 @@
+/*
+ * Minimal OS-thread lifecycle hooks for the initial single-threaded seL4 RTS.
+ * GHC's non-threaded POSIX implementation has exactly these semantics.
+ */
+
+#include "Rts.h"
+#include "rts/OSThreads.h"
+
+#if defined(THREADED_RTS)
+#error "The initial Microkit runtime is non-threaded"
+#endif
+
+void freeThreadingResources(void)
+{
+    /* No host thread resources exist in a Microkit protection domain. */
+}
+
+uint32_t getNumberOfProcessors(void)
+{
+    /* One schedulable Haskell capability is supported by this RTS build. */
+    return 1;
+}
