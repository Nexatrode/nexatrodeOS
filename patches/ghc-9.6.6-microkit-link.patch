+  AC_CHECK_LIB(m, atan, HaveLibM=YES, HaveLibM=NO)
+fi
 if test $HaveLibM = YES
 then
   AC_DEFINE([HAVE_LIBM], [1], [Define to 1 if you need to link with libm])
@@ -970,8 +975,13 @@
 AC_SUBST(UseSystemLibFFI)
 
