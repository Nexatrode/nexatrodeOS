-AC_CHECK_LIB([dl], [dlopen], HaveLibdl=YES, HaveLibdl=NO)
+if test "$TargetOS" = "sel4"; then
+  dnl Dynamic loading is outside the static Microkit process model.
+  HaveLibdl=NO
+else
+  AC_CHECK_LIB([dl], [dlopen])
+  AC_CHECK_LIB([dl], [dlopen], HaveLibdl=YES, HaveLibdl=NO)
+fi
 AC_SUBST([UseLibdl],[$HaveLibdl])
