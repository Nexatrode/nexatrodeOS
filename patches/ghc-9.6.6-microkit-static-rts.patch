--- a/rts/sel4/LinkerStubs.c
+++ b/rts/sel4/LinkerStubs.c
@@ -0,0 +1,69 @@
+/*
+ * Static-only RTS hooks for Microkit.
+ *
+ * Microkit programs are linked as complete images, so GHCi's runtime object
+ * loader and object unloading are unavailable. Keep GC and shutdown hooks
+ * inert, while retaining static foreign-export roots registered by generated
+ * module initializers.
+ */
+
+#include "Rts.h"
+#include "CheckUnload.h"
+#include "ForeignExports.h"
+#include "LinkerInternals.h"
+#include "linker/MMap.h"
+
+ObjectCode *objects = NULL;
+ObjectCode *loaded_objects = NULL;
+uint8_t object_code_mark_bit = 0;
+int n_unloaded_objects = 0;
+
+void exitLinker(void) {}
+
+/* Static Microkit images cannot allocate writable executable pages at runtime. */
+void *mmapAnonForLinker(size_t bytes) { (void)bytes; return NULL; }
+void mprotectForLinker(void *start, size_t len, MemoryAccess mode)
+{
+    (void)start;
+    (void)len;
+    (void)mode;
+    barf("runtime executable-memory protection is unavailable on seL4");
+}
+void munmapForLinker(void *addr, size_t bytes, const char *caller)
+{
+    (void)addr;
+    (void)bytes;
+    (void)caller;
+}
+
+void initUnloadCheck(void) {}
+void exitUnloadCheck(void) {}
+bool prepareUnloadCheck(void) { return false; }
+void markObjectCode(const void *addr) { (void)addr; }
+void checkUnload(void) {}
+void insertOCSectionIndices(ObjectCode *oc) { (void)oc; }
+
+static struct ForeignExportsList *pending = NULL;
+
+void registerForeignExports(struct ForeignExportsList *exports)
+{
+    exports->next = pending;
+    exports->oc = NULL;
+    exports->stable_ptrs = NULL;
+    pending = exports;
+}
+
+void processForeignExports(void)
+{
+    while (pending != NULL) {
+        struct ForeignExportsList *exports = pending;
+        pending = exports->next;
+        exports->next = NULL;
+        for (int i = 0; i < exports->n_entries; i++) {
+            (void)getStablePtr(exports->exports[i]);
+        }
+    }
+}
+
+void foreignExportsLoadingObject(ObjectCode *oc) { (void)oc; }
+void foreignExportsFinishedLoadingObject(void) {}
