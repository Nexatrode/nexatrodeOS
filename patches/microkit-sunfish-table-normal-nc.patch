+#[test]
+fn normal_nc_requires_explicit_uncached_aarch64_mapping() {
+    let xml = |attrs: &str| format!(
+        "<system><memory_region name='screen' size='0x1000'/>\
+         <protection_domain name='test'><program_image path='test'/>\
+         <map mr='screen' vaddr='0x3000000' {attrs}/></protection_domain></system>"
+    );
+    let config = sel4::Config {
+        hypervisor: false,
+        ..DEFAULT_AARCH64_KERNEL_CONFIG
+    };
+    let parsed = sdf::parse_xml(
+        Path::new("normal_nc.system"),
+        &xml("cached='false' normal_nc='true'"),
+        &config,
+        &Vec::new(),
+    )
+    .unwrap();
+    let map = &parsed.protection_domains.get("test").unwrap().maps[0];
+    assert!(map.normal_nc);
+    assert!(!map.cached);
+
+    for (attrs, kernel_config) in [
+        ("normal_nc='true'", &config),
+        ("cached='false' normal_nc='true'", &DEFAULT_AARCH64_KERNEL_CONFIG),
+        ("cached='false' normal_nc='true'", &DEFAULT_X86_64_KERNEL_CONFIG),
+    ] {
+        let error = sdf::parse_xml(
+            Path::new("normal_nc.system"),
+            &xml(attrs),
+            kernel_config,
+            &Vec::new(),
+        )
+        .unwrap_err();
+        assert!(error.contains("normal_nc requires cached='false' on AArch64 without hypervisor support"));
+    }
+}
