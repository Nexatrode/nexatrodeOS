--- /dev/null
+++ b/libraries/base/cbits/sel4_poll.c
@@ -0,0 +1,40 @@
+/*
+ * Restricted poll implementation for the initial Microkit base port.
+ * Descriptor readiness is not exposed to a protection domain yet; a zero-
+ * descriptor poll is a timer wait serviced through the RTS event bridge.
+ */
+
+#include <errno.h>
+#include <poll.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+extern bool sel4_rts_read_monotonic_ns(uint64_t *nsec);
+extern void sel4_rts_wait_for_event(uint64_t deadline_ns);
+
+int poll(struct pollfd *fds, nfds_t count, int timeout_ms)
+{
+    if (count != 0) {
+        errno = ENOSYS;
+        return -1;
+    }
+    (void)fds;
+
+    if (timeout_ms == 0) {
+        return 0;
+    }
+
+    uint64_t deadline = UINT64_MAX;
+    if (timeout_ms > 0) {
+        uint64_t now;
+        if (!sel4_rts_read_monotonic_ns(&now)) {
+            errno = ENOSYS;
+            return -1;
+        }
+        const uint64_t delta = (uint64_t)timeout_ms * UINT64_C(1000000);
+        deadline = UINT64_MAX - now < delta ? UINT64_MAX - 1 : now + delta;
+    }
+
+    sel4_rts_wait_for_event(deadline);
+    return 0;
+}
