+undefineSel4HostFeature :: String -> String
+undefineSel4HostFeature line
+    | "#define " `isPrefixOf` line
+    , featureName `elem` sel4UnavailableFeatures
+        = "/* #undef " ++ featureName ++ " */"
+    | otherwise = line
+  where
+    featureName = takeWhile (/=' ') (drop 8 line)
 
+sel4UnavailableFeatures :: [String]
+sel4UnavailableFeatures =
+    [ "HAVE_CLOCK_GETTIME", "HAVE_FORK", "HAVE_GETPID", "HAVE_GETTIMEOFDAY"
+    , "HAVE_LIBPTHREAD", "HAVE_PTHREAD_H", "HAVE_SCHED_H", "HAVE_SIGNAL_H"
+    , "HAVE_SYS_MMAN_H", "HAVE_SYS_SELECT_H", "HAVE_TERMIOS_H", "HAVE_TIMES"
+    , "HTYPE_CC_T", "HTYPE_SPEED_T", "HTYPE_TCFLAG_T"
+    ]
+
