       THOnionHost h -> SocksAddrDomainName h
       THDomainName h -> SocksAddrDomainName $ B.pack h
 
+-- | Use the same TLS parameters and peer-certificate handoff as the socket
+-- path, with a backend-opening action supplied by the platform. The action
+-- opens the underlying network capability; closing the TLS context closes
+-- the backend when the callback completes.
+runTLSBackendTransportClient :: T.Supported -> Maybe XS.CertificateStore -> TransportClientConfig -> TransportHost -> ServiceName -> Maybe C.KeyHash -> IO T.Backend -> (TLS 'TClient -> IO a) -> IO a
+runTLSBackendTransportClient tlsParams caStore_ cfg@TransportClientConfig {clientCredentials, clientALPN, useSNI} host port keyHash openBackend client = do
+  serverCert <- newEmptyTMVarIO
+  clientCredsSent <- newIORef False
+  let hostName = B.unpack $ strEncode host
+      clientParams = mkTLSClientParams tlsParams caStore_ hostName port keyHash clientCredentials clientCredsSent clientALPN useSNI serverCert
+      tCfg = clientTransportConfig cfg
+  E.bracket (openBackend >>= connectTLSBackend (Just hostName) tCfg clientParams) closeTLS $ \ctx -> do
+    chain <- takePeerCertChain serverCert
+    sent <- readIORef clientCredsSent
+    transport <- getTransportConnection tCfg sent chain ctx
+    client transport
+
 connectTCPClient :: HostName -> ServiceName -> IO Socket
