 connectTLS :: T.TLSParams p => Maybe HostName -> TransportConfig -> p -> Socket -> IO T.Context
 connectTLS host_ TransportConfig {logTLSErrors} params sock =
-  E.bracketOnError (T.contextNew sock params) closeTLS $ \ctx ->
+  connectTLSWith host_ logTLSErrors (T.contextNew sock params)
+
+-- | Connect through an already-open TLS backend, for transports whose TCP
+-- connection is supplied by an isolated service rather than a POSIX Socket.
+connectTLSBackend :: T.TLSParams p => Maybe HostName -> TransportConfig -> p -> T.Backend -> IO T.Context
+connectTLSBackend host_ TransportConfig {logTLSErrors} params backend =
+  connectTLSWith host_ logTLSErrors (T.contextNew backend params `E.onException` T.backendClose backend)
+
+connectTLSWith :: Maybe HostName -> Bool -> IO T.Context -> IO T.Context
+connectTLSWith host_ logTLSErrors openContext =
+  E.bracketOnError openContext closeTLS $ \ctx ->
     logHandshakeErrors (T.handshake ctx) $> ctx
   where
     logHandshakeErrors = if logTLSErrors then (`catchAll` logThrow) else id
