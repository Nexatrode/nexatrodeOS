+-- Keep the normal host path above, and expose the VFS selector used by
+-- capability-backed builds. The sqlite-simple wrapper does not export open2,
+-- so construct its small Connection wrapper around the direct binding.
+openWithVfs :: String -> String -> TrackQueries -> IO Connection
+openWithVfs f vfs track = do
+  database <-
+    SQLite3.open2
+      (T.pack f)
+      [SQLite3.SQLOpenReadWrite, SQLite3.SQLOpenCreate, SQLite3.SQLOpenFullMutex]
+      (SQLite3.SQLVFSCustom $ T.pack vfs)
+  tempNameCounter <- newIORef 0
+  let conn = SQLInternal.Connection database tempNameCounter
+  slow <- TM.emptyIO
+  pure Connection {conn, slow, track}
+
 close :: Connection -> IO ()
 close = SQL.close . conn
 
