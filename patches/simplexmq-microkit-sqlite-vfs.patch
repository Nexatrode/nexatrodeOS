 connectDB path functions key track = do
+#ifdef SIMPLEX_MICROKIT
+  db <- DB.openWithVfs path "nexatrode-storage" track
+#else
   db <- DB.open path track
+#endif
   prepare db `onException` DB.close db
   -- _printPragmas db path
   pure db
