+#[test]
+fn aarch64_16k_geometry_and_xml() {
+    let mut config = DEFAULT_AARCH64_KERNEL_CONFIG;
+    config.hypervisor = false;
+    config.minimum_page_size = 0x4000;
+    config.object_sizes.small_page = 14;
+    config.object_sizes.large_page = 25;
+    config.address_space_constants.page_table_index_bits = 11;
+    config.address_space_constants.vspace_index_bits = Some(11);
+    assert_eq!(config.page_sizes(), [0x4000, 0x2000000]);
+    assert_eq!(config.vspace_level_index_bits(0), 1);
+    for level in 1..4 { assert_eq!(config.vspace_level_index_bits(level), 11); }
+    for size in [0x4000u64, 0x2000000] {
+        assert_eq!(sel4::PageSize::from(size) as u64, size);
+        let xml = format!(r#"<system><memory_region name="ram" size="{size}" page_size="{size}" />
+          <protection_domain name="test"><program_image path="test.elf" /></protection_domain></system>"#);
+        assert!(sdf::parse_xml(Path::new("16k.system"), &xml, &config, &vec![]).is_ok());
+    }
+    let xml = r#"<system><memory_region name="bad" size="0x1000" page_size="0x1000" />
+       <protection_domain name="test"><program_image path="test.elf" /></protection_domain></system>"#;
+    assert!(sdf::parse_xml(Path::new("16k.system"), xml, &config, &vec![]).is_err());
+}
