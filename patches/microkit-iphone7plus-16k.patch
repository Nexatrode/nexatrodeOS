+            set(&mut tables, 2, ((addr >> 25) & 2047) as usize, addr | 0x601);
+        }
+        assert_eq!(first_vaddr & (block-1), first_paddr & (block-1));
+        let upper_l1 = tables[4].0 | 3;
+        let upper_l2 = tables[5].0 | 3;
+        set(&mut tables, 3, ((first_vaddr >> 47) & 1) as usize, upper_l1);
+        set(&mut tables, 4, ((first_vaddr >> 36) & 2047) as usize, upper_l2);
