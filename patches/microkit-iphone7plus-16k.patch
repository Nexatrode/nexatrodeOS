+            let (addr, size) = elf.find_symbol(name).expect("missing 16 KiB table");
+            assert_eq!(size, 16384); assert_eq!(addr & 16383, 0);
+            (addr, size, vec![0u8; 16384])
+        }).collect();
+        fn set(t: &mut [(u64,u64,Vec<u8>)], table: usize, index: usize, value: u64) {
+            assert_eq!(&t[table].2[index*8..index*8+8], &[0; 8]);
+            t[table].2[index*8..index*8+8].copy_from_slice(&value.to_le_bytes());
+        }
