<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="recovery_control" size="0x1000" />
    <memory_region name="broker_queue" size="0x1000" />
    <memory_region name="splash" size="0x1600000" page_size="0x200000"
                   phys_addr="0x9c000000" />

    <protection_domain name="wlfw_recovery_supervisor" priority="100"
                       budget="200000" period="200000">
        <program_image path="wlfw-recovery-supervisor.elf" />
        <map mr="recovery_control" vaddr="0x40000000" perms="rw" cached="false"
             setvar_vaddr="control_vaddr" />
        <map mr="broker_queue" vaddr="0x40001000" perms="rw" cached="false"
             setvar_vaddr="queue_vaddr" />
        <map mr="splash" vaddr="0x50000000" perms="rw" cached="false"
             setvar_vaddr="splash_vaddr" />

        <protection_domain name="wlfw_recovery_broker" priority="99"
                           budget="200000" period="200000" id="1">
            <program_image path="wlfw-recovery-broker.elf" />
            <map mr="recovery_control" vaddr="0x40000000" perms="r" cached="false"
                 setvar_vaddr="control_vaddr" />
            <map mr="broker_queue" vaddr="0x40001000" perms="rw" cached="false"
                 setvar_vaddr="queue_vaddr" />
        </protection_domain>
    </protection_domain>

    <channel>
        <end pd="wlfw_recovery_supervisor" id="0" />
        <end pd="wlfw_recovery_broker" id="0" pp="true" />
    </channel>
</system>
