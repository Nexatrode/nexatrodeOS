<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="splash" size="0x1600000" page_size="0x200000"
                   phys_addr="0x9c000000" />
    <protection_domain name="wlan_protocol_probe" priority="1">
        <program_image path="wlan_protocol_probe.elf" />
        <map mr="splash" vaddr="0x42000000" perms="rw" cached="false"
             setvar_vaddr="splash_fb" />
    </protection_domain>
</system>
