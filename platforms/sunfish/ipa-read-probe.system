<?xml version="1.0" encoding="UTF-8"?>
<system>
    <!-- IPA's GSI register range is contained in this single source-pinned
         window. Read-only does not mean power-safe: a bootable image also
         needs the source-matched IPA SVS2 bandwidth vote first. -->
    <memory_region name="ipa_mmio" size="0x34000" page_size="0x1000"
                   phys_addr="0x01e00000" />
    <memory_region name="splash" size="0x1600000" page_size="0x200000"
                   phys_addr="0x9c000000" />
    <protection_domain name="ipa_read_probe" priority="99" stack_size="0x10000">
        <program_image path="ipa_read_probe.elf" />
        <map mr="ipa_mmio" vaddr="0x40000000" perms="r" cached="false"
             setvar_vaddr="ipa_mmio" />
        <map mr="splash" vaddr="0x42000000" perms="rw" cached="false"
             setvar_vaddr="splash_fb" />
    </protection_domain>
</system>
