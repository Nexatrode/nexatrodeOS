<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="touch_se7" size="0x4000" page_size="0x1000"
                   phys_addr="0xa84000" />
    <memory_region name="gpio6_north" size="0x1000" page_size="0x1000"
                   phys_addr="0x3906000" />
    <memory_region name="gpio7_north" size="0x1000" page_size="0x1000"
                   phys_addr="0x3907000" />
    <memory_region name="gpio8_north" size="0x1000" page_size="0x1000"
                   phys_addr="0x3908000" />
    <memory_region name="gpio9_north" size="0x1000" page_size="0x1000"
                   phys_addr="0x3909000" />
    <memory_region name="gpio72_north" size="0x1000" page_size="0x1000"
                   phys_addr="0x3948000" />
    <protection_domain name="touch_mmio" priority="99" smc="true">
        <program_image path="touch-mmio-probe.elf" />
        <map mr="touch_se7" vaddr="0x40000000" perms="r" cached="false"
             setvar_vaddr="touch_i2c_vaddr" />
        <map mr="gpio6_north" vaddr="0x42000000" perms="r" cached="false"
             setvar_vaddr="gpio6_vaddr" />
        <map mr="gpio7_north" vaddr="0x42001000" perms="r" cached="false"
             setvar_vaddr="gpio7_vaddr" />
        <map mr="gpio8_north" vaddr="0x42002000" perms="r" cached="false"
             setvar_vaddr="gpio8_vaddr" />
        <map mr="gpio9_north" vaddr="0x42003000" perms="r" cached="false"
             setvar_vaddr="gpio9_vaddr" />
        <map mr="gpio72_north" vaddr="0x42004000" perms="r" cached="false"
             setvar_vaddr="gpio72_vaddr" />
    </protection_domain>
    <protection_domain name="touch_watchdog" priority="1" smc="true">
        <program_image path="slint-reset.elf" />
    </protection_domain>
</system>
