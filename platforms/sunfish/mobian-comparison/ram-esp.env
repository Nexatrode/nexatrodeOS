# SPDX-License-Identifier: GPL-2.0+
# Temporary comparison transport. The ESP arrives in ABL's RAM-disk handoff.
bootdelay=0
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
fastboot=fastboot -l $fastboot_addr_r usb 0
bootcmd=if test -n "${prevbl_initrd_start_addr}"; then if blkmap create compare && blkmap map compare 0 20000 mem ${prevbl_initrd_start_addr} preserve; then bootefi bootmgr; fi; fi; echo COMPARISON RAM ESP BOOT FAILED; run fastboot
