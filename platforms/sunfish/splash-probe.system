<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="splash" size="0x1000000" page_size="0x200000"
                   phys_addr="0x9c000000" />
    <protection_domain name="splash_probe" priority="1" smc="true">
        <program_image path="splash-probe.elf" />
        <map mr="splash" vaddr="0x40000000" perms="r" cached="false"
             setvar_vaddr="splash_vaddr" />
    </protection_domain>
</system>
