<?xml version="1.0"?>
<system>
    <!-- Reuse the known continuous-splash allocation to show the bounded
         directory result on-device when the debug UART is unavailable. -->
    <memory_region name="splash" size="0x1600000" page_size="0x200000"
                   phys_addr="0x9c000000" />
    <!-- SMEM remains no-map in the input DT; this diagnostic grants a bounded
         read-only view only to one PD. The TCSR page is RW solely to acquire
         and release shared hardware spinlock 3. -->
    <memory_region name="smem_snapshot" size="0x200000" page_size="0x1000"
                   phys_addr="0x86000000" />
    <memory_region name="tcsr_smem_lock" size="0x1000" page_size="0x1000"
                   phys_addr="0x01f43000" />
    <protection_domain name="smem_probe" priority="99" smc="false">
        <program_image path="smem-directory-probe.elf" />
        <map mr="splash" vaddr="0x42000000" perms="rw" cached="false"
             setvar_vaddr="splash_vaddr" />
        <map mr="smem_snapshot" vaddr="0x40000000" perms="r" cached="false"
             setvar_vaddr="smem_vaddr" />
        <map mr="tcsr_smem_lock" vaddr="0x41000000" perms="rw" cached="false"
             setvar_vaddr="tcsr_lock_vaddr" />
    </protection_domain>
    <protection_domain name="smem_probe_reset" priority="1" smc="true">
        <program_image path="slint-reset.elf" />
    </protection_domain>
</system>
