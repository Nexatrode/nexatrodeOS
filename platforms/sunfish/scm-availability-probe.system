<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="splash" size="0x1600000" page_size="0x200000"
                   phys_addr="0x9c000000" />
    <protection_domain name="scm_availability_probe" priority="99"
                       stack_size="0x8000" smc="true">
        <program_image path="scm-availability-probe.elf" />
        <map mr="splash" vaddr="0x50000000" perms="rw" cached="false"
             setvar_vaddr="splash_vaddr" />
    </protection_domain>
</system>
