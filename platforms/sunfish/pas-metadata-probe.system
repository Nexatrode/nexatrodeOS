<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="pas_metadata" size="0x5000" page_size="0x1000" />
    <memory_region name="splash" size="0x1600000" page_size="0x200000"
                   phys_addr="0x9c000000" />
    <protection_domain name="pas_metadata_probe" priority="99" stack_size="0x20000">
        <program_image path="pas_metadata_probe.elf" />
        <map mr="pas_metadata" vaddr="0x40000000" perms="rw" cached="false"
             setvar_vaddr="pas_metadata" />
        <setvar symbol="pas_metadata_paddr" region_paddr="pas_metadata" />
        <map mr="splash" vaddr="0x42000000" perms="rw" cached="false"
             setvar_vaddr="splash_fb" />
    </protection_domain>
</system>
