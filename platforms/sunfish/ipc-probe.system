<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="ipc_result" size="0x1000" page_size="0x1000" />

    <protection_domain name="ipc_service" priority="100" passive="true">
        <program_image path="ipc-service.elf" />
        <map mr="ipc_result" vaddr="0x40000000" perms="rw" cached="false" />
    </protection_domain>
    <protection_domain name="ipc_client" priority="99" budget="200000" period="200000">
        <program_image path="ipc-client.elf" />
        <map mr="ipc_result" vaddr="0x40000000" perms="rw" cached="false" />
    </protection_domain>
    <protection_domain name="ipc_intruder" priority="90" budget="200000" period="200000">
        <program_image path="ipc-intruder.elf" />
    </protection_domain>
    <protection_domain name="ipc_witness" priority="1" budget="200000" period="200000" smc="true">
        <program_image path="ipc-witness.elf" />
        <map mr="ipc_result" vaddr="0x40000000" perms="r" cached="false" />
    </protection_domain>

    <channel>
        <end pd="ipc_service" id="0" />
        <end pd="ipc_client" id="0" pp="true" />
    </channel>
</system>
