<?xml version="1.0" encoding="UTF-8"?>
<system>
    <!-- Shared device mapping. Spinner cannot yield to observer voluntarily. -->
    <memory_region name="screen" size="0x100000" page_size="0x4000" phys_addr="0x8bb80c000" />
    <protection_domain name="spinner" priority="100" budget="20000" period="200000" stack_size="0x4000">
        <program_image path="spinner.elf" />
        <map mr="screen" vaddr="0x40000000" perms="rw" cached="false" setvar_vaddr="smoke_framebuffer" />
    </protection_domain>
    <protection_domain name="observer" priority="99" budget="20000" period="200000" stack_size="0x4000">
        <program_image path="observer.elf" />
        <map mr="screen" vaddr="0x40000000" perms="rw" cached="false" setvar_vaddr="smoke_framebuffer" />
    </protection_domain>
</system>
