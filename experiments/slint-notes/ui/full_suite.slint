// Eight-workspace, touch-first Slint shell for the iPhone 7 Plus. Data in this
// image is volatile until the phone has a storage and service bridge.
component AppCard inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <color> accent;
    callback chosen();
    background: #0b1825;
    border-color: accent;
    border-width: 1px;
    Text {
        x: 10px; y: 10px; width: parent.width - 20px;
        text: label; color: accent; font-size: 18px; font-weight: 700;
    }
    Text {
        x: 10px; y: 43px; width: parent.width - 20px;
        text: detail; color: #a9c1cf; font-size: 13px;
    }
    TouchArea { width: parent.width; height: parent.height; clicked => { chosen(); } }
}

component SoftKey inherits Rectangle {
    in property <string> label;
    callback typed(string);
    background: #10202d;
    border-color: #294454;
    border-width: 1px;
    Text {
        width: parent.width; height: parent.height;
        text: label; color: #e8f5fb; font-size: 17px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    TouchArea { width: parent.width; height: parent.height; clicked => { typed(label); } }
}

component TouchKeyboard inherits Rectangle {
    callback typed(string);
    background: #09141f;
    border-color: #203747;
    border-width: 2px;

    for key[index] in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]: SoftKey {
        x: 5px + index * (parent.width - 10px) / 10;
        y: 5px; width: (parent.width - 10px) / 10 - 2px; height: 39px;
        label: key; typed(k) => { root.typed(k); }
    }
    for key[index] in ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"]: SoftKey {
        x: 5px + index * (parent.width - 10px) / 10;
        y: 49px; width: (parent.width - 10px) / 10 - 2px; height: 39px;
        label: key; typed(k) => { root.typed(k); }
    }
    for key[index] in ["A", "S", "D", "F", "G", "H", "J", "K", "L"]: SoftKey {
        x: 18px + index * (parent.width - 36px) / 9;
        y: 93px; width: (parent.width - 36px) / 9 - 2px; height: 39px;
        label: key; typed(k) => { root.typed(k); }
    }
    for key[index] in ["Z", "X", "C", "V", "B", "N", "M"]: SoftKey {
        x: 42px + index * (parent.width - 84px) / 7;
        y: 137px; width: (parent.width - 84px) / 7 - 2px; height: 39px;
        label: key; typed(k) => { root.typed(k); }
    }
    SoftKey {
        x: 5px; y: 181px; width: (parent.width - 20px) / 3; height: 39px;
        label: "SPACE"; typed(k) => { root.typed(k); }
    }
    SoftKey {
        x: 10px + (parent.width - 20px) / 3; y: 181px;
        width: (parent.width - 20px) / 3; height: 39px;
        label: "ENTER"; typed(k) => { root.typed(k); }
    }
    SoftKey {
        x: 15px + 2 * (parent.width - 20px) / 3; y: 181px;
        width: (parent.width - 20px) / 3; height: 39px;
        label: "DELETE"; typed(k) => { root.typed(k); }
    }
}

export component NotesWindow inherits Window {
    title: "Personal OS — Slint Suite";
    background: #050a12;
    preferred-width: 414px;
    preferred-height: 736px;
    min-width: 400px;
    min-height: 700px;

    // Home plus the eight workspaces of the existing QEMU graphics suite.
    in-out property <int> page: 0;
    in-out property <int> edit-target: 0;
    in-out property <string> note: "";
    in-out property <string> status: "VOLATILE · NOT SAVED";
    in-out property <string> contact-name: "";
    in-out property <string> contact-phone: "";
    in-out property <string> calendar-item: "";
    in-out property <string> message-peer: "";
    in-out property <string> message-body: "";
    in-out property <string> calc-display: "0";
    in-out property <string> phone-number: "";
    in-out property <string> phone-status: "IDLE";
    in-out property <string> perf: "";
    in property <length> keyboard-inset: 0px;
    in property <length> top-inset: 0px;
    callback save-note(string);
    callback key-tapped(string);
    callback action(string);
    callback calculator-key(string);

    Rectangle {
        y: root.top-inset; width: 100%; height: parent.height - root.top-inset;
        background: #050a12;

        Rectangle { x: 17px; y: 17px; width: 7px; height: 7px; background: #28d8e8; }
        Text { x: 31px; y: 12px; text: "PERSONAL OS"; color: #45e1ee; font-size: 19px; font-weight: 700; }
        Rectangle { x: 17px; y: 42px; width: parent.width - 34px; height: 1px; background: #174452; }
        Text {
            x: 17px; y: 51px; width: parent.width - 32px;
            text: root.page == 0 ? "WORKSPACES" :
                  root.page == 1 ? "PRIVATE NOTES" :
                  root.page == 2 ? "CONTACTS" :
                  root.page == 3 ? "CALCULATOR" :
                  root.page == 4 ? "CLOCK" :
                  root.page == 5 ? "CALENDAR" :
                  root.page == 6 ? "MESSAGES" :
                  root.page == 7 ? "PHONE DEMO" : "SETTINGS";
            color: #eef8fd; font-size: 32px; font-weight: 700;
        }
        if root.page != 0: Rectangle {
            x: parent.width - 110px; y: 113px; width: 94px; height: 45px;
            background: #183a50; border-color: #68ddc2; border-width: 2px;
            Text { width: parent.width; height: parent.height; text: "HOME";
                color: #ffffff; font-size: 17px;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.page = 0; root.edit-target = 0; } }
        }
        Text {
            x: 18px; y: 120px; width: parent.width - 135px;
            text: root.page == 0 ? "TOUCH A WORKSPACE" :
                  root.page == 1 ? "PRIVATE · ON DEVICE" :
                  root.page == 2 ? "PEOPLE AND DETAILS" :
                  root.page == 3 ? "FOUR FUNCTION" :
                  root.page == 4 ? "UTC TIME" :
                  root.page == 5 ? "REMINDERS" :
                  root.page == 6 ? "EXPLICIT PEERS" :
                  root.page == 7 ? "NO MODEM" : "LOCAL ONLY";
            color: #ffffff; font-size: 17px;
        }

        if root.page == 0: AppCard { x: 17px; y: 176px; width: (parent.width - 44px) / 2; height: 80px;
            label: "NOTES"; detail: "PRIVATE NOTES"; accent: #68ddc2; chosen => { root.page = 1; root.edit-target = 1; } }
        if root.page == 0: AppCard { x: 27px + (parent.width - 44px) / 2; y: 176px; width: (parent.width - 44px) / 2; height: 80px;
            label: "CONTACTS"; detail: "PEOPLE"; accent: #b4a0ff; chosen => { root.page = 2; root.edit-target = 2; } }
        if root.page == 0: AppCard { x: 17px; y: 266px; width: (parent.width - 44px) / 2; height: 80px;
            label: "CALCULATOR"; detail: "FOUR FUNCTION"; accent: #ffcc55; chosen => { root.page = 3; } }
        if root.page == 0: AppCard { x: 27px + (parent.width - 44px) / 2; y: 266px; width: (parent.width - 44px) / 2; height: 80px;
            label: "CLOCK"; detail: "UTC TIME"; accent: #68ddc2; chosen => { root.page = 4; } }
        if root.page == 0: AppCard { x: 17px; y: 356px; width: (parent.width - 44px) / 2; height: 80px;
            label: "CALENDAR"; detail: "REMINDERS"; accent: #ff9b68; chosen => { root.page = 5; root.edit-target = 4; } }
        if root.page == 0: AppCard { x: 27px + (parent.width - 44px) / 2; y: 356px; width: (parent.width - 44px) / 2; height: 80px;
            label: "MESSAGES"; detail: "PEER KEYS"; accent: #68ddc2; chosen => { root.page = 6; root.edit-target = 5; } }
        if root.page == 0: AppCard { x: 17px; y: 446px; width: (parent.width - 44px) / 2; height: 80px;
            label: "PHONE"; detail: "DEMO ONLY"; accent: #8fb5cc; chosen => { root.page = 7; } }
        if root.page == 0: AppCard { x: 27px + (parent.width - 44px) / 2; y: 446px; width: (parent.width - 44px) / 2; height: 80px;
            label: "SETTINGS"; detail: "LOCAL ONLY"; accent: #a7b8c3; chosen => { root.page = 8; } }
        if root.page == 0: Text { x: 18px; y: 548px; text: "LOCAL SESSION · NO SYNC";
            color: #ffffff; font-size: 17px; }

        if root.page == 1: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 216px;
            background: #17394e; border-color: #68ddc2; border-width: 2px;
            Text { x: 15px; y: 14px; width: parent.width - 30px; height: parent.height - 28px;
                text: root.note == "" ? "TAP KEYS TO WRITE A NOTE" : root.note;
                color: #ffffff; font-size: 22px; wrap: word-wrap; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 1; } }
        }
        if root.page == 1: Text { x: 18px; y: 400px; text: root.status; color: #ffffff; font-size: 17px; }
        if root.page == 1: AppCard { x: parent.width - 111px; y: 394px; width: 94px; height: 37px;
            label: "SAVE"; detail: ""; accent: #68ddc2; chosen => { root.save-note(root.note); } }

        if root.page == 2: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 101px;
            background: #282d4d; border-color: #b4a0ff; border-width: 2px;
            Text { x: 14px; y: 10px; text: "NAME"; color: #ffffff; font-size: 17px; }
            Text { x: 14px; y: 46px; text: root.contact-name == "" ? "TAP TO ENTER" : root.contact-name;
                color: #ffffff; font-size: 22px; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 2; } }
        }
        if root.page == 2: Rectangle { x: 17px; y: 287px; width: parent.width - 34px; height: 101px;
            background: #282d4d; border-color: #b4a0ff; border-width: 2px;
            Text { x: 14px; y: 10px; text: "PHONE"; color: #ffffff; font-size: 17px; }
            Text { x: 14px; y: 46px; text: root.contact-phone == "" ? "TAP TO ENTER" : root.contact-phone;
                color: #ffffff; font-size: 22px; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 3; } }
        }
        if root.page == 2: Text { x: 18px; y: 401px; text: "CONTACT HELD IN MEMORY"; color: #ffffff; font-size: 17px; }

        if root.page == 3: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 88px;
            background: #282d4d; border-color: #ffcc55; border-width: 2px;
            Text { x: 15px; y: 10px; width: parent.width - 30px; height: parent.height - 20px;
                text: root.calc-display; color: #ffffff; font-size: 34px;
                horizontal-alignment: right; vertical-alignment: center; }
        }
        if root.page == 3: Rectangle {
            x: 17px; y: 276px; width: parent.width - 34px; height: 326px;
            background: #081522;
            for key[index] in ["7", "8", "9", "÷", "4", "5", "6", "×", "1", "2", "3", "−", "C", "0", "=", "+"]: SoftKey {
                x: Math.mod(index, 4) * parent.width / 4;
                y: Math.floor(index / 4) * 83px;
                width: parent.width / 4 - 4px; height: 77px;
                label: key; typed(k) => { root.calculator-key(k); }
            }
        }

        if root.page == 4: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 322px;
            background: #17394e; border-color: #68ddc2; border-width: 2px;
            Text { x: 18px; y: 24px; text: "UTC TIME NOT AVAILABLE"; color: #ffffff; font-size: 22px; }
            Text { x: 18px; y: 78px; width: parent.width - 36px;
                text: "THE IPHONE RTC IS NOT CONNECTED TO THIS IMAGE";
                color: #ffffff; font-size: 17px; wrap: word-wrap; }
        }

        if root.page == 5: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 216px;
            background: #302c40; border-color: #ff9b68; border-width: 2px;
            Text { x: 15px; y: 14px; text: "REMINDER"; color: #ffffff; font-size: 17px; }
            Text { x: 15px; y: 52px; width: parent.width - 30px; height: 145px;
                text: root.calendar-item == "" ? "TAP KEYS TO ADD A REMINDER" : root.calendar-item;
                color: #ffffff; font-size: 22px; wrap: word-wrap; }
        }
        if root.page == 5: Text { x: 18px; y: 400px; text: "REMINDER HELD IN MEMORY"; color: #ffffff; font-size: 17px; }

        if root.page == 6: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 100px;
            background: #17394e; border-color: #68ddc2; border-width: 2px;
            Text { x: 15px; y: 10px; text: "PEER KEY"; color: #ffffff; font-size: 17px; }
            Text { x: 15px; y: 47px; text: root.message-peer == "" ? "TAP TO ENTER" : root.message-peer;
                color: #ffffff; font-size: 22px; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 5; } }
        }
        if root.page == 6: Rectangle { x: 17px; y: 287px; width: parent.width - 34px; height: 100px;
            background: #17394e; border-color: #68ddc2; border-width: 2px;
            Text { x: 15px; y: 10px; text: "MESSAGE"; color: #ffffff; font-size: 17px; }
            Text { x: 15px; y: 47px; text: root.message-body == "" ? "TAP TO COMPOSE" : root.message-body;
                color: #ffffff; font-size: 22px; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 6; } }
        }
        if root.page == 6: Text { x: 18px; y: 401px; text: "NO NETWORK · NO SEND"; color: #ffffff; font-size: 17px; }

        if root.page == 7: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 106px;
            background: #17394e; border-color: #8fb5cc; border-width: 2px;
            Text { x: 15px; y: 16px; text: root.phone-status; color: #ffffff; font-size: 22px; }
            Text { x: 15px; y: 57px; text: root.phone-number; color: #ffffff; font-size: 22px; }
        }
        if root.page == 7: Rectangle {
            x: 17px; y: 293px; width: parent.width - 34px; height: 326px;
            background: #081522;
            for key[index] in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "CLEAR", "0", "CALL"]: SoftKey {
                x: Math.mod(index, 3) * parent.width / 3;
                y: Math.floor(index / 3) * 83px;
                width: parent.width / 3 - 4px; height: 77px;
                label: key; typed(k) => { root.action(k); }
            }
        }

        if root.page == 8: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 322px;
            background: #202b35; border-color: #a7b8c3; border-width: 2px;
            Text { x: 18px; y: 25px; text: "LOCAL ONLY"; color: #ffffff; font-size: 22px; }
            Text { x: 18px; y: 79px; text: "VAULT NOT CONNECTED"; color: #ffffff; font-size: 17px; }
            Text { x: 18px; y: 126px; text: "NO NETWORK YET"; color: #ffffff; font-size: 17px; }
            Text { x: 18px; y: 173px; text: "NO ALERTS YET"; color: #ffffff; font-size: 17px; }
        }

        if root.page == 1 || root.page == 2 || root.page == 5 || root.page == 6: TouchKeyboard {
            x: 17px; y: 440px; width: parent.width - 34px; height: 228px;
            typed(k) => { root.key-tapped(k); }
        }
        Text { x: 18px; y: parent.height - 25px;
            text: root.perf != "" ? root.perf :
                  root.page == 0 ? "TOUCH INPUT · VOLATILE APPS" :
                  root.page == 3 ? "CALCULATOR RUNS IN THIS IMAGE" :
                  "VOLATILE SESSION · NO SYNC";
            color: #ffffff; font-size: 14px;
        }
    }
}
