import "../assets/fonts/Roboto-Variable.ttf";
import { DesktopChat } from "desktop_chat.slint";
// Slint recognizes ListView and instantiates only the visible repeated rows.
component ListView inherits Flickable {
    out property <length> visible-width <=> self.width;
    out property <length> visible-height <=> self.height;
    @children
}
// Eight-workspace, touch-first Slint shell for the iPhone 7 Plus. Data in this
// image is volatile until the phone has a storage and service bridge.
component AppCard inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <string> glyph: "";
    in property <bool> show-open-hint: false;
    in property <image> icon;
    in property <color> accent;
    in property <bool> skia-label: false;
    callback chosen();
    background: hit.pressed ? #1c4052 : #102332;
    border-color: hit.pressed ? accent : #244657;
    border-width: 1px;
    border-radius: 12px;
    if glyph != "": Rectangle {
        x: 10px; y: 17px; width: 38px; height: 38px;
        background: #173348;
        border-color: #315369; border-width: 1px; border-radius: 9px;
        Image {
            x: 7px; y: 7px; width: 24px; height: 24px;
            source: icon; colorize: accent; image-fit: contain;
        }
    }
    if !root.skia-label: Text {
        x: glyph == "" ? 10px : 58px; y: glyph == "" ? 10px : 12px;
        width: parent.width - (glyph == "" ? 20px : 66px);
        text: label; color: #edf7fa; font-size: 16px; font-weight: 700; overflow: elide;
    }
    if !root.skia-label: Text {
        x: glyph == "" ? 10px : 58px; y: 43px;
        width: parent.width - (glyph == "" ? 20px : 66px); height: 35px;
        text: detail; color: #a9c1cf; font-size: 12px; wrap: word-wrap;
    }
    if show-open-hint: Rectangle {
        x: 58px; y: parent.height - 43px; width: 28px; height: 2px;
        background: accent; border-radius: 1px;
    }
    if show-open-hint && !root.skia-label: Text {
        x: 58px; y: parent.height - 34px; width: parent.width - 68px;
        text: "OPEN  ›"; color: accent; font-size: 12px;
    }
    hit := TouchArea { width: parent.width; height: parent.height; clicked => { chosen(); } }
}

component SimplexChatRow inherits Rectangle {
    in property <string> label;
    in property <string> preview: "Encrypted";
    in property <color> accent: #28d8e8;
    in property <bool> skia-text: false;
    callback chosen();
    height: 72px;
    background: hit.pressed ? #173544 : #050a12;
    border-radius: 10px;
    border-width: 0px;
    Rectangle {
        x: 4px; y: 14px; width: 42px; height: 42px;
        border-radius: 21px;
        background: accent;
    }
    if !root.skia-text: Text {
        x: 56px; y: 10px;
        width: parent.width - 68px;
        text: label;
        color: #e8f5fb;
        font-size: 16px;
        vertical-alignment: top;
    }
    if !root.skia-text: Text {
        x: 56px; y: 38px;
        width: parent.width - 68px;
        text: preview;
        color: #8eacbb;
        font-size: 13px;
    }
    Rectangle { x: 56px; y: 71px; width: parent.width - 56px; height: 1px; background: #17303c; }
    hit := TouchArea { width: parent.width; height: parent.height; clicked => { chosen(); } }
}

component SoftKey inherits Rectangle {
    in property <string> label;
    callback typed(string);
    background: hit.pressed ? #244859 : #102734;
    border-color: #294454;
    border-width: 1px;
    border-radius: 5px;
    Text {
        width: parent.width; height: parent.height;
        text: label; color: #e8f5fb; font-size: 17px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    hit := TouchArea { width: parent.width; height: parent.height; clicked => { typed(label); } }
}

component TouchKeyboard inherits Rectangle {
    callback typed(string);
    in property <bool> decimal: false;
    // Address entry starts in lowercase. Shift is one letter, then back to lowercase.
    in property <bool> shift-key: false;
    in-out property <bool> uppercase: false;
    background: #09141f;
    border-color: #203747;
    border-width: 2px;
    border-radius: 9px;

    for key[index] in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]: SoftKey {
        x: 5px + index * (parent.width - 10px) / 10;
        y: 5px; width: (parent.width - 10px) / 10 - 2px; height: 39px;
        label: key; typed(k) => { root.typed(k); }
    }
    for key[index] in ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"]: SoftKey {
        x: 5px + index * (parent.width - 10px) / 10;
        y: 49px; width: (parent.width - 10px) / 10 - 2px; height: 39px;
        label: root.shift-key && !root.uppercase ? key.to-lowercase() : key;
        typed(k) => { root.typed(k); root.uppercase = false; }
    }
    for key[index] in ["A", "S", "D", "F", "G", "H", "J", "K", "L"]: SoftKey {
        x: 18px + index * (parent.width - 36px) / 9;
        y: 93px; width: (parent.width - 36px) / 9 - 2px; height: 39px;
        label: root.shift-key && !root.uppercase ? key.to-lowercase() : key;
        typed(k) => { root.typed(k); root.uppercase = false; }
    }
    for key[index] in ["Z", "X", "C", "V", "B", "N", "M"]: SoftKey {
        x: 42px + index * (parent.width - 84px) / 7;
        y: 137px; width: (parent.width - 84px) / 7 - 2px; height: 39px;
        label: root.shift-key && !root.uppercase ? key.to-lowercase() : key;
        typed(k) => { root.typed(k); root.uppercase = false; }
    }
    SoftKey {
        x: 5px; y: 181px; width: (parent.width - 20px) / 3; height: 39px;
        label: root.decimal ? "." : (root.shift-key ? "SHIFT" : "SPACE");
        typed(k) => {
            if (root.shift-key && !root.decimal) {
                root.uppercase = !root.uppercase;
            } else {
                root.typed(k);
            }
        }
    }
    SoftKey {
        x: 10px + (parent.width - 20px) / 3; y: 181px;
        width: (parent.width - 20px) / 3; height: 39px;
        label: "ENTER"; typed(k) => { root.typed(k); }
    }
    SoftKey {
        x: 15px + 2 * (parent.width - 20px) / 3; y: 181px;
        width: (parent.width - 20px) / 3; height: 39px;
        label: "DELETE"; typed(k) => { root.typed(k); }
    }
}

// A case-sensitive, URL-capable touch layout for invitation links.
component InvitationKeyboard inherits Rectangle {
    callback typed(string);
    in-out property <bool> symbols: false;
    in-out property <bool> uppercase: false;
    background: #09141f;
    border-color: #203747;
    border-width: 2px;
    border-radius: 9px;
    for key[index] in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]: SoftKey {
        x: 4px + index * (parent.width - 8px) / 10; y: 4px;
        width: (parent.width - 8px) / 10 - 2px; height: 34px;
        label: key; typed(k) => { root.typed(k); }
    }
    for key[index] in ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"]: SoftKey {
        visible: !root.symbols;
        x: 4px + index * (parent.width - 8px) / 10; y: 42px;
        width: (parent.width - 8px) / 10 - 2px; height: 34px;
        label: root.uppercase ? (index == 0 ? "Q" : index == 1 ? "W" : index == 2 ? "E" : index == 3 ? "R" : index == 4 ? "T" : index == 5 ? "Y" : index == 6 ? "U" : index == 7 ? "I" : index == 8 ? "O" : "P") : key;
        typed(k) => { root.typed(k); }
    }
    for key[index] in ["a", "s", "d", "f", "g", "h", "j", "k", "l"]: SoftKey {
        visible: !root.symbols;
        x: 17px + index * (parent.width - 34px) / 9; y: 80px;
        width: (parent.width - 34px) / 9 - 2px; height: 34px;
        label: root.uppercase ? (index == 0 ? "A" : index == 1 ? "S" : index == 2 ? "D" : index == 3 ? "F" : index == 4 ? "G" : index == 5 ? "H" : index == 6 ? "J" : index == 7 ? "K" : "L") : key;
        typed(k) => { root.typed(k); }
    }
    for key[index] in ["z", "x", "c", "v", "b", "n", "m"]: SoftKey {
        visible: !root.symbols;
        x: 37px + index * (parent.width - 74px) / 7; y: 118px;
        width: (parent.width - 74px) / 7 - 2px; height: 34px;
        label: root.uppercase ? (index == 0 ? "Z" : index == 1 ? "X" : index == 2 ? "C" : index == 3 ? "V" : index == 4 ? "B" : index == 5 ? "N" : "M") : key;
        typed(k) => { root.typed(k); }
    }
    for key[index] in [":", "/", "?", "#", "=", "%", "&", "@", "!"]: SoftKey {
        visible: root.symbols;
        x: 17px + index * (parent.width - 34px) / 9; y: 42px;
        width: (parent.width - 34px) / 9 - 2px; height: 34px;
        label: key; typed(k) => { root.typed(k); }
    }
    for key[index] in ["+", "`", "_", ".", "~", "(", ")", "[", "]"]: SoftKey {
        visible: root.symbols;
        x: 17px + index * (parent.width - 34px) / 9; y: 80px;
        width: (parent.width - 34px) / 9 - 2px; height: 34px;
        label: key; typed(k) => { root.typed(k); }
    }
    for key[index] in [";", ",", "*", "'", "\"", "$", "^", "{", "}"]: SoftKey {
        visible: root.symbols;
        x: 17px + index * (parent.width - 34px) / 9; y: 118px;
        width: (parent.width - 34px) / 9 - 2px; height: 34px;
        label: key; typed(k) => { root.typed(k); }
    }
    SoftKey {
        x: 4px; y: 156px; width: (parent.width - 8px) / 4 - 2px; height: 34px;
        label: root.symbols ? "ABC" : "?123";
        typed(k) => { root.symbols = !root.symbols; }
    }
    SoftKey {
        x: 6px + (parent.width - 8px) / 4; y: 156px; width: (parent.width - 8px) / 4 - 2px; height: 34px;
        label: root.symbols ? "<" : "SHIFT";
        typed(k) => { if root.symbols { root.typed(k); } else { root.uppercase = !root.uppercase; } }
    }
    SoftKey {
        x: 8px + 2 * (parent.width - 8px) / 4; y: 156px; width: (parent.width - 8px) / 4 - 2px; height: 34px;
        label: root.symbols ? ">" : "-"; typed(k) => { root.typed(k); }
    }
    SoftKey {
        x: 10px + 3 * (parent.width - 8px) / 4; y: 156px; width: (parent.width - 8px) / 4 - 2px; height: 34px;
        label: "DELETE"; typed(k) => { root.typed(k); }
    }
    SoftKey {
        x: 4px; y: 194px; width: (parent.width - 12px) / 2; height: 28px;
        label: root.symbols ? "\\" : "CLEAR"; typed(k) => { root.typed(k); }
    }
    SoftKey {
        x: 8px + (parent.width - 12px) / 2; y: 194px; width: (parent.width - 12px) / 2; height: 28px;
        label: root.symbols ? "|" : "SPACE"; typed(k) => { root.typed(k); }
    }
}

component ChatThread inherits Flickable {
    in property <string> transcript-text;
    interactive: true;
    mouse-drag-pan-enabled: true;
    content-width: self.width;
    content-height: max(self.height, transcript.preferred-height);
    changed transcript-text => {
        // A large negative offset is clamped to the newest line.
        self.content-y = -100000px;
    }
    transcript := Text {
        width: parent.width;
        text: transcript-text == "" ? "NO MESSAGES YET" : transcript-text;
        color: transcript-text == "" ? #9bb6c4 : #e8f5fb;
        font-size: 15px;
        wrap: word-wrap;
    }
    TouchArea {
        width: parent.width;
        height: max(parent.height, transcript.preferred-height);
        clicked => { root.focused(); }
    }
    callback focused();
}

component WalletTxRow inherits Rectangle {
    in property <bool> incoming;
    in property <string> amount;
    in property <bool> divider: true;
    height: amount == "" ? 0px : 44px;
    visible: amount != "";
    Image {
        x: 0px; y: 12px; width: 18px; height: 18px;
        source: incoming ? @image-url("../assets/icons/wallet-arrow-down.svg")
                         : @image-url("../assets/icons/wallet-arrow-up.svg");
        colorize: incoming ? #3DCF8E : #E25B64;
    }
    Text {
        x: 28px; y: 0px; height: 44px; text: incoming ? "Received" : "Sent";
        color: #E6F2F7; font-size: 15px; font-weight: 600; vertical-alignment: center;
    }
    Text {
        x: 120px; y: 0px; width: parent.width - 120px; height: 44px; text: amount;
        color: incoming ? #3DCF8E : #E25B64; font-size: 15px; font-weight: 600;
        horizontal-alignment: right; vertical-alignment: center;
    }
    if divider: Rectangle { x: 0px; y: 43px; width: parent.width; height: 1px; background: #263D4B; }
}

export component NotesWindow inherits Window {
    default-font-family: root.desktop-mode ? "Roboto" : "";
    title: "Personal OS — Slint Suite";
    background: #050a12;
    preferred-width: 414px;
    preferred-height: 736px;
    min-width: root.desktop-mode ? 480px : 400px;
    min-height: root.desktop-mode ? 480px : 700px;
    in property <bool> desktop-mode: false;

    // Home plus the eight workspaces of the existing QEMU graphics suite.
    in-out property <int> page: 0;
    in-out property <int> edit-target: 0;
    in-out property <string> note: "";
    in-out property <bool> note-editing: false;
    in-out property <string> status: "VOLATILE · NOT SAVED";
    in-out property <string> contact-name: "";
    in-out property <string> contact-phone: "";
    in-out property <string> contact-status: "VOLATILE · NOT SAVED";
    in-out property <bool> contact-detail: false;
    property <bool> contact-stored: contact-name != "" &&
        (contact-status == "LOADED FROM VAULT" || contact-status == "SAVED THROUGH VAULT");
    in-out property <string> calendar-item: "";
    in-out property <string> calendar-status: "VOLATILE · NOT SAVED";
    in-out property <string> message-peer: "";
    in-out property <string> message-body: "";
    in-out property <string> message-search: "";
    in-out property <string> message-reply-to: "";
    in-out property <bool> message-reply-mine: false;
    in-out property <string> message-action-id: "";
    in-out property <bool> message-edit-mode: false;
    in-out property <[string]> message-bubble-ids;
    in-out property <[string]> message-bubble-quotes;
    in-out property <[string]> message-bubble-reacts;
    in-out property <image> message-invitation-qr;
    in-out property <bool> message-invitation-qr-visible: false;
    in-out property <string> message-send-status: "NO MESSAGE SENT";
    in-out property <string> message-incoming-body: "";
    in-out property <string> message-transcript: "";
    in-out property <[string]> message-bubbles;
    in-out property <[string]> message-bubble-time;
    in-out property <[int]> message-bubble-side;
    in-out property <image> message-image;
    in-out property <bool> message-image-visible: false;
    in-out property <image> message-incoming-image;
    in-out property <bool> message-incoming-image-visible: false;
    in-out property <int> message-incoming-photo-index: -1;
    in-out property <[image]> message-bubble-photos;
    in-out property <[bool]> message-bubble-photo-ready;
    in-out property <[bool]> message-bubble-photo-pending;
    in-out property <[string]> message-bubble-photo-ids;
    in-out property <[bool]> message-bubble-upload-failed;
    in-out property <[string]> message-bubble-files;
    in-out property <bool> message-file-open: false;
    in-out property <string> message-file-name: "";
    in-out property <string> message-file-body: "";
    in-out property <bool> message-attach-menu: false;
    in-out property <bool> message-photo-picker-open: false;
    in-out property <[string]> message-photo-picker-labels;
    in-out property <[image]> message-photo-picker-images;
    in-out property <bool> message-group-invite: false;
    in-out property <string> message-group-uri: "";
    in-out property <string> message-group-name: "";
    in-out property <string> message-group-status: "";
    in-out property <int> message-group-recipient: -1;
    in-out property <string> message-group-recipient-name: "";
    in-out property <string> message-contact-name: "";
    in-out property <string> message-profile-name: "";
    in-out property <[string]> message-chats;
    in-out property <[int]> message-chat-index-map;
    in-out property <[string]> message-group-chats;
    in-out property <[int]> message-group-index-map;
    in-out property <[string]> message-archived-chats;
    in-out property <[int]> message-archived-index-map;
    in-out property <length> message-list-offset: 0px;
    in-out property <float> message-list-scroll: -root.message-list-offset / 1px;
    in-out property <int> message-list-tab: 0;
    in-out property <int> message-chat-index: 0;
    in-out property <string> message-receive-status: "NO INCOMING MESSAGE CHECKED";
    in-out property <string> message-ack-status: "";
    in-out property <string> message-selected: "Ch4113";
    in-out property <bool> message-view: false;
    in-out property <string> message-service-state: "";
    in-out property <bool> message-service-ready: false;
    in-out property <bool> message-target-ready: true;
    in-out property <bool> message-has-connections: false;
    in-out property <bool> message-invitation-view: false;
    in-out property <bool> message-address-view: false;
    in-out property <string> message-invitation-uri: "";
    in-out property <string> message-invitation-status: "NO INVITATION REQUESTED";
    in-out property <bool> message-join-view: false;
    in-out property <string> message-join-uri: "";
    in-out property <string> message-join-status: "PASTE OR TYPE AN INVITATION";
    in-out property <bool> message-join-requested: false;
    in-out property <string> calc-display: "0";
    in-out property <string> phone-number: "";
    in-out property <string> phone-status: "IDLE";
    in-out property <string> files-status: "";
    in-out property <[string]> files-names;
    in-out property <image> files-preview;
    in-out property <bool> files-preview-open: false;
    in-out property <string> files-preview-name: "";
    in-out property <string> files-preview-text: "";
    in-out property <bool> files-delete-confirm: false;
    in-out property <bool> files-test-import-enabled: false;
    in-out property <string> wallet-status: "Opening wallet…";
    in-out property <bool> wallet-available: true;
    /// 0=Wallet 1=Receive 2=Send 3=Settings — bottom nav like nexawal-android.
    in-out property <int> wallet-tab: 0;
    // 0 wallet, 1 choices, 2 backup, 4 restore, 5 unlock,
    // 6 generating, 7 saving creation, 8 unlocking, 9 saving restore.
    in-out property <int> wallet-setup: 0;
    in-out property <int> wallet-network: 0;
    in-out property <string> wallet-height: "0";
    in-out property <string> wallet-words: "";
    in-out property <string> wallet-backup: "";
    in-out property <string> wallet-setup-status: "";
    in-out property <string> wallet-balance: "—";
    in-out property <string> wallet-unlocked: "—";
    in-out property <string> wallet-address: "";
    in-out property <string> wallet-address-short: "";
    in-out property <string> wallet-sync: "Opening wallet…";
    in-out property <string> wallet-sync-detail: "";
    in-out property <string> wallet-history: "No transactions yet";
    // Up to five original-style rows. Amount empty hides the row.
    in-out property <bool> wallet-tx-in-0: false;
    in-out property <string> wallet-tx-amt-0: "";
    in-out property <bool> wallet-tx-in-1: false;
    in-out property <string> wallet-tx-amt-1: "";
    in-out property <bool> wallet-tx-in-2: false;
    in-out property <string> wallet-tx-amt-2: "";
    in-out property <bool> wallet-tx-in-3: false;
    in-out property <string> wallet-tx-amt-3: "";
    in-out property <bool> wallet-tx-in-4: false;
    in-out property <string> wallet-tx-amt-4: "";
    in-out property <string> wallet-node: "xmr-node.cakewallet.com:18081";
    in-out property <string> wallet-node-status: "HTTP node · host:port";
    in-out property <string> wallet-send-amount: "";
    in-out property <string> wallet-send-dest: "";
    in-out property <string> wallet-send-status: "";
    in-out property <bool> wallet-send-max: false;
    in-out property <bool> wallet-test-preview: false;
    in-out property <bool> wallet-fee-ready: false;
    in-out property <image> wallet-address-qr;
    in-out property <bool> wallet-address-qr-visible: false;
    in-out property <int> settings-selected: -1;
    in-out property <string> settings-status: "DEVICE SERVICES · NOT CONNECTED";
    in-out property <bool> device-lock-available: false;
    in-out property <bool> device-lock-enabled: false;
    in-out property <bool> device-lock-screen: false;
    in-out property <int> device-lock-stage: 0;
    in-out property <bool> device-lock-welcome: true;
    in-out property <string> system-clock: "";
    in-out property <string> device-lock-status: "Checking lock…";
    in-out property <string> device-lock-setup-feedback: "";
    callback device-lock-key(string);
    callback device-lock-submit();
    callback device-lock-action(int);
    in-out property <string> db-passphrase-current: "";
    in-out property <string> db-passphrase-new: "";
    in-out property <string> db-unlock-status: "LOCKED · ENTER PASSPHRASE";
    in-out property <string> db-export-status: "OFFICIAL ZIP · CHAT + AGENT · KEY OUTSIDE";
    in-out property <string> db-import-status: "IMPORT WRITES A NEW DISK ONLY";
    in-out property <bool> db-unlocked: false;
    in-out property <string> theme-choice: "DARK";
    in-out property <string> quick-selected: "";
    in-out property <bool> lockdown-preview: false;
    in-out property <bool> message-receipts: true;
    in property <bool> show-preview-privacy-controls: true;
    in-out property <string> message-servers: "smp4.simplex.im:5223 · smp14.simplex.im:5223 · xftp1.simplex.im";
    callback unlock-database-passphrase();
    callback change-database-passphrase();
    callback close-chat();
    callback filter-message-chats();
    in-out property <string> perf: "";
    in-out property <bool> aurora-accent: true;
    in property <length> keyboard-inset: 0px;
    property <bool> message-keyboard: !root.desktop-mode && root.page == 6 && root.message-view && root.edit-target == 6;
    property <bool> chat-list-keyboard: !root.desktop-mode && root.page == 6 && !root.message-view
        && !root.message-join-view && !root.message-invitation-view
        && (root.edit-target == 10 || root.edit-target == 13 || root.edit-target == 17);
    property <bool> chat-keys-visible: root.message-keyboard || root.chat-list-keyboard;
    // Both keyboards share a bottom dock. The Rust text overlay uses the same list bounds.
    property <length> chat-dock-height: 278px;
    out property <length> chat-keyboard-top: root.height - root.top-inset - root.chat-dock-height + 28px;
    out property <length> chat-list-rows-height: min(260px, max(0px, chat-list-panel-height - 48px));
    property <length> chat-list-panel-height: root.chat-list-keyboard
        ? min(392px, max(0px, root.height - root.top-inset - root.chat-dock-height - 210px)) : 392px;
    property <bool> receive-idle: root.message-incoming-body == "" && (root.message-receive-status == "" || root.message-receive-status == "NO INCOMING MESSAGE CHECKED" || root.message-receive-status == "NO NEW MESSAGE" || root.message-receive-status == "LIVE" || root.message-receive-status == "Up to date" || root.message-receive-status == "Listening");
    property <bool> send-idle: root.message-send-status == "" || root.message-send-status == "NO MESSAGE SENT" || root.message-send-status == "Ready" || root.message-send-status == "Sent" || root.message-send-status == "Delivered" || root.message-send-status == "SENT THROUGH SIMPLEX";
    // Keep the composer above the keyboard in the same frame as the keys.
    out property <length> keyboard-travel: root.message-keyboard ? root.chat-dock-height : 0px;
    in property <length> top-inset: 0px;
    callback save-note(string);
    callback save-contact(string, string);
    callback save-calendar(string);
    callback key-tapped(string);
    callback action(string);
    callback calculator-key(string);
    callback save-profile();
    callback create-group();
    callback create-address();
    callback create-invitation();
    callback refresh-invitation();
    callback copy-invitation();
    callback submit-join-invitation(string);
    callback check-join-status();
    callback join-key-tapped(string);
    callback send-message(string);
    callback attach-picture(bool);
    callback pick-saved-photo(int);
    callback retry-attachment(string, string);
    callback save-chat-photo(string);
    callback save-chat-file(string, string);
    callback refresh-files();
    callback open-saved-file(int);
    callback delete-saved-file();
    callback import-test-file();
    callback inspect-bubble(string, string);
    callback check-message-send-status();
    callback receive-next-message();
    callback open-chat(int) -> bool;
    callback set-chat-photo-visibility(int, bool);
    callback check-message-receive-status();
    callback acknowledge-incoming-message();
    callback check-message-ack-status();
    callback delete-chat(int);
    callback archive-chat(int, bool);
    callback wallet-setup-action(int);
    callback set-wallet-node();
    callback prepare-wallet-send();
    callback copy-wallet-address();
    callback confirm-wallet-send();
    callback reconcile-wallet-send();
    callback retry-wallet-send();
    // Shared shell navigation (chrome button + edge/home gestures + keys).
    callback system-back();
    callback system-home();
    callback system-recents();

    function open-named-chat(index: int, name: string) {
        root.edit-target = 0;
        root.message-view = root.open-chat(index);
        if root.message-view {
            root.message-selected = name;
            root.message-chat-index = index;
            root.receive-next-message();
        }
    }

    if root.desktop-mode && root.page == 6: DesktopChat {
        width: 100%; height: 100%;
        chats: root.message-chats; chat-indices: root.message-chat-index-map;
        selected: root.message-selected; opened: root.message-view;
        ready: root.message-service-ready; service-status: root.message-service-state;
        receive-status: root.message-receive-status; send-status: root.message-send-status;
        bubbles: root.message-bubbles; times: root.message-bubble-time; sides: root.message-bubble-side;
        photos: root.message-bubble-photos; photo-ready: root.message-bubble-photo-ready; photo-ids: root.message-bubble-photo-ids;
        body <=> root.message-body; search <=> root.message-search;
        invitation-open: root.message-invitation-view; invitation-qr-visible: root.message-invitation-qr-visible;
        invitation-qr: root.message-invitation-qr; invitation-uri: root.message-invitation-uri;
        invitation-status: root.message-invitation-status;
        join-open <=> root.message-join-view; join-uri <=> root.message-join-uri; join-status: root.message-join-status;
        select(i,name) => { root.open-named-chat(i,name); }
        send(text) => { root.send-message(text); }
        search-changed => { root.filter-message-chats(); }
        focused(target) => { root.edit-target = target; }
        make-link => { root.message-invitation-view = true; root.message-join-view = false; root.create-invitation(); }
        close-link => { root.message-invitation-view = false; root.message-invitation-qr-visible = false; root.edit-target = 0; }
        join(uri) => { root.submit-join-invitation(uri); }
        photo-visible(i,visible) => { root.set-chat-photo-visibility(i,visible); }
    }
    Rectangle {
        y: root.top-inset; width: 100%; height: parent.height - root.top-inset;
        visible: !root.desktop-mode || root.page == 16;
        background: #050a12;

        // Shared high-resolution wallpaper: art stays behind readable UI chrome.
        if root.page == 14 && root.show-preview-privacy-controls: Image {
            width: parent.width; height: parent.height;
            source: @image-url("../assets/nexatrode-aurora-wallpaper.png");
            image-fit: cover;
        }

        // Static chrome follows the phone status-bar layout in the reference.
        Text { x: 17px; y: 10px; text: root.system-clock == "" ? "--:--" : root.system-clock; color: #d5e7ef; font-size: 13px; font-weight: 700; }
        if root.show-preview-privacy-controls: Rectangle { x: parent.width - 103px; y: 13px; width: 13px; height: 10px;
            background: #050a12; border-color: #28d8e8; border-width: 1px; }
        if root.show-preview-privacy-controls: Rectangle { x: parent.width - 100px; y: 8px; width: 7px; height: 8px;
            background: #050a12; border-color: #28d8e8; border-width: 1px; }
        if root.show-preview-privacy-controls: TouchArea { x: parent.width - 108px; y: 5px; width: 23px; height: 26px;
                clicked => { root.page = 14; root.edit-target = 0; } }
        Rectangle { x: parent.width - 77px; y: 17px; width: 3px; height: 4px; background: #9bb6c4; }
        Rectangle { x: parent.width - 71px; y: 15px; width: 3px; height: 6px; background: #9bb6c4; }
        Rectangle { x: parent.width - 65px; y: 13px; width: 3px; height: 8px; background: #9bb6c4; }
        Rectangle { x: parent.width - 53px; y: 12px; width: 17px; height: 10px;
            background: #050a12; border-color: #9bb6c4; border-width: 1px; }
        Rectangle { x: parent.width - 51px; y: 14px; width: 11px; height: 6px; background: #9bb6c4; }
        Rectangle { x: parent.width - 35px; y: 15px; width: 2px; height: 4px; background: #9bb6c4; }
        Rectangle { x: 17px; y: 42px; width: parent.width - 34px; height: 1px; background: #174452; }
        if root.page == 0: Text { x: 18px; y: 56px; width: parent.width - 36px;
            text: "NEXATRODE"; color: #edf7fa; font-size: 21px; font-weight: 700; }
        // Standard NexaWal face: no shell HOME chrome (Android has bottom tabs only).
        if root.page != 0 && root.page != 14 && root.page != 16: Rectangle {
            x: parent.width - 110px; y: 113px; width: 94px; height: 45px;
            background: #123143; border-color: #396d79; border-width: 1px; border-radius: 9px;
            Text { width: parent.width; height: parent.height;
                text: root.page == 1 && root.note-editing ? "LIST" :
                      root.page == 2 && root.contact-detail ? "LIST" :
                      root.page == 6 && (root.message-view || root.message-join-view || root.message-invitation-view) ? "CHATS" :
                      root.page == 15 ? "BACK" : "HOME";
                color: #ffffff; font-size: 17px;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => {
                root.system-back();
            } }
        }
        if root.page == 6 && !root.message-view && !root.message-join-view: Rectangle {
            x: parent.width - 214px; y: 113px; width: 94px; height: 45px;
            background: #103143; border-color: #2b6875; border-width: 1px; border-radius: 9px;
            Text { width: parent.width; height: parent.height;
                text: root.message-invitation-view && !root.message-join-view ? "CHECK" : "NEW LINK";
                color: #28d8e8; font-size: 13px;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => {
                root.message-join-view = false; root.edit-target = 0;
                if root.message-invitation-view { root.refresh-invitation(); }
                else {
                    root.message-address-view = false;
                    root.message-invitation-view = true;
                    root.create-invitation();
                }
            } }
        }
        if root.page == 6 && !root.message-view && !root.message-invitation-view && !root.message-join-view && root.message-service-ready: Rectangle {
            x: 17px; y: 113px; width: 78px; height: 45px;
            background: #102b37; border-color: #2b6875; border-width: 1px; border-radius: 9px;
            Text { width: parent.width; height: parent.height; text: "ADDRESS"; color: #7ee7f2; font-size: 11px;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => {
                root.message-join-view = false;
                root.message-address-view = true;
                root.message-invitation-view = true;
                root.edit-target = 0;
                root.create-address();
            } }
        }
        if root.page == 6 && !root.message-view && !root.message-invitation-view && !root.message-join-view: Rectangle {
            x: parent.width - 320px; y: 113px; width: 94px; height: 45px;
            background: #1e2541; border-color: #675b99; border-width: 1px; border-radius: 9px;
            Text { width: parent.width; height: parent.height; text: "JOIN"; color: #c9baff; font-size: 14px;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => {
                root.message-join-view = true; root.message-invitation-view = false;
                root.message-join-requested = false; root.message-join-uri = "";
                root.message-join-status = "PASTE OR TYPE AN INVITATION"; root.edit-target = 7;
            } }
        }
        if root.page == 8: Rectangle {
            x: parent.width - 210px; y: 113px; width: 86px; height: 45px;
            background: #102333; border-color: #2b6875; border-width: 1px; border-radius: 9px;
            Text { width: parent.width; height: parent.height; text: "QUICK"; color: #28d8e8; font-size: 14px;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.page = 11; } }
        }
        if root.page != 0 && root.page != 14 && root.page != 16: Text {
            x: 18px; y: 120px;
            width: root.page == 6 ? parent.width - 230px : parent.width - 135px;
            text: root.page == 0 ? "SECURE · PRIVATE · YOURS" :
                  root.page == 1 ? "PRIVATE · ON DEVICE" :
                  root.page == 2 ? (root.contact-detail ? "EDIT CONTACT" : "SAMPLE CONTACTS · DEMO") :
                  root.page == 3 ? "FOUR FUNCTION" :
                  root.page == 4 ? "UTC TIME" :
                  root.page == 5 ? "REMINDERS" :
                  root.page == 6 ? (root.message-join-view ? "JOIN · PASTE A LINK" : (root.message-view ? (root.message-service-ready ? "ENCRYPTED" : "LOCAL CHAT · NOT SENT") : (root.message-invitation-view ? "SHARE THIS LINK" : ""))) :
                  root.page == 7 ? "NO MODEM" :
                  root.page == 8 ? "LOCAL ONLY" :
                  root.page == 9 ? "ON DEVICE" :
                  root.page == 10 ? "PRIVATE WORKSPACES" :
                  root.page == 11 ? "QUICK SETTINGS · DEMO ONLY" :
                  root.page == 12 ? "THEME PREVIEW" :
                  root.page == 13 ? (root.show-preview-privacy-controls ? "RECEIPTS · SERVERS" : "SERVERS") :
                  root.page == 15 ? "PASSPHRASE · EXPORT · IMPORT" :
                  "SECURE · PRIVATE · YOURS";
            color: #ffffff; font-size: 17px;
        }
        // Centered title like nexawal-android. HOME returns to the app shell.
        if root.page == 16: Rectangle {
            x: 8px; y: 48px; width: 72px; height: 36px; background: #00000000;
            Text { width: parent.width; height: parent.height; text: "HOME";
                color: #36C7D6; font-size: 14px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.system-home(); } }
        }
        if root.page == 16: Text {
            x: 0px; y: 56px; width: parent.width;
            text: root.wallet-tab == 1 ? "Receive XMR" :
                  root.wallet-tab == 2 ? "Send XMR" :
                  root.wallet-tab == 3 ? "Settings" : "Wallet";
            color: #ffffff; font-size: 20px; font-weight: 700;
            horizontal-alignment: center;
        }
        if root.page != 14 && root.page != 16: Rectangle {
            x: 17px; y: root.page == 0 ? 100px : 163px;
            width: parent.width - 34px; height: 1px; background: #174452;
            Rectangle { width: 48px; height: 2px; background: #28d8e8; }
        }

        // Home labels use Slint Text (skia-label false). Skia title bitmaps were
        // deferred for wallet-boot TCG and left HOME with icon-only cards.
        if root.page == 0: AppCard { x: 17px; y: parent.height * 0.14; width: (parent.width - 44px) / 2; height: parent.height * 0.19;
            label: "SIMPLEX"; detail: "PRIVATE CHATS"; glyph: "M"; show-open-hint: true; icon: @image-url("../assets/icons/simplex.svg"); accent: #28d8e8; chosen => { root.page = 6; root.message-view = false; root.message-invitation-view = false; root.message-join-view = false; root.edit-target = 0; } }
        if root.page == 0: AppCard { x: 27px + (parent.width - 44px) / 2; y: parent.height * 0.14; width: (parent.width - 44px) / 2; height: parent.height * 0.19;
            label: "CONTACTS"; detail: "PEOPLE"; glyph: "C"; show-open-hint: true; icon: @image-url("../assets/icons/contacts.svg"); accent: #b4a0ff; chosen => { root.page = 2; root.contact-detail = false; root.edit-target = 0; } }
        if root.page == 0: AppCard { x: 17px; y: parent.height * 0.34; width: (parent.width - 44px) / 2; height: parent.height * 0.19;
            label: "NEXAWAL"; detail: root.wallet-available ? "MONERO WALLET" : "UNAVAILABLE"; glyph: "W"; show-open-hint: root.wallet-available; icon: @image-url("../assets/icons/nexawal.svg"); accent: #ff9b68; chosen => { if root.wallet-available { root.page = 16; root.edit-target = 0; } } }
        if root.page == 0: AppCard { x: 27px + (parent.width - 44px) / 2; y: parent.height * 0.34; width: (parent.width - 44px) / 2; height: parent.height * 0.19;
            label: "TOOLS"; detail: "NOTES · FILES · MORE"; glyph: "+"; show-open-hint: true; icon: @image-url("../assets/icons/tools.svg"); accent: #8fb5cc; chosen => { root.page = 10; } }
        if root.page == 0: AppCard { x: 17px; y: parent.height * 0.55; width: parent.width - 34px; height: parent.height * 0.11;
            label: "SETTINGS"; detail: "PRIVACY · APPEARANCE"; glyph: "S"; icon: @image-url("../assets/icons/settings.svg"); accent: #68ddc2; chosen => {
                root.settings-selected = -1; root.page = 8;
            } }
        if root.page == 0: Text {
            x: 18px; y: parent.height * 0.70;
            width: parent.width - 36px;
            text: "SECURE · PRIVATE · YOURS";
            color: #b7d3df; font-size: 15px; font-weight: 700;
        }

        // Aurora is an optional decorative layer in the open Home-screen footer.
        // The low-contrast horizon and small color offsets stay clear of controls.
        if root.page == 0 && root.aurora-accent: Rectangle {
            x: 17px; y: parent.height * 0.82;
            width: parent.width - 34px; height: 1px; background: #123447;
        }
        if root.page == 0 && root.aurora-accent: Rectangle {
            x: 45px; y: parent.height * 0.832;
            width: parent.width - 90px; height: 1px; background: #172b43;
        }
        if root.page == 0 && root.aurora-accent: Rectangle {
            x: 84px; y: parent.height * 0.845;
            width: parent.width - 168px; height: 2px; background: #26304b;
        }
        if root.page == 0 && root.aurora-accent: Rectangle {
            x: 33px; y: parent.height * 0.859;
            width: parent.width - 66px; height: 1px; background: #10293a;
        }
        if root.page == 0 && root.aurora-accent: Rectangle {
            x: 60px; y: parent.height * 0.874;
            width: parent.width - 120px; height: 1px; background: #172a3e;
        }
        if root.page == 0 && root.aurora-accent: Rectangle {
            x: 22px; y: parent.height * 0.837;
            width: 18px; height: 2px; background: #743f82;
        }
        if root.page == 0 && root.aurora-accent: Rectangle {
            x: parent.width - 42px; y: parent.height * 0.856;
            width: 20px; height: 2px; background: #286d7c;
        }

        if root.page == 10: AppCard { x: 17px; y: 176px; width: (parent.width - 44px) / 2; height: 80px;
            label: "NOTES"; detail: "PRIVATE NOTES"; glyph: "N"; icon: @image-url("../assets/icons/notes.svg"); accent: #68ddc2; chosen => { root.page = 1; root.note-editing = false; root.edit-target = 0; } }
        if root.page == 10: AppCard { x: 27px + (parent.width - 44px) / 2; y: 176px; width: (parent.width - 44px) / 2; height: 80px;
            label: "CALCULATOR"; detail: "FOUR FUNCTION"; glyph: "="; icon: @image-url("../assets/icons/calculator.svg"); accent: #ffcc55; chosen => { root.page = 3; } }
        if root.page == 10: AppCard { x: 17px; y: 266px; width: (parent.width - 44px) / 2; height: 80px;
            label: "CLOCK"; detail: "UTC TIME"; glyph: "T"; icon: @image-url("../assets/icons/clock.svg"); accent: #68ddc2; chosen => { root.page = 4; } }
        if root.page == 10: AppCard { x: 27px + (parent.width - 44px) / 2; y: 266px; width: (parent.width - 44px) / 2; height: 80px;
            label: "CALENDAR"; detail: "REMINDERS"; glyph: "D"; icon: @image-url("../assets/icons/calendar.svg"); accent: #ff9b68; chosen => { root.page = 5; root.edit-target = 4; } }
        if root.page == 10: AppCard { x: 17px; y: 356px; width: (parent.width - 44px) / 2; height: 80px;
            label: "PHONE"; detail: "DEMO ONLY"; glyph: "P"; icon: @image-url("../assets/icons/phone.svg"); accent: #8fb5cc; chosen => { root.page = 7; } }
        if root.page == 10: AppCard { x: 27px + (parent.width - 44px) / 2; y: 356px; width: (parent.width - 44px) / 2; height: 80px;
            label: "FILES"; detail: "ON DEVICE"; glyph: "F"; icon: @image-url("../assets/icons/files.svg"); accent: #ffcc55; chosen => { root.page = 9; root.refresh-files(); } }

        // Standard NexaWal (nexawal-android layout): slate/teal, bottom nav.
        if root.page == 16: Rectangle {
            x: 0px; y: root.desktop-mode ? 0px : 88px; width: parent.width; height: parent.height - (root.desktop-mode ? 0px : 88px);
            background: #081522;

            Flickable {
                x: 0px; y: 0px; width: parent.width; height: parent.height - (root.desktop-mode ? 64px : 0px);
                interactive: root.desktop-mode;
                viewport-width: self.width;
                viewport-height: root.desktop-mode ? max(self.height, 624px) : self.height;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: root.desktop-mode ? max(parent.height, 624px) : parent.height;
            // —— WALLET (home) — matches nexawal-android cards ——
            if root.wallet-tab == 0: Rectangle {
                width: parent.width; height: parent.height - 64px; background: #081522;
                // Balance card
                Rectangle { x: 16px; y: 8px; width: parent.width - 32px; height: 156px;
                    background: #102433; border-radius: 18px; border-color: #263D4B; border-width: 1px;
                    Text { x: 18px; y: 12px; text: "Wallet"; color: #A0B4C0; font-size: 13px; }
                    Text { x: 18px; y: 32px; width: parent.width - 36px;
                        text: root.wallet-balance == "—" ? "—" : root.wallet-balance + " XMR";
                        color: #E6F2F7; font-size: 26px; font-weight: 700; wrap: no-wrap; overflow: elide; }
                    Text { x: 18px; y: 64px; width: parent.width - 36px;
                        text: "Unlocked " + (root.wallet-unlocked == "—" ? "—" : root.wallet-unlocked) + " XMR";
                        color: #36C7D6; font-size: 12px; }
                    Text { x: 18px; y: 82px; width: parent.width - 36px;
                        text: root.wallet-address-short == "" ? "Opening address…" : root.wallet-address-short;
                        color: #A0B4C0; font-size: 11px; wrap: no-wrap; overflow: elide; }
                    // Send (teal) | Receive (green)
                    Rectangle { x: 18px; y: 102px; width: (parent.width - 48px) / 2; height: 36px;
                        background: #36C7D6; border-radius: 12px;
                        HorizontalLayout { width: parent.width; height: parent.height; alignment: center; spacing: 6px;
                            Image { width: 18px; height: 18px; source: @image-url("../assets/icons/wallet-send.svg"); colorize: #04151C; }
                            Text { text: "Send"; color: #04151C; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.wallet-tab = 2; } }
                    }
                    Rectangle { x: 30px + (parent.width - 48px) / 2; y: 102px; width: (parent.width - 48px) / 2; height: 36px;
                        background: #3DCF8E; border-radius: 12px;
                        HorizontalLayout { width: parent.width; height: parent.height; alignment: center; spacing: 6px;
                            Image { width: 18px; height: 18px; source: @image-url("../assets/icons/wallet-qr.svg"); colorize: #04151C; }
                            Text { text: "Receive"; color: #04151C; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.wallet-tab = 1; } }
                    }
                }
                // Sync status card — title + Node / Scanned / Height / Progress rows
                Rectangle { x: 16px; y: 176px; width: parent.width - 32px; height: 120px;
                    background: #102433; border-radius: 18px; border-color: #263D4B; border-width: 1px;
                    Text { x: 18px; y: 12px; width: parent.width - 36px; text: root.wallet-sync;
                        color: #E6F2F7; font-size: 15px; font-weight: 600; }
                    Text { x: 18px; y: 40px; width: parent.width - 36px; height: 78px;
                        text: root.wallet-sync-detail == "" ? ("Node  " + root.wallet-node) : root.wallet-sync-detail;
                        color: #A0B4C0; font-size: 12px; wrap: word-wrap; }
                }
                // Recent transactions
                Rectangle { x: 16px; y: 308px; width: parent.width - 32px; height: parent.height - 388px;
                    background: #102433; border-radius: 18px; border-color: #263D4B; border-width: 1px;
                    Text { x: 18px; y: 14px; text: "Recent Transactions"; color: #E6F2F7; font-size: 15px; font-weight: 600; }
                    if root.wallet-tx-amt-0 == "": Text {
                        x: 18px; y: 42px; width: parent.width - 36px; height: parent.height - 56px;
                        text: root.wallet-history; color: #3DCF8E; font-size: 13px; wrap: word-wrap;
                    }
                    if root.wallet-tx-amt-0 != "": Rectangle {
                        x: 18px; y: 42px; width: parent.width - 36px; height: parent.height - 56px;
                        WalletTxRow { y: 0px; width: parent.width; incoming: root.wallet-tx-in-0; amount: root.wallet-tx-amt-0; divider: root.wallet-tx-amt-1 != ""; }
                        WalletTxRow { y: 44px; width: parent.width; incoming: root.wallet-tx-in-1; amount: root.wallet-tx-amt-1; divider: root.wallet-tx-amt-2 != ""; }
                        WalletTxRow { y: 88px; width: parent.width; incoming: root.wallet-tx-in-2; amount: root.wallet-tx-amt-2; divider: root.wallet-tx-amt-3 != ""; }
                        WalletTxRow { y: 132px; width: parent.width; incoming: root.wallet-tx-in-3; amount: root.wallet-tx-amt-3; divider: root.wallet-tx-amt-4 != ""; }
                        WalletTxRow { y: 176px; width: parent.width; incoming: root.wallet-tx-in-4; amount: root.wallet-tx-amt-4; divider: false; }
                    }
                }
            }

            // —— RECEIVE ——
            if root.wallet-tab == 1: Rectangle {
                width: parent.width; height: parent.height - 64px; background: #081522;
                // Address QR. Amount, note, and payment link stay unwired.
                Rectangle { x: 16px; y: 8px; width: parent.width - 32px; height: 220px;
                    background: #102433; border-radius: 18px; border-color: #263D4B; border-width: 1px;
                    Rectangle { x: parent.width/2 - 64px; y: 12px; width: 128px; height: 128px;
                        background: #FFFFFF; border-radius: 8px;
                        if root.wallet-address-qr-visible: Image {
                            x: 6px; y: 6px; width: 116px; height: 116px;
                            source: root.wallet-address-qr; image-fit: contain;
                        }
                        if !root.wallet-address-qr-visible: Text {
                            width: parent.width; height: parent.height; text: "QR";
                            color: #04151C; font-size: 18px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Text { x: 16px; y: 148px; width: parent.width - 32px; height: 64px;
                        text: root.wallet-address == "" ? "Address will appear when the wallet opens." : root.wallet-address;
                        color: #E6F2F7; font-size: 12px; wrap: word-wrap; }
                }
                Text { x: 16px; y: 240px; text: "Payment Request (optional)"; color: #E6F2F7; font-size: 14px; font-weight: 600; }
                Text { x: 16px; y: 264px; text: "Amount"; color: #A0B4C0; font-size: 13px; }
                Rectangle { x: 16px; y: 284px; width: parent.width - 32px; height: 44px;
                    background: #102433; border-radius: 14px; border-color: #335364; border-width: 1px;
                    Text { x: 14px; y: 12px; text: "0.0000"; color: #6B8494; font-size: 16px; }
                    Text { x: parent.width - 56px; y: 12px; text: "XMR"; color: #A0B4C0; font-size: 16px; }
                }
                Text { x: 16px; y: 338px; text: "Description"; color: #A0B4C0; font-size: 13px; }
                Rectangle { x: 16px; y: 358px; width: parent.width - 32px; height: 44px;
                    background: #102433; border-radius: 14px; border-color: #335364; border-width: 1px;
                    Text { x: 14px; y: 12px; text: "Note for the payer"; color: #6B8494; font-size: 14px; }
                }
                Rectangle { x: 16px; y: 414px; width: parent.width - 32px; height: 44px;
                    background: #0C1C28; border-radius: 14px; border-color: #36C7D6; border-width: 1px;
                    Text { width: parent.width; height: parent.height; text: "Share Payment Link";
                        color: #36C7D6; font-size: 15px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { x: 16px; y: 468px; width: parent.width - 32px; height: 48px;
                    background: #36C7D6; border-radius: 14px;
                    Text { width: parent.width; height: parent.height; text: "Copy Address";
                        color: #04151C; font-size: 16px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.copy-wallet-address(); } }
                }
                Text { x: 16px; y: 526px; width: parent.width - 32px;
                    text: root.wallet-sync; color: #A0B4C0; font-size: 13px; wrap: word-wrap; }
            }

            // —— SEND ——
            if root.wallet-tab == 2: Rectangle {
                width: parent.width; height: parent.height - 64px; background: #081522;
                Text { x: 16px; y: 8px; text: "To address"; color: #A0B4C0; font-size: 13px; }
                Rectangle { x: 16px; y: 30px; width: parent.width - 32px; height: 72px;
                    background: #102433; border-radius: 14px;
                    border-color: root.edit-target == 11 ? #36C7D6 : #335364; border-width: 1px;
                    Text { x: 14px; y: 12px; width: parent.width - 28px; height: 48px;
                        text: root.wallet-send-dest == "" ? "To address" : root.wallet-send-dest;
                        color: root.wallet-send-dest == "" ? #6B8494 : #E6F2F7; font-size: 14px; wrap: word-wrap; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 11; } }
                }
                Text { x: 16px; y: 116px; text: "Amount"; color: #A0B4C0; font-size: 13px; }
                Rectangle { x: 16px; y: 138px; width: parent.width - 32px; height: 48px;
                    background: #102433; border-radius: 14px;
                    border-color: root.edit-target == 12 ? #36C7D6 : #335364; border-width: 1px;
                    Text { x: 14px; y: 14px; text: root.wallet-send-amount == "" ? "0.0" : root.wallet-send-amount; color: #E6F2F7; font-size: 16px; }
                    Text { x: parent.width - 56px; y: 14px; text: "XMR"; color: #A0B4C0; font-size: 16px; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 12; } }
                }
                Text { x: 16px; y: 200px; text: "Actions"; color: #A0B4C0; font-size: 13px; }
                Text { x: 16px; y: 222px; width: parent.width - 32px;
                    text: root.wallet-send-status == "" ? root.wallet-sync : root.wallet-send-status;
                    color: #A0B4C0; font-size: 13px; wrap: word-wrap; }
                Rectangle { x: 16px; y: 256px; width: parent.width - 32px; height: 44px;
                    background: #102433; border-radius: 14px; border-color: #335364; border-width: 1px;
                    Text { width: parent.width; height: parent.height; text: "Preview Fee";
                        color: #E6F2F7; font-size: 15px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.prepare-wallet-send(); } }
                }
                Rectangle { x: 16px; y: 310px; width: parent.width - 32px; height: 48px;
                    background: #36C7D6; border-radius: 14px;
                    Text { width: parent.width; height: parent.height; text: "Send";
                        color: #04151C; font-size: 16px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.confirm-wallet-send(); } }
                }
                Rectangle { x: 16px; y: 368px; width: parent.width - 32px; height: 44px;
                    background: #102433; border-radius: 14px; border-color: #335364; border-width: 1px;
                    Text { width: parent.width; height: parent.height; text: "Send Max";
                        color: #E6F2F7; font-size: 15px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => {
                        root.edit-target = 0;
                        if (root.wallet-balance == "—" || root.wallet-balance == "") {
                            root.wallet-send-max = false;
                            root.wallet-fee-ready = false;
                            root.wallet-send-status = "No balance to send";
                        } else {
                            root.wallet-send-max = true;
                            root.wallet-fee-ready = false;
                            root.wallet-send-amount = root.wallet-balance;
                            root.wallet-send-status = "Send max · preview the fee";
                        }
                    } }
                }
                Rectangle { x: 16px; y: 422px; width: parent.width - 32px; height: 44px;
                    background: #102433; border-radius: 14px; border-color: #335364; border-width: 1px;
                    Text { width: parent.width; height: parent.height; text: "Check pending transaction";
                        color: #E6F2F7; font-size: 14px;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.reconcile-wallet-send(); } }
                }
                Rectangle { x: 16px; y: 476px; width: parent.width - 32px; height: 44px;
                    background: #102433; border-radius: 14px; border-color: #335364; border-width: 1px;
                    Text { width: parent.width; height: parent.height; text: "Retry pending transaction";
                        color: #E6F2F7; font-size: 14px;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.retry-wallet-send(); } }
                }
            }

            // —— SETTINGS ——
            if root.wallet-tab == 3: Rectangle {
                width: parent.width; height: parent.height - 64px; background: #081522;
                Rectangle { x: 16px; y: 390px; width: parent.width - 32px; height: 42px;
                    background: #102433; border-radius: 12px;
                    Text { width: parent.width; height: parent.height; text: "Lock wallet"; color: #36C7D6; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.wallet-setup-action(5); } }
                }
                Text { x: 16px; y: 8px; text: "Appearance"; color: #A0B4C0; font-size: 13px; }
                Rectangle { x: 16px; y: 28px; width: parent.width - 32px; height: 56px;
                    background: #102433; border-radius: 14px; border-color: #263D4B; border-width: 1px;
                    Text { x: 16px; y: 18px; text: "Standard theme"; color: #E6F2F7; font-size: 15px; }
                    Rectangle { x: parent.width - 64px; y: 16px; width: 44px; height: 24px;
                        background: #36C7D6; border-radius: 12px;
                        Rectangle { x: 22px; y: 2px; width: 20px; height: 20px;
                            background: #E6F2F7; border-radius: 10px; }
                    }
                }
                Text { x: 16px; y: 96px; text: "Clearnet node"; color: #A0B4C0; font-size: 13px; }
                Rectangle { x: 16px; y: 116px; width: parent.width - 32px; height: 48px;
                    background: #102433; border-radius: 14px; border-color: #263D4B; border-width: 1px;
                    Text { x: 14px; y: 14px; width: parent.width - 28px; text: root.wallet-node;
                        color: #E6F2F7; font-size: 14px; wrap: no-wrap; overflow: elide; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 16; } }
                }
                Rectangle { x: 16px; y: 174px; width: parent.width - 32px; height: 40px;
                    background: #0C1C28; border-radius: 12px; border-color: #36C7D6; border-width: 1px;
                    Text { width: parent.width; height: parent.height; text: "Use this node";
                        color: #36C7D6; font-size: 14px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.set-wallet-node(); } }
                }
                Text { x: 16px; y: 218px; width: parent.width - 32px; text: root.wallet-node-status; color: #A0B4C0; font-size: 11px; overflow: elide; }
                Text { x: 16px; y: 230px; text: "About"; color: #A0B4C0; font-size: 13px; }
                Rectangle { x: 16px; y: 250px; width: parent.width - 32px; height: 120px;
                    background: #102433; border-radius: 14px; border-color: #263D4B; border-width: 1px;
                    Text { x: 16px; y: 14px; text: "nexawal 1.0.6 (6)"; color: #E6F2F7; font-size: 15px; }
                    Text { x: 16px; y: 40px; width: parent.width - 32px;
                        text: "MIT · unaudited. Remote nodes can see your IP.";
                        color: #A0B4C0; font-size: 12px; wrap: word-wrap; }
                    Text { x: 16px; y: 72px; text: "Terms of Use"; color: #36C7D6; font-size: 13px; }
                    Text { x: 130px; y: 72px; text: "Privacy policy"; color: #36C7D6; font-size: 13px; }
                    Text { x: 16px; y: 94px; text: "MIT License"; color: #36C7D6; font-size: 13px; }
                }
            }

            if root.wallet-setup != 0: Rectangle {
                width: parent.width; height: parent.height; background: #081522;
                Text { x: 16px; y: 10px; width: parent.width - 32px; text: "NexaWal setup"; color: #E6F2F7; font-size: 20px; font-weight: 700; }
                if root.wallet-setup == 1 || root.wallet-setup == 4: Rectangle {
                    x: 16px; y: 44px; width: parent.width - 32px; height: 38px; background: #102433; border-radius: 8px;
                    Text { width: parent.width; height: parent.height; text: "Network: " + (root.wallet-network == 0 ? "Mainnet" : root.wallet-network == 1 ? "Stagenet" : "Testnet") + "  · tap to change"; color: #E6F2F7; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.wallet-network = mod(root.wallet-network + 1, 3); } }
                }
                if root.wallet-setup == 1 || root.wallet-setup == 4: Rectangle {
                    x: 16px; y: 88px; width: parent.width - 32px; height: 38px; background: #102433; border-radius: 8px;
                    Text { x: 10px; width: parent.width - 20px; height: parent.height; text: "Restore height: " + root.wallet-height; color: #E6F2F7; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 15; } }
                }
                if root.wallet-setup == 2: Text { x: 16px; y: 48px; width: parent.width - 32px; height: 170px; text: "Write down these words privately:\n" + root.wallet-backup; color: #E6F2F7; font-size: 14px; wrap: word-wrap; }
                if root.wallet-setup == 4 || root.wallet-setup == 5: Rectangle {
                    x: 16px; y: root.wallet-setup == 4 ? 136px : 48px; width: parent.width - 32px; height: 112px; background: #102433; border-radius: 8px;
                    Text { x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px; text: root.wallet-words == "" ? "Enter your 25 seed words" : root.wallet-words; color: #E6F2F7; font-size: 13px; wrap: word-wrap; overflow: elide; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 14; } }
                }
                Text { x: 16px; y: root.wallet-setup == 4 ? 255px : 220px; width: parent.width - 32px; height: 42px; text: root.wallet-setup-status; color: #A0B4C0; font-size: 12px; wrap: word-wrap; }
                if root.wallet-setup == 1: Rectangle {
                    x: 16px; y: 145px; width: parent.width - 32px; height: 42px; background: #36C7D6; border-radius: 8px;
                    Text { width: parent.width; height: parent.height; text: "Create wallet"; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.wallet-setup-action(0); } }
                }
                if root.wallet-setup == 1: Rectangle {
                    x: 16px; y: 195px; width: parent.width - 32px; height: 42px; background: #102433; border-radius: 8px;
                    Text { width: parent.width; height: parent.height; text: "Restore wallet"; color: #E6F2F7; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.wallet-setup = 4; } }
                }
                if root.wallet-setup == 1: Rectangle {
                    x: 16px; y: 245px; width: parent.width - 32px; height: 42px; background: #102433; border-radius: 8px;
                    Text { width: parent.width; height: parent.height; text: "Unlock existing wallet"; color: #E6F2F7; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.wallet-setup = 5; } }
                }
                if root.wallet-setup == 2 || root.wallet-setup == 4 || root.wallet-setup == 5: Rectangle {
                    x: 16px; y: root.wallet-setup == 4 ? 302px : 270px; width: parent.width - 32px; height: 42px; background: #36C7D6; border-radius: 8px;
                    Text { width: parent.width; height: parent.height; text: root.wallet-setup == 2 ? "I wrote them down" : root.wallet-setup == 4 ? "Restore" : "Unlock"; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.wallet-setup-action(root.wallet-setup == 2 ? 1 : root.wallet-setup == 4 ? 3 : 4); } }
                }
                if root.wallet-setup == 2 || root.wallet-setup == 4 || root.wallet-setup == 5: Rectangle {
                    x: 16px; y: root.wallet-setup == 4 ? 350px : 318px; width: parent.width - 32px; height: 38px; background: #102433; border-radius: 8px;
                    Text { width: parent.width; height: parent.height; text: "Cancel"; color: #E6F2F7; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.wallet-setup-action(6); } }
                }
            }

                }
            }
            // Bottom nav — Wallet / Receive / Send / Settings
            if root.wallet-setup == 0: Rectangle { x: 0px; y: parent.height - 64px; width: parent.width; height: 64px;
                background: #081522; border-color: #173040; border-width: 1px;
                for t[i] in ["Wallet", "Receive", "Send", "Settings"]: Rectangle {
                    x: i * parent.width / 4; y: 0px; width: parent.width / 4; height: parent.height;
                    Image { x: (parent.width - 22px) / 2; y: 6px; width: 22px; height: 22px;
                        source: i == 0 ? @image-url("../assets/icons/wallet-home.svg") :
                                i == 1 ? @image-url("../assets/icons/wallet-qr.svg") :
                                i == 2 ? @image-url("../assets/icons/wallet-send.svg") :
                                         @image-url("../assets/icons/settings.svg");
                        colorize: root.wallet-tab == i ? #36C7D6 : #6B8494; }
                    Text { y: 36px; width: parent.width; text: t;
                        color: root.wallet-tab == i ? #36C7D6 : #6B8494;
                        font-size: 11px; horizontal-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.wallet-tab = i; root.edit-target = 0; } }
                }
            }
        }

        if root.page == 9: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 410px;
            background: #0b1926; border-color: #294454; border-width: 1px; border-radius: 12px;
            Text { x: 14px; y: 10px; text: "ON DEVICE"; color: #dcebf2; font-size: 16px; }
            if root.files-test-import-enabled: Rectangle {
                x: parent.width - 116px; y: 6px; width: 104px; height: 28px;
                background: #214a56; border-radius: 5px;
                Text { width: parent.width; height: parent.height; text: "Import test file";
                    color: #e8f5fb; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.import-test-file(); } }
            }
            Rectangle { x: 14px; y: 42px; width: parent.width - 28px; height: 1px; background: #294454; }
            Flickable {
                x: 7px; y: 50px; width: parent.width - 14px; height: 310px;
                viewport-width: self.width;
                viewport-height: max(self.height, saved-list.preferred-height);
                saved-list := VerticalLayout {
                    width: parent.width; spacing: 4px;
                    for name[index] in root.files-names: Rectangle {
                        height: 48px; background: #102433; border-radius: 6px;
                        Text { x: 10px; width: parent.width - 20px; height: parent.height;
                            text: name; color: #e8f5fb; font-size: 14px; overflow: elide; vertical-alignment: center; }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.open-saved-file(index); } }
                    }
                }
            }
            Text { x: 14px; y: 376px; width: parent.width - 28px; text: root.files-status;
                color: #a9c1cf; font-size: 13px; }
            if root.files-preview-open: Rectangle {
                x: 6px; y: 46px; width: parent.width - 12px; height: parent.height - 52px;
                background: #102433; border-color: #ffcc55; border-width: 1px;
                Text { x: 8px; y: 4px; width: parent.width - 42px; text: root.files-preview-name;
                    color: #ffcc55; font-size: 13px; overflow: elide; }
                Image { x: 8px; y: 34px; width: parent.width - 16px; height: parent.height - 108px;
                    source: root.files-preview; image-fit: contain; }
                Text { x: 10px; y: parent.height - 30px; width: parent.width - 20px;
                    text: root.files-preview-text; color: #a9c1cf; font-size: 12px; }
                TouchArea { x: parent.width - 34px; width: 34px; height: 34px; clicked => { root.files-preview-open = false; } }
                Text { x: parent.width - 24px; y: 4px; text: "×"; color: #ff8e9a; font-size: 18px; }
                Rectangle { x: parent.width - 144px; y: parent.height - 36px; width: 136px; height: 30px;
                    background: #522b38; border-radius: 5px;
                    Text { width: parent.width; height: parent.height;
                        text: root.files-delete-confirm ? "Confirm delete" : "Delete";
                        color: #ffccd1; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => {
                        if root.files-delete-confirm { root.delete-saved-file(); }
                        else { root.files-delete-confirm = true; }
                    } }
                }
            }
        }

        if root.page == 1 && !root.note-editing: Rectangle {
            x: 17px; y: 176px; width: parent.width - 34px; height: 420px; background: #050a12;
            if root.note == "": Text { x: 16px; y: 18px; text: "NO NOTES YET"; color: #8299a7; font-size: 15px; }
            if root.note != "": Rectangle {
                x: 0px; y: 0px; width: parent.width; height: 56px; background: #102433;
                border-color: #315e60; border-width: 1px; border-radius: 10px;
                Text { x: 16px; y: 16px; width: parent.width - 40px; height: 24px;
                    text: root.note; color: #e8f5fb; font-size: 16px; wrap: no-wrap; overflow: elide; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.note-editing = true; root.edit-target = 1;
                } }
            }
            Rectangle { x: parent.width - 68px; y: 352px; width: 52px; height: 52px;
                border-radius: 26px; background: #0b2428; border-color: #68ddc2; border-width: 2px;
                Text { width: parent.width; height: parent.height; text: "+"; color: #68ddc2;
                    font-size: 28px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.note-editing = true; root.edit-target = 1;
                } }
            }
        }
        if root.page == 1 && root.note-editing: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 216px;
            background: #102433; border-color: #315e60; border-width: 1px; border-radius: 12px;
            Text { x: 15px; y: 14px; width: parent.width - 30px; height: parent.height - 28px;
                text: root.note == "" ? "TAP KEYS TO WRITE A NOTE" : root.note;
                color: #ffffff; font-size: 22px; wrap: word-wrap; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 1; } }
        }
        if root.page == 1 && root.note-editing: Text { x: 18px; y: 400px; text: root.status; color: #ffffff; font-size: 17px; }
        if root.page == 1 && root.note-editing: AppCard { x: parent.width - 111px; y: 394px; width: 94px; height: 37px;
