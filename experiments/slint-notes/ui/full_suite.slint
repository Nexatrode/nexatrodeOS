            text: "SimpleXMQ 7.0.0.6 · AGPL-3.0-only\nPort source: github.com/Nexatrode/nexatrodeOS";
            color: #9bb6c4; font-size: 12px; wrap: word-wrap;
        }
        if root.page == 6 && !root.message-view && !root.message-join-view && root.message-service-ready && root.message-invitation-view: Rectangle {
            x: 17px; y: 176px; width: parent.width - 34px; height: 397px;
            background: #050a12;
            Text { x: 12px; y: 6px; text: root.message-address-view ? "YOUR ADDRESS" : "YOUR INVITATION"; color: #8299a7; font-size: 11px; }
            Text { x: 12px; y: 22px; width: parent.width - 24px;
                text: root.message-invitation-status; color: #7ee7f2; font-size: 14px; wrap: word-wrap; }
            if root.message-invitation-qr-visible: Rectangle {
                x: (parent.width - 168px) / 2; y: 56px; width: 168px; height: 168px;
                background: #ffffff; border-color: #28d8e8; border-width: 1px;
                Image {
                    x: 8px; y: 8px; width: 152px; height: 152px;
                    source: root.message-invitation-qr; image-fit: contain;
                }
            }
            if !root.message-invitation-qr-visible: Rectangle {
                x: (parent.width - 168px) / 2; y: 56px; width: 168px; height: 168px;
                background: #0c1b27; border-color: #1d4152; border-width: 1px;
                Text { width: parent.width; height: parent.height;
                    text: "QR PENDING"; color: #8299a7; font-size: 13px;
                    horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle {
                x: 10px; y: 236px; width: parent.width - 20px; height: 88px;
                background: #0c1b27; border-color: #1d4152; border-width: 1px;
                Text { x: 10px; y: 6px; text: "LINK"; color: #8299a7; font-size: 10px; }
                Text { x: 10px; y: 22px; width: parent.width - 20px; height: 56px;
                    text: root.message-invitation-uri == "" ? (root.message-address-view ? "Tap CHECK above to refresh the address." : "Tap CHECK above to refresh the invitation.") : root.message-invitation-uri;
                    color: #e8f5fb; font-size: 12px; wrap: word-wrap; overflow: elide; }
            }
            Rectangle { x: 10px; y: 336px; width: (parent.width - 28px) / 2; height: 36px;
                background: #103143; border-color: #7ee7f2; border-width: 1px;
                Text { width: parent.width; height: parent.height; text: "COPY";
                    color: #7ee7f2; font-size: 13px;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.copy-invitation();
                } }
            }
            Rectangle { x: 18px + (parent.width - 28px) / 2; y: 336px; width: (parent.width - 28px) / 2; height: 36px;
                background: #1a2430; border-color: #294454; border-width: 1px;
                Text { width: parent.width; height: parent.height; text: "CLOSE";
                    color: #9bb6c4; font-size: 13px;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.message-invitation-view = false;
                    root.message-address-view = false;
                    root.message-invitation-qr-visible = false;
                    root.edit-target = 0;
                } }
            }
            Text { x: 12px; y: 380px; width: parent.width - 24px;
                text: root.message-address-view ? "Reusable address · scan QR or copy for another device" : "Private one-time link · scan QR or copy for another device";
                color: #718995; font-size: 11px; }
        }
        if root.page == 6 && !root.message-view && root.message-join-view: Rectangle {
            x: 17px; y: 176px; width: parent.width - 34px; height: 280px;
            background: #050a12;
            Text { x: 10px; y: 4px; text: "JOIN CONNECTION"; color: #8299a7; font-size: 11px; }
            Text { x: 10px; y: 20px; width: parent.width - 20px;
                text: root.message-join-status; color: #7ee7f2; font-size: 14px; wrap: word-wrap; }
            Rectangle { x: 8px; y: 56px; width: parent.width - 16px; height: 100px;
                background: #0c1b27; border-color: root.edit-target == 7 ? #7ee7f2 : #1d4152; border-width: 1px;
                Text { x: 10px; y: 6px; text: "INVITATION LINK"; color: #8299a7; font-size: 10px; }
                Text { x: 10px; y: 24px; width: parent.width - 20px; height: 66px;
                    text: root.message-join-uri == "" ? "Tap to type or paste a simplex:/ or https://simplex.chat/ link" : root.message-join-uri;
                    color: root.message-join-uri == "" ? #718995 : #e8f5fb; font-size: 14px; wrap: word-wrap; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 7; } }
            }
            Rectangle { x: 8px; y: 168px; width: (parent.width - 32px) / 3; height: 40px;
                background: #103143; border-color: #7ee7f2; border-width: 1px;
                Text { width: parent.width; height: parent.height; text: "JOIN"; color: #7ee7f2; font-size: 13px;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.edit-target = 0; root.submit-join-invitation(root.message-join-uri);
                } }
            }
            Rectangle { x: 16px + (parent.width - 32px) / 3; y: 168px; width: (parent.width - 32px) / 3; height: 40px;
                background: #103143; border-color: #7ee7f2; border-width: 1px;
                Text { width: parent.width; height: parent.height; text: "CHECK"; color: #7ee7f2; font-size: 13px;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.edit-target = 0; root.check-join-status();
                } }
            }
            Rectangle { x: 24px + 2 * (parent.width - 32px) / 3; y: 168px; width: (parent.width - 32px) / 3; height: 40px;
                background: #1a2430; border-color: #294454; border-width: 1px;
                Text { width: parent.width; height: parent.height; text: "CANCEL"; color: #9bb6c4; font-size: 13px;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.message-join-view = false;
                    root.message-join-uri = "";
                    root.message-join-requested = false;
                    root.edit-target = 0;
                } }
            }
            Text { x: 10px; y: 222px; width: parent.width - 20px;
                text: "Stays on this device until join succeeds. CHATS closes without joining.";
                color: #718995; font-size: 12px; wrap: word-wrap; }
        }
        if root.page == 6 && root.message-view: Rectangle {
            x: 17px; y: 176px; width: parent.width - 34px;
            height: parent.height - 212px - root.keyboard-travel;
            background: #050a12;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 56px;
                background: #0c1b27; border-radius: 10px;
                Rectangle { x: 8px; y: 8px; width: 40px; height: 40px;
                    border-radius: 20px;
                    background: #28d8e8; }
                Text { x: 56px; y: 6px; width: parent.width - 160px; text: root.message-selected; color: #e8f5fb; font-size: 16px; }
                Text { x: 56px; y: 28px; width: parent.width - 160px;
                    text: root.message-contact-name == "" ? (root.message-peer == "" ? "Not connected" : "Key · " + root.message-peer) : "end-to-end encrypted";
                    color: #7ee7f2; font-size: 13px; }
                TouchArea { x: 0px; y: 0px; width: parent.width - 156px; height: parent.height; clicked => { root.edit-target = 0; } }
                Rectangle { x: parent.width - 148px; y: 10px; width: 66px; height: 36px;
                    background: #12384a; border-radius: 8px;
                    Text { width: parent.width; height: parent.height; text: "ARCHIVE";
                        color: #7ee7f2; font-size: 11px;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { x: parent.width - 74px; y: 10px; width: 66px; height: 36px;
                    background: #3a1820; border-radius: 8px;
                    Text { width: parent.width; height: parent.height; text: "DELETE";
                        color: #ff8e9a; font-size: 11px;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                // Touch targets above the painted buttons so QMP taps hit them.
                TouchArea {
                    x: parent.width - 148px; y: 0px; width: 66px; height: parent.height;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.archive-chat(root.message-chat-index, true);
                            root.message-view = false;
                            root.edit-target = 0;
                            root.message-list-tab = 2;
                        }
                    }
                }
                TouchArea {
                    x: parent.width - 74px; y: 0px; width: 66px; height: parent.height;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.delete-chat(root.message-chat-index);
                            root.message-view = false;
                            root.edit-target = 0;
                            root.message-list-tab = 0;
                        }
                    }
                }
            }
            if !root.message-service-ready: Rectangle { x: 9px; y: 68px; width: parent.width - 150px; height: 52px;
                background: #101c28; border-color: #294454; border-width: 1px;
                Text { x: 8px; y: 6px; width: parent.width - 16px; text: "Hey, are you free later?";
                    color: #e8f5fb; font-size: 13px; wrap: word-wrap; }
                Text { x: 8px; y: 32px; text: "09:13"; color: #8299a7; font-size: 11px; }
            }
            if !root.message-service-ready: Rectangle { x: parent.width - 168px; y: 132px; width: 156px; height: 52px;
                background: #0d2936; border-color: #28d8e8; border-width: 1px;
                Text { x: 8px; y: 6px; width: parent.width - 16px; text: "Yes, should be good.";
                    color: #e8f5fb; font-size: 13px; wrap: word-wrap; }
                Text { x: parent.width - 58px; y: 32px; text: "09:14  ✓✓"; color: #28d8e8; font-size: 11px; }
            }
            if root.message-service-ready && root.message-bubbles.length == 0: Text {
                x: 12px; y: 72px; width: parent.width - 24px;
                text: "No messages yet"; color: #e8f5fb; font-size: 16px;
                horizontal-alignment: center;
            }
            if root.message-service-ready && root.message-bubbles.length == 0: Text {
                x: 16px; y: 100px; width: parent.width - 32px;
                text: "Tap the compose field below to write";
                color: #8299a7; font-size: 13px; horizontal-alignment: center;
            }
            if root.message-service-ready: chat-scroll := ListView {
                x: 8px; y: 64px;
                width: parent.width - 16px;
                height: parent.height - 64px - (root.message-group-invite ? 148px : 108px);
                mouse-drag-pan-enabled: true;
                interactive: true;
                property <string> watched: root.message-transcript;
                property <bool> follow-latest: true;
                init => { self.content-y = self.height - self.content-height; }
                changed watched => {
                    self.follow-latest = true;
                    self.content-y = self.height - self.content-height;
                }
                changed content-height => {
                    if self.follow-latest { self.content-y = self.height - self.content-height; }
                }
                flicked => { self.follow-latest = false; }
                    for bubble[index] in root.message-bubbles: Rectangle {
                        // Every sent Photo is the same bundled JPEG. A later text
                        // line must not turn the picture back into the word Photo.
                        property <bool> photo-here: root.message-image-visible && bubble == "Photo" && index < root.message-bubble-side.length && root.message-bubble-side[index] == 1;
                        property <bool> incoming-photo: root.message-incoming-image-visible && index == root.message-incoming-photo-index;
                        property <bool> saved-photo: index < root.message-bubble-photo-ready.length && root.message-bubble-photo-ready[index];
                        property <bool> pending-photo: index < root.message-bubble-photo-pending.length && root.message-bubble-photo-pending[index];
                        property <bool> has-photo-id: index < root.message-bubble-photo-ids.length && root.message-bubble-photo-ids[index] != "";
                        // ListView materializes only rows intersecting the viewport.
                        init => { if self.has-photo-id { root.set-chat-photo-visibility(index, true); } }
                        changed has-photo-id => { if self.has-photo-id { root.set-chat-photo-visibility(index, true); } }
                        property <bool> has-file-id: index < root.message-bubble-files.length && root.message-bubble-files[index] != "";
                        property <bool> retryable: (has-photo-id || has-file-id) && index < root.message-bubble-upload-failed.length && root.message-bubble-upload-failed[index];
                        property <bool> show-photo: photo-here || incoming-photo || saved-photo || pending-photo || has-photo-id;
                        property <bool> show-caption: show-photo && bubble != "" && bubble != "Photo";
                        property <length> content-h: show-photo ? 148px + (show-caption ? msg.preferred-height : 0px) : msg.preferred-height;
                        property <bool> has-quote: index < root.message-bubble-quotes.length && root.message-bubble-quotes[index] != "";
                        property <bool> has-react: index < root.message-bubble-reacts.length && root.message-bubble-reacts[index] != "";
                        // Fixed quote band avoids forward-id preferred-height in Slint.
                        // A hidden Image still reports the JPEG's intrinsic size, and
                        // one copy on every row scrolls the thread into empty space.
                        property <length> quote-h: has-quote ? 28px : 0px;
                        height: card.height + 8px;
                        preferred-height: card.height + 8px;
                        card := Rectangle {
                            x: root.message-bubble-side[index] == 1 ? parent.width - self.width - 4px : 4px;
                            width: show-photo || has-photo-id ? 220px : min(parent.width * 74%, max(retryable ? 140px : 0px, msg.preferred-width + 16px));
                            height: (retryable ? 30px : 0px) + content-h + quote-h + (has-react ? 22px : 0px) + (root.message-bubble-time[index] == "" ? 16px : 32px);
                            border-radius: 14px;
                            background: root.message-bubble-side[index] == 1 ? #0d2936 : #101c28;
                            border-color: root.message-bubble-side[index] == 1 ? #28d8e8 : #294454;
                            border-width: 1px;
                            if photo-here: Image {
                                x: 4px; y: 4px + quote-h;
                                width: parent.width - 8px;
                                height: 140px;
                                source: root.message-image; image-fit: cover;
                            }
                            if incoming-photo || saved-photo: Image {
                                x: 4px; y: 4px + quote-h;
                                width: parent.width - 8px;
                                height: 140px;
                                source: saved-photo ? root.message-bubble-photos[index] : root.message-incoming-image;
                                image-fit: cover;
                            }
                            if pending-photo && !saved-photo: Text {
                                x: 8px; y: 8px + quote-h; width: parent.width - 16px; height: 132px;
                                text: "Loading photo…"; color: #8299a7; font-size: 12px;
                                vertical-alignment: center; horizontal-alignment: center;
                            }
                            if has-quote: Rectangle {
                                x: 8px; y: 8px; width: 3px; height: 20px;
                                background: root.message-bubble-side[index] == 1 ? #28d8e8 : #7ee7f2;
                            }
                            if has-quote: Text {
                                x: 16px; y: 8px; width: parent.width - 24px; height: 20px;
                                text: root.message-bubble-quotes[index];
                                overflow: elide;
                                font-size: 12px; color: #8eacbb;
                                vertical-alignment: center;
                            }
                            msg := Text {
                                x: 8px; y: 8px + quote-h + (show-photo ? 144px : 0px);
                                width: parent.width - 16px;
                                text: show-photo && !show-caption ? "" : bubble;
                                wrap: word-wrap;
                                font-size: 15px;
                                color: #e8f5fb;
                            }
                            if has-react: Text {
                                x: 8px;
                                y: content-h + quote-h + 4px;
                                text: root.message-bubble-reacts[index];
                                font-size: 14px;
                                color: #ffcc55;
                            }
                            Text {
                                x: root.message-bubble-side[index] == 1 ? parent.width - self.preferred-width - 8px : 8px;
                                y: content-h + quote-h + (has-react ? 26px : 8px) + (retryable ? 30px : 0px);
                                text: root.message-bubble-time[index];
                                font-size: 11px;
                                color: root.message-bubble-side[index] == 1 ? #28d8e8 : #8299a7;
                            }
                            TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => {
                                    if !show-photo && bubble != "" {
                                        root.inspect-bubble(bubble, index < root.message-bubble-files.length
                                            ? root.message-bubble-files[index] : "");
                                        if !root.message-file-open {
                                            // Quote the leaf body, not a nested ↩ line.
                                            root.message-reply-to = bubble;
                                            root.message-reply-mine = root.message-bubble-side[index] == 1;
                                            root.message-action-id = root.message-bubble-ids[index];
                                            root.message-edit-mode = false;
                                            root.edit-target = 6;
                                        }
                                    }
                                }
                            }
                            if retryable: Rectangle {
                                x: 8px; y: parent.height - 47px; width: 62px; height: 24px;
                                background: #12384a; border-radius: 5px;
                                Text { width: parent.width; height: parent.height; text: "Retry";
                                    color: #7ee7f2; horizontal-alignment: center; vertical-alignment: center; font-size: 13px; }
                                TouchArea { width: parent.width; height: parent.height; clicked => {
                                    root.retry-attachment(has-file-id ? root.message-bubble-files[index] : root.message-bubble-photo-ids[index], bubble);
                                } }
                            }
                            if has-photo-id && root.message-bubble-side[index] == 0: Rectangle {
                                x: parent.width - 58px; y: 8px; width: 50px; height: 26px;
                                background: #081522; border-radius: 5px;
                                Text { width: parent.width; height: parent.height; text: "SAVE";
                                    color: #7ee7f2; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { width: parent.width; height: parent.height; clicked => {
                                    root.save-chat-photo(root.message-bubble-photo-ids[index]);
                                } }
                            }
                            if has-file-id && root.message-bubble-side[index] == 0: Rectangle {
                                x: parent.width - 58px; y: parent.height - 27px; width: 50px; height: 24px;
                                background: #081522; border-radius: 5px;
                                Text { width: parent.width; height: parent.height; text: "SAVE";
                                    color: #7ee7f2; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { width: parent.width; height: parent.height; clicked => {
                                    root.save-chat-file(root.message-bubble-files[index], bubble);
                                } }
                            }
                        }
                    }
            }
            if root.message-group-invite: Rectangle {
                x: 8px; y: parent.height - 140px; width: parent.width - 16px; height: 32px;
                background: #12384a; border-color: #7ee7f2; border-width: 1px;
                Text { width: parent.width; height: parent.height; text: "JOIN GROUP";
                    color: #7ee7f2; font-size: 13px;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.message-group-invite = false;
                    root.message-view = false;
                    root.message-join-view = true;
                    root.message-invitation-view = false;
                    root.message-join-uri = root.message-group-uri;
                    root.edit-target = 0;
                    root.submit-join-invitation(root.message-group-uri);
                } }
            }
            if root.message-reply-to != "": Rectangle {
                x: 8px; y: parent.height - 140px; width: parent.width - 16px; height: 76px;
                background: #12384a; border-color: #7ee7f2; border-width: 1px;
                Rectangle { x: 8px; y: 14px; width: 3px; height: 18px; background: #7ee7f2; }
                Text { x: 16px; y: 3px; text: root.message-edit-mode ? "EDITING" :
                    (root.message-reply-mine ? "REPLY TO YOU" : "REPLY");
                    color: #7ee7f2; font-size: 10px; }
                Text { x: 16px; y: 16px; width: parent.width - 54px;
                    text: root.message-reply-to; color: #c5dbe6; font-size: 12px;
                    overflow: elide; }
                TouchArea { x: 8px; y: 30px; width: 52px; height: 22px; clicked => {
                    root.message-edit-mode = false;
                }
                    Text { x: 2px; y: 2px; text: "REPLY"; color: #7ee7f2; font-size: 11px; }
                }
                TouchArea { x: 64px; y: 30px; width: 44px; height: 22px; clicked => {
                    root.send-message("\u{001e}F\u{001f}" + root.message-reply-to);
                    root.message-reply-to = "";
                    root.message-action-id = "";
                    root.message-edit-mode = false;
                    root.edit-target = 0;
                }
                    Text { x: 2px; y: 2px; text: "FWD"; color: #7ee7f2; font-size: 11px; }
                }
                if root.message-reply-mine && root.message-action-id != "": TouchArea {
                    x: 112px; y: 30px; width: 48px; height: 22px; clicked => {
                        root.message-edit-mode = true;
                        root.message-body = root.message-reply-to;
                        root.edit-target = 6;
                    }
                    Text { x: 2px; y: 2px; text: "EDIT"; color: #ffcc55; font-size: 11px; }
                }
                if root.message-reply-mine && root.message-action-id != "": TouchArea {
                    x: 164px; y: 30px; width: 40px; height: 22px; clicked => {
                        root.send-message("\u{001e}D\u{001f}" + root.message-action-id);
                        root.message-reply-to = "";
                        root.message-action-id = "";
                        root.message-edit-mode = false;
                        root.edit-target = 0;
                    }
                    Text { x: 2px; y: 2px; text: "DEL"; color: #ff8e9a; font-size: 11px; }
                }
                // Embedded bitmaps render on the guest software backend.
                if root.message-action-id != "": HorizontalLayout {
                    x: 6px; y: 51px; width: parent.width - 12px; height: 24px;
                    for reaction in [
                        { emoji: "\u{1f44d}", icon: @image-url("../assets/reactions/thumbs-up.png") },
                        { emoji: "\u{1f44e}", icon: @image-url("../assets/reactions/thumbs-down.png") },
                        { emoji: "\u{1f600}", icon: @image-url("../assets/reactions/smile.png") },
                        { emoji: "\u{1f602}", icon: @image-url("../assets/reactions/laugh.png") },
                        { emoji: "\u{1f622}", icon: @image-url("../assets/reactions/sad.png") },
                        { emoji: "\u{2764}", icon: @image-url("../assets/reactions/heart.png") },
                        { emoji: "\u{1f680}", icon: @image-url("../assets/reactions/rocket.png") },
                        { emoji: "\u{2705}", icon: @image-url("../assets/reactions/check.png") }
                    ]: TouchArea {
                        horizontal-stretch: 1;
                        clicked => {
                            root.send-message("\u{001e}R\u{001f}" + root.message-action-id + "\u{001f}" + reaction.emoji);
                            root.message-reply-to = "";
                            root.message-action-id = "";
                            root.message-edit-mode = false;
                            root.edit-target = 0;
                        }
                        Image {
                            width: 20px; height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: reaction.icon;
                        }
                    }
                }
                TouchArea { x: parent.width - 36px; width: 36px; height: 30px; clicked => {
                    root.message-reply-to = "";
                    root.message-action-id = "";
                    root.message-edit-mode = false;
                } }
                Text { x: parent.width - 28px; y: 8px; text: "×"; color: #ff8e9a; font-size: 16px; }
            }
            if !root.send-idle && root.message-reply-to == "": Text { x: 8px; y: parent.height - 100px; width: parent.width - 16px; height: 16px;
                text: root.message-send-status; color: #7ee7f2; font-size: 12px; }
            if !root.receive-idle: Rectangle { x: 8px; y: parent.height - 82px; width: parent.width - 16px; height: 22px;
                Text { x: 0px; y: 2px; width: parent.width; height: 18px;
                    text: root.message-incoming-body == "" ? root.message-receive-status :
                        (root.message-ack-status == "ACKNOWLEDGED" ? "INCOMING MESSAGE ACKNOWLEDGED" : root.message-incoming-body);
                    color: #8eacbb; font-size: 12px; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.edit-target = 0;
                    if root.message-incoming-body == "" {
                        if root.message-receive-status == "CHECKING AGENT" || root.message-receive-status == "CHECKING AGENT · TAP TO REFRESH" {
                            root.check-message-receive-status();
                        } else {
                            root.receive-next-message();
                        }
                    } else if root.message-ack-status == "ACKNOWLEDGED" {
                        root.message-incoming-body = "";
                        root.message-ack-status = "";
                        root.receive-next-message();
                    } else if root.message-ack-status == "ACKNOWLEDGING" {
                        root.check-message-ack-status();
                    } else {
                        root.acknowledge-incoming-message();
                    }
                } }
            }
            if root.message-file-open: Rectangle {
                x: 8px; y: 38px; width: parent.width - 16px; height: parent.height - 150px;
                background: #102433; border-color: #7ee7f2; border-width: 1px; border-radius: 12px;
                Text { x: 10px; y: 6px; width: parent.width - 36px; text: root.message-file-name;
                    color: #7ee7f2; font-size: 12px; overflow: elide; }
                Flickable {
                    x: 10px; y: 28px; width: parent.width - 20px; height: parent.height - 38px;
                    viewport-width: self.width;
                    viewport-height: max(self.height, file-contents.preferred-height);
                    file-contents := Text {
                        width: parent.width; text: root.message-file-body;
                        color: #e8f5fb; font-size: 14px; wrap: word-wrap;
                    }
                }
                TouchArea { x: parent.width - 28px; y: 4px; width: 24px; height: 24px; clicked => {
                    root.message-file-open = false;
                } }
                Text { x: parent.width - 22px; y: 4px; text: "×"; color: #ff8e9a; font-size: 16px; }
            }
            if root.message-photo-picker-open: Rectangle {
                x: 8px; y: 38px; width: parent.width - 16px; height: parent.height - 150px;
                background: #102433; border-color: #7ee7f2; border-width: 1px; border-radius: 12px;
                Text { x: 10px; y: 8px; width: parent.width - 46px; text: "Choose from Files";
                    color: #7ee7f2; font-size: 14px; overflow: elide; }
                TouchArea { x: parent.width - 35px; y: 0px; width: 35px; height: 35px;
                    clicked => { root.message-photo-picker-open = false; } }
                Text { x: parent.width - 25px; y: 6px; text: "×"; color: #ff8e9a; font-size: 18px; }
                if root.message-photo-picker-labels.length == 0: Text {
                    x: 12px; y: 44px; width: parent.width - 24px;
                    text: "No matching saved files"; color: #a9c1cf; font-size: 13px; wrap: word-wrap;
                }
                Flickable {
                    x: 8px; y: 38px; width: parent.width - 16px; height: parent.height - 46px;
                    viewport-width: self.width;
                    viewport-height: max(self.height, picker-list.preferred-height);
                    picker-list := VerticalLayout {
                        width: parent.width; spacing: 4px;
                        for label[index] in root.message-photo-picker-labels: Rectangle {
                            height: 58px; background: #173040; border-radius: 6px;
                            Image { x: 6px; y: 4px; width: 50px; height: 50px;
                                source: root.message-photo-picker-images[index]; image-fit: contain; }
                            Text { x: 64px; width: parent.width - 72px; height: parent.height;
                                text: label; color: #e8f5fb; font-size: 14px; vertical-alignment: center; overflow: elide; }
                            TouchArea { width: parent.width; height: parent.height; clicked => {
                                root.message-photo-picker-open = false; root.pick-saved-photo(index);
                            } }
                        }
                    }
                }
            }
            if root.message-attach-menu: Rectangle {
                x: 8px; y: parent.height - 146px; width: 132px; height: 84px;
                background: #102433; border-color: #28d8e8; border-width: 1px; border-radius: 12px;
                Text { x: 10px; y: 8px; width: parent.width - 12px; height: 28px;
                    text: "Picture"; color: #e8f5fb; font-size: 15px; vertical-alignment: center; }
                TouchArea { y: 0px; width: parent.width; height: 40px; clicked => {
                    root.message-attach-menu = false;
                    root.attach-picture(true);
                } }
                Text { x: 10px; y: 46px; width: parent.width - 12px; height: 28px;
                    text: "File"; color: #e8f5fb; font-size: 15px; vertical-alignment: center; }
                TouchArea { y: 42px; width: parent.width; height: 40px; clicked => {
                    root.message-attach-menu = false;
                    root.attach-picture(false);
                } }
            }
            Rectangle { x: 8px; y: parent.height - 54px; width: parent.width - 16px; height: 42px;
                border-radius: 21px;
                background: #0c1b27; border-color: root.edit-target == 6 ? #7ee7f2 : #1d4152; border-width: 1px;
                Rectangle { x: 6px; y: 6px; width: 30px; height: 30px;
                    border-radius: 15px;
                    background: #12384a;
                    Text { width: parent.width; height: parent.height;
                        text: "+";
                        color: #7ee7f2; font-size: 18px;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => {
                        root.edit-target = 0;
                        root.message-attach-menu = !root.message-attach-menu;
                    } }
                }
                Text { x: 42px; y: 10px; width: parent.width - 88px;
                    text: root.message-body == "" ? "Message" : root.message-body;
                    color: root.message-body == "" ? #8eacbb : #e8f5fb; font-size: 16px; }
                Rectangle { x: parent.width - 40px; y: 6px; width: 30px; height: 30px;
                    border-radius: 15px;
                    background: #12384a; border-color: #7ee7f2; border-width: 1px;
                    Text { width: parent.width; height: parent.height;
                        text: "↑";
                        color: #7ee7f2; font-size: 16px;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => {
                        root.send-message(root.message-body);
                        root.edit-target = 0;
                    } }
                }
                TouchArea { x: 40px; y: 0px; width: parent.width - 84px; height: parent.height;
                    clicked => { root.edit-target = 6; } }
            }
            if !root.message-target-ready: Rectangle {
                width: parent.width; height: parent.height;
                background: #050a12e8;
                Text { x: 10px; y: 24px; width: parent.width - 20px;
                    text: root.message-receive-status; color: #8eacbb; font-size: 14px;
                    horizontal-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; }
            }
        }

        if root.page == 7: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 106px;
            background: #102433; border-color: #315369; border-width: 1px; border-radius: 12px;
            Text { x: 15px; y: 16px; text: root.phone-status; color: #ffffff; font-size: 22px; }
            Text { x: 15px; y: 57px; text: root.phone-number; color: #ffffff; font-size: 22px; }
        }
        if root.page == 7: Rectangle {
            x: 17px; y: 293px; width: parent.width - 34px; height: 326px;
            background: #081522;
            for key[index] in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "CLEAR", "0", "CALL"]: SoftKey {
                x: Math.mod(index, 3) * parent.width / 3;
                y: Math.floor(index / 3) * 83px;
                width: parent.width / 3 - 4px; height: 77px;
                label: key; typed(k) => { root.action(k); }
            }
        }

        if root.page == 8: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 452px;
            background: #050a12;
            for setting[index] in ["Network", "Privacy", "Display", "Database", "Sound", "Battery", "About"]: Rectangle {
                visible: index != 3 || root.show-preview-privacy-controls;
                x: 0px; y: (index - (index > 3 && !root.show-preview-privacy-controls ? 1 : 0)) * 55px;
                width: parent.width; height: 53px;
                background: root.settings-selected == index ? #101e2a : #050a12;
                Rectangle { x: 5px; y: 6px; width: 39px; height: 39px;
                    background: index == 1 || index == 3 ? #211c39 : #0c2531;
                    border-color: index == 1 || index == 3 ? #675b99 : #285263; border-width: 1px; border-radius: 9px;
                    Image { x: 7px; y: 7px; width: 24px; height: 24px;
                        source: index == 0 ? @image-url("../assets/icons/wifi.svg") :
                                index == 1 ? @image-url("../assets/icons/lock.svg") :
                                index == 2 ? @image-url("../assets/icons/display.svg") :
                                index == 3 ? @image-url("../assets/icons/lock.svg") :
                                index == 4 ? @image-url("../assets/icons/sound.svg") :
                                index == 5 ? @image-url("../assets/icons/battery.svg") :
                                             @image-url("../assets/icons/info.svg");
                        colorize: index == 1 || index == 3 ? #b4a0ff : #28d8e8; image-fit: contain; }
                }
                Text { x: 54px; y: 6px; width: parent.width - 90px; text: setting; color: #e8f5fb; font-size: 16px; overflow: elide; }
                Text { x: 54px; y: 29px; width: parent.width - 90px;
                    text: index == 0 ? "Wi-Fi, VPN, I2P" : (index == 1 ? (root.show-preview-privacy-controls ? "Receipts, pinned relays" : "Pinned relays") :
                          (index == 2 ? "Brightness, theme" : (index == 3 ? "Passphrase, export, import" :
                          (index == 4 ? "Volume, alerts" : (index == 5 ? "Power status" : "NexatrodeOS 0.1.0")))));
                    color: #8fa9b8; font-size: 12px; overflow: elide; }
                Text { x: parent.width - 24px; y: 15px; text: "›"; color: #688493; font-size: 18px; }
                Rectangle { x: 51px; y: 52px; width: parent.width - 51px; height: 1px; background: #142632; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.settings-selected = index;
                    if index == 0 { root.page = 11; }
                    else if index == 1 { root.page = 13; }
                    else if index == 2 { root.page = 12; }
                    else if index == 3 && root.show-preview-privacy-controls {
                        root.page = 15; root.edit-target = 0;
                        root.db-passphrase-current = ""; root.db-passphrase-new = "";
                        root.db-unlocked = false;
                        root.db-unlock-status = "LOCKED · ENTER PASSPHRASE";
                    }
                    else { root.settings-status = setting + " · DEMO SETTINGS"; }
                } }
            }
            Rectangle { x: 0px; y: root.show-preview-privacy-controls ? 391px : 336px; width: parent.width; height: 61px;
                background: #102332; border-color: root.aurora-accent ? #396d79 : #425766; border-width: 1px; border-radius: 10px;
                Text { x: 10px; y: 8px; text: "AURORA ACCENTS"; color: #dcebf2; font-size: 15px; }
                Text { x: 10px; y: 33px; text: root.aurora-accent ? "ON · HOME AND LOCK BACKDROPS" : "OFF · CLEAN BACKDROP";
                    color: #a9c1cf; font-size: 12px; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.aurora-accent = !root.aurora-accent; } }
            }
        }

        if root.page == 15 && root.show-preview-privacy-controls: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 250px;
            background: #050a12;
            Text { x: 4px; y: 4px; text: "CHAT DATABASE"; color: #e8f5fb; font-size: 16px; }
            Text { x: 4px; y: 28px; text: root.db-unlocked ? "SQLCIPHER · UNLOCKED" : "SQLCIPHER · ENCRYPTED";
                color: root.db-unlocked ? #23d398 : #b4a0ff; font-size: 12px; }
            Text { x: 4px; y: 52px; text: "CURRENT PASSPHRASE"; color: #8fa9b8; font-size: 11px; }
            Rectangle { x: 0px; y: 70px; width: parent.width; height: 40px;
                background: root.edit-target == 8 ? #102b37 : #0b1825;
                border-color: root.edit-target == 8 ? #28d8e8 : #294454; border-width: 1px;
                Text { x: 12px; y: 0px; width: parent.width - 24px; height: parent.height;
                    text: root.db-passphrase-current == "" ? "TAP TO ENTER" :
                          (root.db-unlocked ? root.db-passphrase-current : "••••••••");
                    color: #e8f5fb; font-size: 14px; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 8; } }
            }
            Text { x: 4px; y: 118px; text: "NEW PASSPHRASE"; color: #8fa9b8; font-size: 11px; }
            Rectangle { x: 0px; y: 136px; width: parent.width; height: 40px;
                background: root.edit-target == 9 ? #102b37 : #0b1825;
                border-color: root.edit-target == 9 ? #28d8e8 : #294454; border-width: 1px;
                Text { x: 12px; y: 0px; width: parent.width - 24px; height: parent.height;
                    text: root.db-passphrase-new == "" ? "TAP TO ENTER" : "••••••••";
                    color: #e8f5fb; font-size: 14px; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.edit-target = 9; } }
            }
            Rectangle { x: 0px; y: 186px; width: (parent.width - 8px) / 2; height: 44px;
                background: #0b2428; border-color: #23d398; border-width: 1px;
                Text { width: parent.width; height: parent.height; text: "UNLOCK"; color: #23d398; font-size: 14px;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.unlock-database-passphrase();
                } }
            }
            Rectangle { x: (parent.width + 8px) / 2; y: 186px; width: (parent.width - 8px) / 2; height: 44px;
                background: #1e2541; border-color: #9279ff; border-width: 1px;
                Text { width: parent.width; height: parent.height; text: "CHANGE"; color: #c9baff; font-size: 14px;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.change-database-passphrase();
                } }
            }
            Text { x: 4px; y: 236px; width: parent.width - 8px; text: root.db-unlock-status;
                color: #a9c1cf; font-size: 11px; wrap: word-wrap; }
        }
        if root.page == 15 && root.show-preview-privacy-controls: Rectangle { x: 17px; y: 432px; width: parent.width - 34px; height: 88px;
            background: #0b1825; border-color: #294454; border-width: 1px;
            Text { x: 12px; y: 12px; text: "EXPORT / IMPORT"; color: #e8f5fb; font-size: 13px; }
            Text { x: 12px; y: 36px; width: parent.width - 24px; text: root.db-export-status;
                color: #28d8e8; font-size: 11px; wrap: word-wrap; }
            Text { x: 12px; y: 58px; width: parent.width - 24px; text: root.db-import-status;
                color: #8fa9b8; font-size: 11px; wrap: word-wrap; }
        }

        if root.page == 11: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 488px;
            background: #050a12;
            for control[index] in ["Wi-Fi", "Bluetooth", "VPN", "Focus"]: Rectangle {
                x: Math.mod(index, 2) * (parent.width / 2 + 5px); y: Math.floor(index / 2) * 105px;
                width: parent.width / 2 - 5px; height: 94px;
                background: quick-selected == control ? #102b37 : #0b1825;
                border-color: index == 2 ? #23d398 : (index == 1 ? #9b7cff : #28d8e8);
                border-width: quick-selected == control ? 2px : 1px;
                border-radius: 12px;
                Text { x: 12px; y: 16px; text: index == 0 ? "⌁" : (index == 1 ? "B" : (index == 2 ? "◆" : "◐"));
                    color: index == 2 ? #23d398 : (index == 1 ? #b4a0ff : #28d8e8); font-size: 24px; }
                Text { x: 48px; y: 17px; text: control; color: #e8f5fb; font-size: 15px; }
                Text { x: 48px; y: 43px;
                    text: index == 0 ? "No network" : (index == 1 ? "Unavailable" : (index == 2 ? "No tunnel" : "Off"));
                    color: #8fa9b8; font-size: 12px; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.quick-selected = control; } }
            }
            Rectangle { x: 0px; y: 220px; width: parent.width; height: 62px;
                background: #102332; border-color: #294454; border-width: 1px; border-radius: 10px;
                Text { x: 13px; y: 21px; text: "☼  BRIGHTNESS"; color: #c6d8e1; font-size: 14px; }
                Rectangle { x: parent.width - 170px; y: 25px; width: 145px; height: 10px;
                    background: #0a1822; border-color: #286a77; border-width: 1px; }
                Rectangle { x: parent.width - 167px; y: 27px; width: 85px; height: 6px; background: #28d8e8; }
            }
            for shortcut[index] in ["AIRPLANE", "LOCKDOWN", "LOCATION", "ROTATE"]: Rectangle {
                visible: index != 1 || root.show-preview-privacy-controls;
                property <int> columns: root.show-preview-privacy-controls ? 4 : 3;
                property <int> column: index - (index > 1 && !root.show-preview-privacy-controls ? 1 : 0);
                x: 2px + column * (parent.width - 4px) / columns;
                y: 299px; width: (parent.width - 8px) / columns; height: 90px;
                Text { width: parent.width; y: 8px; text: index == 1 ? "▣" : (index == 0 ? "✈" : (index == 2 ? "◎" : "↻"));
                    color: index == 1 ? #23d398 : #9bb6c4; font-size: 22px; horizontal-alignment: center; }
                Text { width: parent.width; y: 45px; text: shortcut; color: #c6d8e1; font-size: 10px;
                    horizontal-alignment: center; }
                Text { width: parent.width; y: 64px; text: index == 1 ? "Demo" : "Off"; color: #28d8e8; font-size: 10px;
                    horizontal-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    if index == 1 { root.page = 13; } else { root.quick-selected = shortcut; }
                } }
            }
            Rectangle { x: 0px; y: 400px; width: parent.width; height: 62px;
                background: #102332; border-color: #294454; border-width: 1px; border-radius: 10px;
                Text { x: 13px; y: 21px; text: "◖  SOUND"; color: #c6d8e1; font-size: 14px; }
                Rectangle { x: parent.width - 170px; y: 25px; width: 145px; height: 10px;
                    background: #0a1822; border-color: #286a77; border-width: 1px; }
                Rectangle { x: parent.width - 167px; y: 27px; width: 95px; height: 6px; background: #28d8e8; }
            }
            Text { x: 3px; y: 468px; text: "LOCAL DEVICE CONTROLS ARE NOT CONNECTED"; color: #8299a7; font-size: 11px; }
        }

        if root.page == 12: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 446px;
            background: #050a12;
            for theme[index] in ["DARK", "DIM", "LIGHT"]: Rectangle {
                x: 0px; y: index * 136px; width: parent.width; height: 124px;
                background: theme-choice == theme ? #102433 : #0b1825;
                border-color: theme-choice == theme ? #28d8e8 : #294454;
                border-width: theme-choice == theme ? 2px : 1px;
                border-radius: 12px;
                Rectangle { x: 12px; y: 16px; width: 132px; height: 92px;
                    background: index == 0 ? #071522 : (index == 1 ? #211d38 : #c9d6dd);
                    border-color: #28d8e8; border-width: 1px;
                    Rectangle { x: 0px; y: 64px; width: parent.width; height: 28px;
                        background: index == 2 ? #aab8c2 : (index == 1 ? #302849 : #0b2232); }
                    Rectangle { x: 22px; y: 52px; width: 88px; height: 2px; background: #28d8e8; }
                }
                Text { x: 160px; y: 36px; text: theme; color: #e8f5fb; font-size: 16px; }
                Text { x: 160px; y: 64px; text: theme-choice == theme ? "SELECTED PREVIEW" : "TAP TO PREVIEW";
                    color: theme-choice == theme ? #28d8e8 : #8fa9b8; font-size: 12px; }
                Text { x: parent.width - 36px; y: 48px; text: theme-choice == theme ? "●" : "○";
                    color: theme-choice == theme ? #28d8e8 : #607a88; font-size: 18px; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.theme-choice = theme; } }
            }
            Text { x: 2px; y: 416px; text: "THEME SELECTION IS A VISUAL PREVIEW"; color: #8299a7; font-size: 12px; }
        }

        if root.page == 13: Rectangle { x: 17px; y: 176px; width: parent.width - 34px; height: 430px;
            background: #050a12;
            if root.show-preview-privacy-controls: Text { x: 4px; y: 8px; text: "MESSAGE RECEIPTS"; color: #e8f5fb; font-size: 15px; }
            if root.show-preview-privacy-controls: Text { x: 4px; y: 32px; width: parent.width - 8px;
                text: root.message-receipts ? "ON · SEND DELIVERY RECEIPTS" : "OFF · HIDE DELIVERY RECEIPTS";
                color: #8fa9b8; font-size: 12px; wrap: word-wrap; }
            if root.show-preview-privacy-controls: Rectangle { x: 0px; y: 60px; width: parent.width; height: 52px;
                background: #0b1825; border-color: root.message-receipts ? #23d398 : #294454; border-width: 1px;
                Text { x: 14px; height: parent.height; text: "SEND RECEIPTS";
                    color: #e8f5fb; font-size: 15px; vertical-alignment: center; }
                Text { x: parent.width - 72px; height: parent.height;
                    text: root.message-receipts ? "ON" : "OFF";
                    color: root.message-receipts ? #23d398 : #8fa9b8; font-size: 14px;
                    vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.message-receipts = !root.message-receipts;
                    root.settings-status = root.message-receipts
                        ? "RECEIPTS ON · DELIVERY ✓ ENABLED"
                        : "RECEIPTS OFF · LOCAL PREFERENCE";
                } }
            }
            Text { x: 4px; y: root.show-preview-privacy-controls ? 132px : 8px; text: "PINNED RELAYS"; color: #e8f5fb; font-size: 15px; }
            Text { x: 4px; y: root.show-preview-privacy-controls ? 156px : 32px; width: parent.width - 8px;
                text: "Public SMP/XFTP used by this guest. Tor and custom operators are not available here.";
                color: #8fa9b8; font-size: 12px; wrap: word-wrap; }
            Rectangle { x: 0px; y: root.show-preview-privacy-controls ? 210px : 86px; width: parent.width; height: 110px;
                background: #102332; border-color: #294454; border-width: 1px; border-radius: 10px;
                Text { x: 14px; y: 14px; text: "NETWORK"; color: #28d8e8; font-size: 12px; }
                Text { x: 14px; y: 40px; width: parent.width - 28px; text: root.message-servers;
                    color: #e8f5fb; font-size: 13px; wrap: word-wrap; }
                Text { x: 14px; y: 82px; text: "HOST MODE PUBLIC · PROXY NEVER";
                    color: #8fa9b8; font-size: 11px; }
            }
            if root.device-lock-available && !root.show-preview-privacy-controls: Rectangle {
                x: 0px; y: 220px; width: parent.width; height: 52px;
                background: #103143; border-color: #2b6875; border-width: 1px; border-radius: 9px;
                Text { width: parent.width; height: parent.height;
                    text: root.device-lock-enabled ? "LOCK NOW" : "SET DEVICE PASSPHRASE";
                    color: #7ee7f2; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.device-lock-action(0); } }
            }
            if root.device-lock-available && root.device-lock-enabled && !root.show-preview-privacy-controls: Rectangle {
                x: 0px; y: 282px; width: parent.width; height: 52px;
                background: #102332; border-color: #294454; border-width: 1px; border-radius: 9px;
                Text { width: parent.width; height: parent.height; text: "DISABLE DEVICE LOCK";
                    color: #7ee7f2; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.device-lock-action(1); } }
            }
            if root.show-preview-privacy-controls: Rectangle { x: 0px; y: 340px; width: parent.width; height: 55px;
                background: #0b2428; border-color: #23d398; border-width: 1px;
                Text { width: parent.width; height: parent.height;
                    text: root.lockdown-preview ? "LOCKDOWN PREVIEW ON" : "LOCKDOWN PREVIEW OFF";
                    color: #23d398; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => {
                    root.lockdown-preview = !root.lockdown-preview;
                } }
            }
        }

        if root.page == 14 && root.show-preview-privacy-controls: Rectangle { x: 17px; y: 64px; width: parent.width - 34px; height: 610px;
            background: #07132100;
            Image { x: (parent.width - 24px) / 2; y: 42px; width: 24px; height: 24px;
                source: @image-url("../assets/icons/lock.svg"); colorize: #dcebf2; image-fit: contain; }
            Text { x: 0px; y: 82px; width: parent.width; text: root.system-clock == "" ? "--:--" : root.system-clock;
                color: #eef8fd; font-size: 66px; font-weight: 700; horizontal-alignment: center; }
            Text { x: 0px; y: 493px; width: parent.width; text: "↑";
                color: #28d8e8; font-size: 26px; horizontal-alignment: center; }
            Text { x: 0px; y: 528px; width: parent.width; text: "SWIPE UP TO UNLOCK";
                color: #28d8e8; font-size: 14px; horizontal-alignment: center; }
            TouchArea { x: 0px; y: 480px; width: parent.width; height: 82px;
                clicked => { root.page = 0; root.edit-target = 0; } }
        }

        if root.page == 6 && root.message-join-view && root.edit-target == 7: InvitationKeyboard {
            x: 17px; y: 440px; width: parent.width - 34px; height: 228px;
            typed(k) => { root.join-key-tapped(k); }
        }
        if root.page == 15 && (root.edit-target == 8 || root.edit-target == 9): InvitationKeyboard {
            x: 17px; y: 528px; width: parent.width - 34px; height: 228px;
            typed(k) => { root.join-key-tapped(k); }
        }
        if !root.desktop-mode && root.page == 16 && (root.edit-target == 14 || root.edit-target == 15 || root.edit-target == 16): InvitationKeyboard {
            x: 0px; y: parent.height - 240px; width: parent.width; height: 228px;
            typed(k) => { root.key-tapped(k); }
        }
        if !root.desktop-mode && root.page == 16 && root.wallet-tab == 2 && root.wallet-setup == 0 && (root.edit-target == 11 || root.edit-target == 12): TouchKeyboard {
            x: 0px; y: parent.height - 240px; width: parent.width; height: 228px;
            decimal: root.edit-target == 12;
            shift-key: root.edit-target == 11;
            typed(k) => { root.key-tapped(k); }
        }
        if (root.page == 1 && root.note-editing) || (root.page == 2 && root.contact-detail) || root.page == 5: TouchKeyboard {
            x: 17px; y: 440px; width: parent.width - 34px; height: 228px;
            typed(k) => { root.key-tapped(k); }
        }
        if root.chat-keys-visible: Rectangle {
            x: 17px; y: root.chat-keyboard-top - 28px; width: parent.width - 34px; height: 28px;
            background: #0b1825; border-color: #203747; border-width: 1px;
            Text { width: parent.width; height: parent.height; text: "HIDE KEYBOARD";
                color: #7ee7f2; font-size: 12px;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => {
                root.edit-target = 0;
            } }
        }
        if root.chat-keys-visible: TouchKeyboard {
            x: 17px; y: root.chat-keyboard-top; width: parent.width - 34px; height: 228px;
            typed(k) => { root.key-tapped(k); }
        }
        if root.page != 6 && root.page != 14 && root.page != 15 && root.page != 16 && !root.message-keyboard: Text { x: 18px; y: parent.height - 25px;
            text: root.perf != "" ? root.perf :
                  root.page == 0 ? "TOUCH INPUT · VOLATILE APPS" :
                  root.page == 3 ? "CALCULATOR RUNS IN THIS IMAGE" :
                  root.page == 14 ? "LOCK SCREEN · UI PREVIEW" :
                  "VOLATILE SESSION · NO SYNC";
            color: #819aa8; font-size: 11px;
        }
        if root.page == 14: Rectangle {
            x: (parent.width - 92px) / 2; y: parent.height - 9px;
            width: 92px; height: 3px; border-radius: 2px; background: #eef8fd;
        }
        if root.device-lock-screen: Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            background: #050a12;
            TouchArea { width: parent.width; height: parent.height; }
            if root.device-lock-stage == 1 && root.device-lock-welcome: Rectangle {
                width: parent.width; height: parent.height; background: #050a12;
                if root.aurora-accent: Image {
                    width: parent.width; height: parent.height;
                    source: @image-url("../assets/nexatrode-aurora-wallpaper.png");
                    image-fit: cover;
                }
                Rectangle { width: parent.width; height: parent.height; background: #050a1260; }
                Image { x: (parent.width - 28px) / 2; y: 96px; width: 28px; height: 28px;
                    source: @image-url("../assets/icons/lock.svg"); colorize: #dcebf2; image-fit: contain; }
                Text { x: 24px; y: 148px; width: parent.width - 48px;
                    text: root.system-clock == "" ? "NEXATRODE" : root.system-clock;
                    color: #eef8fd; font-size: root.system-clock == "" ? 28px : 62px;
                    font-weight: 700; horizontal-alignment: center; }
                Text { x: 24px; y: 208px; width: parent.width - 48px; text: "DEVICE LOCKED";
                    color: #b7d3df; font-size: 13px; horizontal-alignment: center; }
                Text { x: 24px; y: parent.height - 122px; width: parent.width - 48px; text: "↑";
                    color: #7ee7f2; font-size: 25px; horizontal-alignment: center; }
                Text { x: 24px; y: parent.height - 80px; width: parent.width - 48px; text: "SWIPE UP TO UNLOCK";
                    color: #9aeaf0; font-size: 14px; horizontal-alignment: center; }
                TouchArea { width: parent.width; height: parent.height;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.up && self.pressed-y - self.mouse-y >= 60px {
                            root.device-lock-welcome = false;
                        }
                    }
                }
            }
            if root.device-lock-stage != 1 || !root.device-lock-welcome: Text { x: 17px; y: 105px; width: parent.width - 34px;
                text: root.device-lock-stage == 2 ? "SET PASSPHRASE" :
                      root.device-lock-stage == 3 ? "CONFIRM PASSPHRASE" :
                      root.device-lock-stage == 4 ? "DISABLE DEVICE LOCK" : "UNLOCK";
                color: #eef8fd; font-size: 22px; horizontal-alignment: center; }
            if root.device-lock-stage != 1 || !root.device-lock-welcome: Text { x: 17px; y: 150px; width: parent.width - 34px;
                text: root.device-lock-status; color: #8fa9b8; font-size: 14px;
                horizontal-alignment: center; wrap: word-wrap; }
            if root.device-lock-stage == 2 || root.device-lock-stage == 3: Text {
                x: 17px; y: 190px; width: parent.width - 34px;
                text: root.device-lock-setup-feedback; color: #8fa9b8; font-size: 14px;
                horizontal-alignment: center;
            }
            if root.device-lock-stage == 2 || root.device-lock-stage == 3 || root.device-lock-stage == 4: Rectangle {
                x: 17px; y: parent.height - 327px; width: parent.width - 34px; height: 34px;
                background: #0b1825;
                Text { width: parent.width; height: parent.height; text: "CANCEL"; color: #7ee7f2;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.device-lock-action(2); } }
            }
            if root.device-lock-stage >= 1 && (root.device-lock-stage != 1 || !root.device-lock-welcome): InvitationKeyboard { x: 17px; y: parent.height - 285px; width: parent.width - 34px; height: 228px;
                typed(k) => { root.device-lock-key(k); } }
            if root.device-lock-stage >= 1 && (root.device-lock-stage != 1 || !root.device-lock-welcome): Rectangle { x: 17px; y: parent.height - 50px; width: parent.width - 34px; height: 42px;
                background: #12384a; border-color: #7ee7f2; border-width: 1px;
                Text { width: parent.width; height: parent.height; text: "CONTINUE"; color: #7ee7f2;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.device-lock-submit(); } }
            }
        }

    }
}
