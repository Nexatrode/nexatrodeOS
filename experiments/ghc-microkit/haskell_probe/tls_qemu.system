<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-only TLS clock: QEMU's host-controlled PL031 is not a phone clock. -->
<system>
    <memory_region name="rng_mmio" size="0x1000" phys_addr="0x0a001000" />
    <memory_region name="rng_dma" size="0x2000" phys_addr="0x5fdc0000" />
    <memory_region name="rtc_mmio" size="0x1000" phys_addr="0x09010000" />
    <protection_domain name="timer_driver" priority="253" passive="true">
        <program_image path="timer_driver.elf" />
        <irq irq="30" id="0" trigger="level" />
    </protection_domain>
    <protection_domain name="entropy_rng" priority="102" passive="true" stack_size="0x4000">
        <program_image path="rust_entropy_rng.elf" />
        <map mr="rng_mmio" vaddr="0x52000000" perms="rw" cached="false" setvar_vaddr="rng_regs" />
        <map mr="rng_dma" vaddr="0x53000000" perms="rw" cached="false" setvar_vaddr="rng_dma" />
    </protection_domain>
    <protection_domain name="tls_clock" priority="103" passive="true">
        <program_image path="tls_clock.elf" />
        <map mr="rtc_mmio" vaddr="0x54000000" perms="rw" cached="false" setvar_vaddr="rtc_regs" />
    </protection_domain>
    <protection_domain name="client" priority="1" stack_size="1048576">
        <program_image path="client.elf" />
    </protection_domain>
    <channel>
        <end pd="timer_driver" id="1" />
        <end pd="client" id="0" notify="false" pp="true" />
    </channel>
    <channel>
        <end pd="entropy_rng" id="0" notify="false" />
        <end pd="client" id="1" notify="false" pp="true" />
    </channel>
    <channel>
        <end pd="tls_clock" id="0" notify="false" />
        <end pd="client" id="3" notify="false" pp="true" />
    </channel>
</system>
