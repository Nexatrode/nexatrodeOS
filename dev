def run(args, **kwargs):
    subprocess.run([str(arg) for arg in args], check=True, **kwargs)


def sha256(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def tool(name, llvm=False):
    directories = []
    if llvm:
        if os.environ.get("LLVM_BIN"):
            directories.append(Path(os.environ["LLVM_BIN"]))
        directories.extend([Path("/opt/homebrew/opt/llvm/bin"),
                            Path("/usr/local/opt/llvm/bin")])
    for directory in directories:
        path = directory / name
        if path.is_file():
            return str(path)
    path = shutil.which(name)
    if path:
        return path
    raise RuntimeError(f"Missing {name}. On macOS: brew install llvm lld qemu")


def setup():
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise RuntimeError("This initial SDK lock targets Apple Silicon macOS.")
    for name, llvm in [("clang", True), ("ld.lld", True), ("llvm-nm", True),
                       ("qemu-system-aarch64", False)]:
        tool(name, llvm)
    if not shutil.which("rustup"):
        raise RuntimeError("Missing rustup. Install the official Rust toolchain from https://rustup.rs")
    if not shutil.which("cargo"):
        raise RuntimeError("Missing cargo. Install the official Rust toolchain from https://rustup.rs")
    spec = LOCK["microkit"]
    CACHE.mkdir(exist_ok=True)
    archive = CACHE / spec["archive"]
    marker = SDK / ".verified-archive-sha256"
    if marker.exists() and marker.read_text().strip() == spec["sha256"]:
        return
    if not archive.exists():
        print(f"Downloading Microkit {spec['version']} (about 70 MiB)...", flush=True)
        partial = archive.with_suffix(".download")
        run(["curl", "--fail", "--location", "--retry", "3", "--output", partial, spec["url"]])
        if sha256(partial) != spec["sha256"]:
            raise RuntimeError(f"SDK checksum mismatch: {partial}")
        partial.replace(archive)
    if sha256(archive) != spec["sha256"]:
        raise RuntimeError(f"SDK checksum mismatch: remove {archive} and retry")
    if SDK.exists():
        raise RuntimeError(f"Unverified SDK directory exists: {SDK}; move it aside and retry")
    print("SDK checksum verified; extracting...", flush=True)
    with tempfile.TemporaryDirectory(dir=CACHE) as temporary:
        with tarfile.open(archive) as bundle:
            bundle.extractall(temporary, filter="data")
        shutil.move(str(Path(temporary) / SDK.name), SDK)
    marker.write_text(spec["sha256"] + "\n")


def build(budget_pressure=False):
    setup()
    print("WARNING: QEMU image uses the embedded development key; it does not protect data from source or image holders.", flush=True)
    python = setup_sddf()
    for name in ("make", "dtc", "gdisk", "mkfs.fat"):
        tool(name)
    BUILD.mkdir(exist_ok=True)
    board = SDK / "board" / LOCK["board"] / LOCK["configuration"]
    compiler, linker = tool("clang", True), tool("ld.lld", True)
    rust_env = os.environ.copy()
    rust_env["SEL4_INCLUDE_DIRS"] = str(board / "include")
    features = ["development-crypto"]
    if budget_pressure:
        features.append("budget-pressure")
    cargo_build = [tool("cargo"), "build", "--locked", "--release", "--target",
                   "aarch64-sel4-microkit", "--target-dir", BUILD / "rust-target",
                   "--features", ",".join(features)]
    # The supervisor embeds the crasher's post-fault restart entry address.
    # Build that image first, then generate the Rust constant before compiling
    # the remaining binaries.
    run(cargo_build + ["--bin", "rust_crasher"], cwd=ROOT / "rust", env=rust_env)
    rust_release = BUILD / "rust-target" / "aarch64-sel4-microkit" / "release"
    crasher_path = rust_release / "rust_crasher.elf"
    crasher_elf = crasher_path.read_bytes()
    if crasher_elf[:6] != b"\x7fELF\x02\x01":
        raise RuntimeError("Rust crasher is not a little-endian ELF64 binary")
    symbols = subprocess.check_output(
        [tool("llvm-nm", True), "--defined-only", crasher_path], text=True
    )
    restart_entries = [int(line.split()[0], 16) for line in symbols.splitlines()
                       if len(line.split()) >= 3 and
                       line.split()[-1] == "rust_crasher_restart_entry"]
    if len(restart_entries) != 1:
        raise RuntimeError("Could not locate the Rust crasher restart entry point")
    crasher_restart_entry = restart_entries[0]
    if crasher_restart_entry < 0x200000 or crasher_restart_entry % 4 != 0:
        raise RuntimeError(f"Unexpected Rust crasher restart entry: {crasher_restart_entry:#x}")
    (BUILD / "crasher_entry.h").write_text(
        "#pragma once\n"
        f"#define CRASHER_RESTART_ENTRY ((seL4_Word)0x{crasher_restart_entry:x})\n"
    )
    (BUILD / "crasher_entry.rs").write_text(
        f"const CRASHER_RESTART_ENTRY: usize = 0x{crasher_restart_entry:x};\n"
    )
    run(cargo_build + ["--bins"], cwd=ROOT / "rust", env=rust_env)
    for component in ["rust_server", "rust_crasher", "rust_clock", "rust_client",
                      "rust_console", "rust_vault", "rust_vault_disk",
                      "rust_entropy_rng", "rust_input_service",
                      "rust_vault_test_client", "rust_vault_notes_test",
                      "rust_vault_contacts_test", "rust_calculator_app",
                      "rust_calendar_app", "rust_messages_app", "rust_settings_app"]:
        shutil.copy2(rust_release / f"{component}.elf", BUILD / f"{component}.elf")
    c_server_obj = BUILD / "c_server.o"
    run([compiler, "--target=aarch64-none-elf", "-mcpu=cortex-a53", "-mstrict-align",
         "-ffreestanding", "-fno-stack-protector", "-fno-pic", "-g", "-O2",
         "-Wall", "-Wextra", "-Werror", "-I", board / "include",
         "-c", ROOT / "src/server.c", "-o", c_server_obj])
    run([linker, "-L", board / "lib", c_server_obj, "-lmicrokit", "-Tmicrokit.ld",
         "-o", BUILD / "c_server.elf"])

    build_env = os.environ.copy()
    build_env["SEL4_INCLUDE_DIRS"] = str(board / "include")
    build_env["PATH"] = os.pathsep.join([
        "/opt/homebrew/opt/llvm/bin", "/opt/homebrew/sbin", build_env.get("PATH", "")
    ])
    storage_system = BUILD / "storage-components.system"
    make_args = [tool("make"), "-C", SDDF / "examples/blk",
                 f"MICROKIT_SDK={SDK}", f"MICROKIT_BOARD={LOCK['board']}",
                 f"MICROKIT_CONFIG={LOCK['configuration']}", f"SDDF={SDDF}",
                 f"PYTHON={python}", f"BUILD_DIR={BUILD}",
                 f"METAPROGRAM={ROOT / 'tests/storage_meta.py'}",
                 f"SYSTEM_FILE={storage_system.name}", "all"]
    run(make_args, cwd=ROOT, env=build_env)
    run([tool("llvm-objcopy", True), "--update-section",
         f".blk_client_config={BUILD / 'blk_client_vault.data'}",
         BUILD / "rust_vault_disk.elf"])
    run([python, ROOT / "tests/merge_storage_system.py", "--base", ROOT / "system.system",
         "--storage", storage_system, "--output", BUILD / "system.system"])
    run([SDK / "bin/microkit", BUILD / "system.system", "--search-path", BUILD,
         "--board", LOCK["board"], "--config", LOCK["configuration"],
         "-o", BUILD / "loader.img", "-r", BUILD / "report.txt"])
    run([compiler, "--target=aarch64-none-elf", "-c", ROOT / "src/boot-image.S",
         "-o", BUILD / "boot-image.o"], cwd=ROOT)
    run([linker, "-Ttext=" + LOCK["load_address"], "--entry=_start",
         BUILD / "boot-image.o", "-o", BUILD / "loader.elf"])
    versions = {name: subprocess.check_output([path, "--version"], text=True).splitlines()[0]
                for name, path in [("clang", compiler), ("linker", linker),
                                   ("qemu", tool("qemu-system-aarch64"))]}
    versions["rustc"] = subprocess.check_output(
        [tool("rustc"), "--version"], cwd=ROOT / "rust", text=True
    ).splitlines()[0]
    (BUILD / "build-info.json").write_text(json.dumps({
        "toolchain": LOCK, "actual_versions": versions,
        "loader_sha256": sha256(BUILD / "loader.img"),
        "elf_sha256": sha256(BUILD / "loader.elf"),
    }, indent=2) + "\n")
    prepare_vault_disk(PERSISTENT_DISK, reset=False, env=build_env)
    print(f"Built {BUILD / 'loader.img'}", flush=True)


def setup_sddf():
    """Fetch the pinned sDDF source and install its pinned meta-tool package."""
    spec = LOCK["sddf"]
    marker = SDDF_PINNED / ".verified-archive-sha256"
    if SDDF_PINNED.exists():
        if marker.exists() and marker.read_text().strip() == spec["sha256"]:
            pass
        elif (SDDF_PINNED / ".git").exists():
            revision = subprocess.check_output(
                ["git", "-C", SDDF_PINNED, "rev-parse", "HEAD"], text=True
            ).strip()
            dirty = subprocess.check_output(
                ["git", "-C", SDDF_PINNED, "status", "--porcelain"], text=True
            ).strip()
            if revision != spec["revision"] or dirty:
                raise RuntimeError(
                    f"Refusing to use unpinned or modified sDDF source at {SDDF_PINNED}"
                )
        else:
            raise RuntimeError(
                f"Unverified sDDF directory exists at {SDDF_PINNED}; move it aside and retry"
            )
    else:
        CACHE.mkdir(exist_ok=True)
        archive = CACHE / spec["archive"]
        if not archive.exists():
            partial = archive.with_suffix(".download")
            print("Downloading pinned sDDF source (about 4 MiB)...", flush=True)
            run(["curl", "--fail", "--location", "--retry", "3", "--output", partial, spec["url"]])
            if sha256(partial) != spec["sha256"]:
                raise RuntimeError(f"sDDF archive checksum mismatch: {partial}")
            partial.replace(archive)
        if sha256(archive) != spec["sha256"]:
            raise RuntimeError(f"sDDF archive checksum mismatch: remove {archive} and retry")
        root = f"sddf-{spec['revision']}"
        with tempfile.TemporaryDirectory(dir=CACHE) as temporary:
            with tarfile.open(archive) as bundle:
                bundle.extractall(temporary, filter="data")
            shutil.move(str(Path(temporary) / root), SDDF_PINNED)
        marker.write_text(spec["sha256"] + "\n")

    prepare_sddf_overlay()

    python = SDDF_VENV / "bin" / "python"
    if not python.exists():
        run([sys.executable, "-m", "venv", SDDF_VENV])
    try:
        installed = subprocess.check_output(
            [python, "-c", "import importlib.metadata; print(importlib.metadata.version('sdfgen'))"],
            text=True,
        ).strip()
    except subprocess.CalledProcessError:
        installed = ""
    if installed != spec["sdfgen"]:
        run([python, "-m", "pip", "install", f"sdfgen=={spec['sdfgen']}"])
    return python


def setup_mbedtls():
    """Fetch the pinned Mbed TLS tree used by the net-fragment TLS smoke."""
    spec = LOCK["mbedtls"]
    marker = MBEDTLS / ".verified-archive-sha256"
    if MBEDTLS.exists() and marker.exists() and marker.read_text().strip() == spec["sha256"]:
        return MBEDTLS
    if MBEDTLS.exists():
        raise RuntimeError(
            f"Unverified Mbed TLS directory exists at {MBEDTLS}; move it aside and retry"
        )
    CACHE.mkdir(exist_ok=True)
    archive = CACHE / spec["archive"]
    if not archive.exists():
        partial = Path(str(archive) + ".download")
        print("Downloading pinned Mbed TLS (about 5 MiB)...", flush=True)
        run(["curl", "--fail", "--location", "--retry", "3", "--output", partial, spec["url"]])
        if sha256(partial) != spec["sha256"]:
            raise RuntimeError(f"Mbed TLS archive checksum mismatch: {partial}")
        partial.replace(archive)
    if sha256(archive) != spec["sha256"]:
        raise RuntimeError(f"Mbed TLS archive checksum mismatch: remove {archive} and retry")
    root = f"mbedtls-{spec['version']}"
    with tempfile.TemporaryDirectory(dir=CACHE) as temporary:
        with tarfile.open(archive) as bundle:
            bundle.extractall(temporary, filter="data")
        extracted = Path(temporary) / root
        if not extracted.exists():
            raise RuntimeError(f"Mbed TLS archive missing {root}")
        shutil.move(str(extracted), MBEDTLS)
    marker.write_text(spec["sha256"] + "\n")
    return MBEDTLS


def prepare_sddf_overlay():
    """Copy verified sDDF and apply repository-owned driver fixes."""
    patch_file = ROOT / "patches" / "sddf-personal-os.patch"
    state = f"{LOCK['sddf']['sha256']} {sha256(patch_file)}\n"
    state_file = SDDF / ".personal-os-overlay-state"
    if state_file.exists() and state_file.read_text() == state:
        return
    if SDDF.exists():
        if not state_file.exists():
            raise RuntimeError(f"Refusing to overwrite an unmanaged sDDF overlay at {SDDF}")
        shutil.rmtree(SDDF)

    shutil.copytree(SDDF_PINNED, SDDF, ignore=shutil.ignore_patterns(".git"))
    try:
        run([tool("patch"), "--batch", "--forward", "-p1", "-i", patch_file], cwd=SDDF)
        state_file.write_text(state)
    except BaseException:
        shutil.rmtree(SDDF)
        raise


def prepare_vault_disk(path, reset, env=None):
    """Create a GPT image and clear the namespace area and legacy gap."""
    path = Path(path)
    if path.exists() and not reset:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    run([SDDF / "tools/mkvirtdisk", path, "1", "512", "16777216", "GPT"],
        cwd=path.parent, env=env)
    with path.open("r+b") as disk:
        disk.seek(2048 * 512)
        disk.write(bytes(10 * 4096))
        disk.flush()
        os.fsync(disk.fileno())


def storage_qemu_command(loader=None, disk=None, qmp_socket=None, disk_format="raw",
                        paused=False):
    loader = Path(loader) if loader else STORAGE_BUILD / "loader.img"
    disk = Path(disk) if disk else STORAGE_BUILD / "disk"
    command = [tool("qemu-system-aarch64"), "-machine", "virt,virtualization=on",
            "-accel", "tcg", "-cpu", "cortex-a53", "-smp", "1", "-m", "2G",
            "-serial", "mon:stdio", "-global", "virtio-mmio.force-legacy=false",
            "-device", f"loader,file={loader},addr=0x70000000,cpu-num=0",
            "-device", "virtio-blk-device,drive=hd,bus=virtio-mmio-bus.1",
            "-device", "virtio-rng-device,bus=virtio-mmio-bus.8",
            "-nographic", "-d", "guest_errors",
            "-drive", f"file={disk},if=none,format={disk_format},id=hd"]
    if paused:
        command.append("-S")
    if qmp_socket is not None:
        command.extend(["-qmp", f"unix:{qmp_socket},server=on,wait=on"])
    return command


def qmp_connect(path, process, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError(f"QEMU exited before opening its QMP socket ({process.returncode})")
        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        connection.settimeout(5)
        try:
            connection.connect(str(path))
            stream = connection.makefile("rwb", buffering=0)
            greeting = json.loads(stream.readline())
            if "QMP" not in greeting:
                raise RuntimeError("QEMU QMP socket did not send its greeting")
            qmp_execute(stream, "qmp_capabilities")
            return connection, stream
        except (FileNotFoundError, ConnectionRefusedError):
            connection.close()
            time.sleep(0.02)
    raise RuntimeError(f"timed out waiting for QEMU QMP socket at {path}")


def qmp_execute(stream, command, arguments=None):
    request = {"execute": command}
    if arguments is not None:
        request["arguments"] = arguments
    stream.write(json.dumps(request).encode() + b"\r\n")
    while True:
        line = stream.readline()
        if not line:
            raise RuntimeError(f"QMP closed while waiting for {command}")
        response = json.loads(line)
        if "error" in response:
            raise RuntimeError(f"QMP {command} failed: {response['error']}")
        if "return" in response:
            return response["return"]


def qmp_hmp(stream, command_line):
    result = qmp_execute(stream, "human-monitor-command",
                         {"command-line": command_line})
    if isinstance(result, str) and result.lstrip().startswith("Error"):
        raise RuntimeError(f"QEMU monitor {command_line!r} failed: {result.strip()}")
    return result


def storage_boot(expected, log_name, timeout):
    output = bytearray()
    master, slave = pty.openpty()
    process = subprocess.Popen(storage_qemu_command(), cwd=STORAGE_BUILD,
                               stdin=slave, stdout=slave, stderr=subprocess.STDOUT,
                               close_fds=True)
    os.close(slave)
    deadline = time.monotonic() + timeout
    completed_at = None
    forbidden = [b"FAIL:", b"MON|ERROR", b"Kernel panic"]
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(master, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                for key, _ in selector.select(timeout=0.1):
                    try:
                        data = os.read(key.fd, 65536)
                    except OSError:
                        data = b""
                    if data:
                        output.extend(data)
                        sys.stdout.buffer.write(data)
                        sys.stdout.buffer.flush()
                if any(token in output for token in forbidden):
                    break
                if all(token.encode() in output for token in expected):
                    completed_at = completed_at or time.monotonic()
                    if time.monotonic() - completed_at > 0.4:
                        break
                if process.poll() is not None:
                    raise RuntimeError(f"Storage QEMU exited unexpectedly ({process.returncode})")
    finally:
        if process.poll() is None:
            process.send_signal(signal.SIGTERM)
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        try:
            while True:
                data = os.read(master, 65536)
                if not data:
                    break
                output.extend(data)
        except OSError:
            pass
        os.close(master)
        (STORAGE_BUILD / log_name).write_bytes(output)

    trace = output.decode(errors="replace")
    missing = [token for token in expected if token not in trace]
    if missing or any(token.decode() in trace for token in forbidden):
        raise RuntimeError(f"Storage boot failed; missing or out-of-order evidence: {missing}; see {STORAGE_BUILD / log_name}")


def storage_interruption_boot(point, case_dir, timeout):
    names = {
        1: "BEFORE_STAGE_FLUSH",
        2: "AFTER_STAGE_FLUSH",
        3: "BEFORE_COMMIT_FLUSH",
        4: "AFTER_COMMIT_FLUSH",
        5: "BEFORE_STAGE_FLUSH",
        6: "AFTER_STAGE_FLUSH",
        7: "BEFORE_COMMIT_FLUSH",
        8: "AFTER_COMMIT_FLUSH",
    }
    reset_marker = f"STORAGE|RESET_POINT|{names[point]}"
    recovery_marker = f"STORAGE|INTERRUPTION_RECOVERY_OK: point={point} generation="
    entropy_marker = "STORAGE|ENTROPY|PASS: fresh samples delivered"
    log_path = case_dir / "qmp-reset.log"
    qmp_directory = tempfile.TemporaryDirectory(prefix="psq-", dir="/tmp")
    qmp_path = Path(qmp_directory.name) / "q.sock"

    output = bytearray()
    master, slave = pty.openpty()
    process = subprocess.Popen(
        storage_qemu_command(case_dir / "loader.img", case_dir / "disk", qmp_path),
        cwd=case_dir, stdin=slave, stdout=slave, stderr=subprocess.STDOUT,
        close_fds=True,
    )
    os.close(slave)
    qmp_connection = qmp_stream = None
    deadline = time.monotonic() + timeout
    reset_sent = False
    recovered_at = None
    forbidden = (b"FAIL:", b"MON|ERROR", b"Kernel panic")
    try:
        qmp_connection, qmp_stream = qmp_connect(qmp_path, process, timeout)
        with selectors.DefaultSelector() as selector:
            selector.register(master, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                for key, _ in selector.select(timeout=0.1):
                    try:
                        data = os.read(key.fd, 65536)
                    except OSError:
                        data = b""
                    if data:
                        output.extend(data)
                        sys.stdout.buffer.write(data)
                        sys.stdout.buffer.flush()
                trace = output.decode(errors="replace")
                if any(token.decode() in trace for token in forbidden):
                    break
                if reset_marker in trace and not reset_sent:
                    qmp_execute(qmp_stream, "system_reset")
                    reset_sent = True
                if reset_sent and recovery_marker in trace:
                    recovered_at = recovered_at or time.monotonic()
                    if time.monotonic() - recovered_at > 0.4:
                        break
                if process.poll() is not None:
                    raise RuntimeError(
                        f"QEMU exited during flush-interruption test ({process.returncode})"
                    )
    finally:
        if qmp_stream is not None:
            qmp_stream.close()
        if qmp_connection is not None:
            qmp_connection.close()
        if process.poll() is None:
            process.send_signal(signal.SIGTERM)
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        try:
            while True:
                data = os.read(master, 65536)
                if not data:
                    break
                output.extend(data)
        except OSError:
            pass
        os.close(master)
        log_path.write_bytes(output)
        qmp_directory.cleanup()

    trace = output.decode(errors="replace")
    entropy_after_reset = trace.rfind(entropy_marker) > trace.rfind(reset_marker)
    if (not reset_sent or reset_marker not in trace or recovery_marker not in trace or
            not entropy_after_reset or
            any(token.decode() in trace for token in forbidden)):
        raise RuntimeError(
            f"QMP interruption point {names[point]} failed; see {log_path}"
        )


def storage_interruption_tests(timeout, pristine_disk):
    names = {
        1: "before-stage-flush",
        2: "after-stage-flush",
        3: "before-commit-flush",
        4: "after-commit-flush",
        5: "blob-before-stage-flush",
        6: "blob-after-stage-flush",
        7: "blob-before-commit-flush",
        8: "blob-after-commit-flush",
    }
    llvm_objcopy = tool("llvm-objcopy", llvm=True)
    microkit = SDK / "bin/microkit"
    required_images = (
        "storage.system", "rust_vault_disk.elf", "rust_vault_test_client.elf",
        "rust_entropy_rng.elf",
        "blk_driver.elf", "blk_virt.elf", "serial_driver.elf", "serial_virt_tx.elf",
    )
    for point, name in names.items():
        case_dir = STORAGE_BUILD / "flush-interruptions" / name
        if case_dir.exists():
            shutil.rmtree(case_dir)
        case_dir.mkdir(parents=True)
        for filename in required_images:
            shutil.copy2(STORAGE_BUILD / filename, case_dir / filename)
        config = case_dir / "interrupt-point.bin"
        config.write_bytes(struct.pack("<I", point))
        run([llvm_objcopy, "--update-section",
             f".storage_test_config={config}",
             case_dir / "rust_vault_test_client.elf"])
        run([microkit, case_dir / "storage.system", "--search-path", case_dir,
             "--board", LOCK["board"], "--config", LOCK["configuration"],
             "-o", case_dir / "loader.img", "-r", case_dir / "report.txt"])
