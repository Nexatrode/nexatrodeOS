def interactive_test(timeout):
    prepare_vault_disk(TEST_DISK, reset=True)
    master, slave = pty.openpty()
    process = subprocess.Popen(qemu_command(), stdin=slave, stdout=slave,
                               stderr=subprocess.STDOUT, close_fds=True)
    os.close(slave)
    output = bytearray()
    deadline = time.monotonic() + timeout
    sent_status = sent_integer_overflow = sent_trailing_input = False
    sent_overlong_line = sent_server_overflow = sent_calculation = False
    status_prompt_count = integer_prompt_count = trailing_prompt_count = 0
    overlong_prompt_count = server_overflow_prompt_count = 0
    status_heartbeat_count = integer_heartbeat_count = trailing_heartbeat_count = 0
    overlong_heartbeat_count = server_overflow_heartbeat_count = 0
    status_sent_at = integer_sent_at = trailing_sent_at = 0.0
    overlong_sent_at = server_overflow_sent_at = 0.0
    crash_requests = crash_completions = 0
    completed_at = None
    crash_complete = "CRASH COMPLETE: crasher stopped; server remains active"
    restart_ack = "crasher restarted; watching the supervisor handle its fault"
    forbidden = ["FAIL:", "MON|ERROR", "Kernel panic", "Reply object already",
                 "error: clock service did not respond"]
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(master, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                for key, _ in selector.select(timeout=0.05):
                    try:
                        data = os.read(key.fd, 65536)
                    except OSError:
                        data = b""
                    if data:
                        output.extend(data)
                trace = output.decode(errors="replace")
                if any(marker in trace for marker in forbidden):
                    raise RuntimeError(
                        f"Interactive QEMU test emitted an error; see build/interactive.log"
                    )
                prompt_count = trace.count("> ")
                heartbeat_count = trace.count("[heartbeat:")
                if "[boot isolation checks complete; console ready]" in trace and not sent_status:
                    os.write(master, b"status\n")
                    sent_status = True
                    status_prompt_count = prompt_count
                    status_heartbeat_count = heartbeat_count
                    status_sent_at = time.monotonic()
                usage_count = trace.count("usage: calc NUMBER + NUMBER")
                if (sent_status and "isolated faults handled:" in trace and
                        (prompt_count > status_prompt_count or
                         heartbeat_count > status_heartbeat_count or
                         time.monotonic() - status_sent_at > 0.5) and
                        not sent_integer_overflow):
                    os.write(master, b"calc 18446744073709551616 + 1\n")
                    sent_integer_overflow = True
                    integer_prompt_count = prompt_count
                    integer_heartbeat_count = heartbeat_count
                    integer_sent_at = time.monotonic()
                if (sent_integer_overflow and usage_count >= 1 and
                        (prompt_count > integer_prompt_count or
                         heartbeat_count > integer_heartbeat_count or
                         time.monotonic() - integer_sent_at > 0.5) and
                        not sent_trailing_input):
                    os.write(master, b"calc 1 + 1 trailing\n")
                    sent_trailing_input = True
                    trailing_prompt_count = prompt_count
                    trailing_heartbeat_count = heartbeat_count
                    trailing_sent_at = time.monotonic()
                if (sent_trailing_input and usage_count >= 2 and
                        (prompt_count > trailing_prompt_count or
                         heartbeat_count > trailing_heartbeat_count or
                         time.monotonic() - trailing_sent_at > 0.5) and
                        not sent_overlong_line):
                    os.write(master, b"x" * 70 + b"\n")
                    sent_overlong_line = True
                    overlong_prompt_count = prompt_count
                    overlong_heartbeat_count = heartbeat_count
                    overlong_sent_at = time.monotonic()
                if (sent_overlong_line and "error: command is too long" in trace and
                        (prompt_count > overlong_prompt_count or
                         heartbeat_count > overlong_heartbeat_count or
                         time.monotonic() - overlong_sent_at > 0.5) and
                        not sent_server_overflow):
                    os.write(master, b"calc 18446744073709551615 + 1\n")
                    sent_server_overflow = True
                    server_overflow_prompt_count = prompt_count
                    server_overflow_heartbeat_count = heartbeat_count
                    server_overflow_sent_at = time.monotonic()
                if (sent_server_overflow and "error: unsigned addition overflow" in trace and
                        (prompt_count > server_overflow_prompt_count or
                         heartbeat_count > server_overflow_heartbeat_count or
                         time.monotonic() - server_overflow_sent_at > 0.5) and
                        not sent_calculation):
                    os.write(master, b"calc 21 + 21\n")
                    sent_calculation = True
                if (sent_calculation and "= 42" in trace and "[heartbeat:" in trace and
                        crash_requests == 0):
                    os.write(master, b"crash\n")
                    crash_requests = 1
                # Console prompts and passive-domain debug output can share the
                # serial stream. A prompt may land in the middle of this line.
                observed_completions = trace.replace("> ", "").count(crash_complete)
                if observed_completions > crash_completions:
                    crash_completions = observed_completions
                if (crash_completions == 1 and crash_requests == 1 and
                        trace.count(restart_ack) >= 1):
                    os.write(master, b"crash\n")
                    crash_requests += 1
                if crash_completions >= 2 and trace.count(restart_ack) >= 2:
                    completed_at = completed_at or time.monotonic()
                    if time.monotonic() - completed_at > 0.3:
                        break
                if process.poll() is not None:
                    raise RuntimeError("QEMU exited during interactive test")
    finally:
        if process.poll() is None:
            process.terminate()
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        try:
            while True:
                data = os.read(master, 65536)
                if not data:
                    break
                output.extend(data)
        except OSError:
            pass
        os.close(master)
        (BUILD / "interactive.log").write_bytes(output)

    trace = output.decode(errors="replace")
    namespace_markers = [
        "NAMESPACE|NOTES|PASS: malformed requests left its namespace unchanged",
        "NAMESPACE|CONTACTS|PASS: malformed requests left its namespace unchanged",
    ]
    if (not sent_status or not sent_integer_overflow or not sent_trailing_input or
            not sent_overlong_line or not sent_server_overflow or not sent_calculation or
            trace.count("usage: calc NUMBER + NUMBER") < 2 or
            "error: command is too long" not in trace or
            "error: unsigned addition overflow" not in trace or
            crash_requests < 2 or crash_completions < 2 or
            any(marker not in trace for marker in namespace_markers) or
            not re.search(r"uptime: [0-9]+ seconds", trace) or
            "[heartbeat:" not in trace or "= 42" not in trace or
            trace.replace("> ", "").count(crash_complete) < 2 or
            trace.count(restart_ack) < 2 or
            trace.count("CRASHER: restart attempt 2; private state retained") < 1 or
            trace.count("CRASHER: restart attempt 3; private state retained") < 1 or
            trace.count("PASS: kernel blocked crasher write at 0x40000000") < 3):
        raise RuntimeError("Interactive checks or crasher state persistence failed; see build/interactive.log")
    print("Interactive check: PASS. RTC, malformed-input rejection, calculator, and repeated fault recovery work.")


