                if not data:
                    break
                output.extend(data)
        except OSError:
            pass
        os.close(master)
        (BUILD / "budget-pressure.log").write_bytes(output)

    trace = output.decode(errors="replace")
    if (not sent_status or not sent_calculation or pressure_marker not in trace or
            "CLIENT: baseline passed; triggering isolated crash" not in trace or
            "ISOLATION COMPLETE:" in trace or "isolated faults handled:" not in trace or
            "uptime:" not in trace or "= 42" not in trace or
            trace.find("[heartbeat:", trace.find(pressure_marker)) < 0 or
            any(marker in trace for marker in forbidden)):
        raise RuntimeError("CPU budget did not preserve console/clock progress; see build/budget-pressure.log")
    print("Budget pressure check: PASS. Console, clock, and calculator progress while the crasher spins.")


def crypto_unit_test():
    run([tool("cargo"), "+nightly-2026-09-25", "test", "--locked", "--lib",
         "--manifest-path", ROOT / "rust/Cargo.toml"], cwd=ROOT)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["setup", "build", "run", "test", "test-storage",
                                             "test-graphics", "test-input", "test-net",
                                             "utm-graphics", "utm-net",
                                             "backup-export", "backup-restore", "utm"])
    parser.add_argument("--timeout", type=float, default=20,
                        help="boot-test timeout in seconds (default: 20)")
    parser.add_argument("--disk", type=Path, default=PERSISTENT_DISK,
                        help="raw vault disk image (default: build/personal-os-disk.img)")
    parser.add_argument("--archive", type=Path, help="backup archive for backup-restore")
    parser.add_argument("--output", type=Path,
                        help="new archive or disk-image path; existing files are not overwritten")
    parser.add_argument("--profile", type=Path,
                        help="UTM output bundle path for utm-graphics; default is dist/Personal OS Graphics.utm")
    parser.add_argument("--allow-rollback", action="store_true",
                        help="explicitly restore generations older than the selected source disk")
    parser.add_argument("--budget-pressure", action="store_true",
                        help="run the CPU-hog scheduling test instead of normal QEMU checks")
    args = parser.parse_args()
    if args.command == "setup":
        setup()
        print(f"Ready: {SDK}")
        return
    if args.budget_pressure and args.command != "test":
        parser.error("--budget-pressure is only valid with the test command")
    if args.allow_rollback and args.command != "backup-restore":
        parser.error("--allow-rollback is only valid with the backup-restore command")
    if args.command == "test-storage":
        storage_test(args.timeout)
        return
    if args.command == "test-graphics":
        graphics_test(args.timeout)
        return
    if args.command == "test-net":
        net_test(args.timeout)
        return
    if args.command == "test-input":
        input_test(args.timeout)
        return
    if args.command == "utm-graphics":
        export_utm_graphics(args.timeout, args.profile)
        return
    if args.command == "utm-net":
        export_utm_net()
        return
    if args.command == "backup-export":
        if args.output is None:
            parser.error("backup-export requires --output <new-archive-file>")
        ensure_disk_stopped(args.disk)
        run_backup_cli("export", args.disk.resolve(), args.output.resolve())
        return
    if args.command == "backup-restore":
        if args.archive is None or args.output is None:
            parser.error("backup-restore requires --archive <file> and --output <new-disk-image>")
        ensure_disk_stopped(args.disk)
        restore_args = ["restore", args.archive.resolve(), args.disk.resolve(), args.output.resolve()]
        if args.allow_rollback:
            restore_args.append("--allow-rollback")
        run_backup_cli(*restore_args)
        return
    build(budget_pressure=args.budget_pressure)
    if args.command == "run":
        print("Commands: help, status, calc A + B, crash. QEMU exits with Ctrl-A then X.", flush=True)
        command = qemu_command(args.disk)
        os.execv(command[0], command)
    elif args.command == "test":
        if args.budget_pressure:
            try:
                budget_pressure_test(args.timeout)
            finally:
                # Leave build/ with the normal, non-hog image after this test.
                build()
        else:
            crypto_unit_test()
            test(args.timeout)
            test(args.timeout, reset_disk=False)
            verify_encrypted_disk(TEST_DISK)
            backup_round_trip_test(args.timeout)
            legacy_migration_test(args.timeout)
            interactive_test(args.timeout)
    elif args.command == "utm":
        export_utm()


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, subprocess.CalledProcessError, OSError) as error:
        print(f"Error: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
