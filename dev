def ensure_utm_bundle_stopped(bundle):
    """Avoid replacing an image that an active UTM QEMU process has loaded."""
    loader = str((bundle / "Data" / "loader.elf").resolve())
    processes = subprocess.check_output(["ps", "-axo", "args="], text=True)
    active = any(loader in command and "qemu" in command.lower()
                 for command in processes.splitlines())
    if active:
        raise RuntimeError(
            f"Refusing to update the running UTM VM at {bundle}; stop Personal OS first"
        )


def ensure_utm_storage_profile(profile):
    """Attach the QEMU virtio-mmio disk expected by the generated system."""
    drives = profile.setdefault("Drive", [])
    disk = next((item for item in drives
                 if item.get("ImageName") == "personal-os-disk.img"), None)
    if disk is None:
        disk = {
            "Identifier": str(uuid.uuid4()).upper(),
            "ImageName": "personal-os-disk.img",
            "ImageType": "Disk",
            "Interface": "None",
            "InterfaceVersion": 1,
            "ReadOnly": False,
        }
        drives.append(disk)
    identifier = disk.get("Identifier")
    if not identifier:
        raise RuntimeError("UTM data disk is missing its stable Identifier")
    disk.update({"ImageType": "Disk", "Interface": "None",
                 "InterfaceVersion": 1, "ReadOnly": False})

    qemu = profile.setdefault("QEMU", {})
    arguments = qemu.setdefault("AdditionalArguments", [])
    # Earlier exporter builds wrote the newer scripting-style dictionary
    # representation. The UTM 5.0.x bundle format uses plain strings.
    normalized_arguments = []
    for item in arguments:
        if isinstance(item, dict):
            item = item.get("argumentString", item)
        if isinstance(item, str) and item in normalized_arguments:
            continue
        normalized_arguments.append(item)
    arguments = normalized_arguments
    obsolete_rng = "-device virtio-rng-device,bus=virtio-mmio-bus.2"
    arguments = [argument for argument in arguments if argument != obsolete_rng]
    required = [
        "-global virtio-mmio.force-legacy=false",
        f"-device virtio-blk-device,drive=drive{identifier},bus=virtio-mmio-bus.1",
        "-device virtio-rng-device,bus=virtio-mmio-bus.8",
    ]
    for argument in required:
        if argument not in arguments:
            arguments.append(argument)
    qemu["AdditionalArguments"] = arguments


def test(timeout, reset_disk=True, disk_image=TEST_DISK, prepare_disk=None,
         app_generation=None, log_name=None):
    if prepare_disk is None:
        prepare_disk = reset_disk
    if prepare_disk:
        prepare_vault_disk(disk_image, reset=True)
    if app_generation is None:
        app_generation = 1 if reset_disk else 2
    if log_name is None:
        log_name = "serial.log" if reset_disk else "persistent-reboot.log"
    expected = [
        "ENTROPY|READY: QEMU VirtIO RNG initialized",
        "PASS: QEMU VirtIO RNG delivers fresh samples",
        "ENTROPY|PASS: four distinct 128-bit samples received",
        "PASS: Rust server computes 19 + 23 = 42",
        "PASS: Rust server rejects missing operands",
        "PASS: Rust server rejects unknown operation",
        "PASS: Rust server rejects integer overflow",
        "PASS: rejected requests leave Rust server state unchanged",
        "PASS: Rust server responds after malformed requests",
        "PASS: Rust server private page initialized",
        "PASS: C reference server answers protected call",
        "PASS: C reference server rejects wrong message length",
        "PASS: C reference server rejects unknown operation",
        "PASS: C reference server rejects unsigned overflow",
        "PASS: vault reads latest committed record",
        "PASS: vault accepts versioned owner update",
        "PASS: vault reads back committed version",
        "PASS: vault rejects stale version",
        "PASS: vault keeps latest version after stale write",
        "NAMESPACE|NOTES|PASS: reads its own namespace",
        "NAMESPACE|NOTES|PASS: writes and reads back its own namespace",
        f"NAMESPACE|NOTES|GENERATION:{app_generation}",
        "NAMESPACE|NOTES|PASS: rejects caller-selected namespace fields",
        "NAMESPACE|NOTES|PASS: malformed requests left its namespace unchanged",
        "PASS: Notes app is confined to its own vault namespace",
        "NAMESPACE|CONTACTS|PASS: reads its own namespace",
        "NAMESPACE|CONTACTS|PASS: writes and reads back its own namespace",
        f"NAMESPACE|CONTACTS|GENERATION:{app_generation}",
        "NAMESPACE|CONTACTS|PASS: rejects caller-selected namespace fields",
        "NAMESPACE|CONTACTS|PASS: malformed requests left its namespace unchanged",
        "PASS: Contacts app is confined to its own vault namespace",
        "CLIENT: baseline passed; triggering isolated crash",
        "CRASHER: attempt 1; private state initialized",
        "PASS: vault denied untrusted child read",
        "PASS: vault denied untrusted child write",
        "CRASHER: attempting forbidden write at 0x40000000",
        "PASS: kernel blocked crasher write at 0x40000000",
        "CLIENT: crasher stopped; checking independent server",
        "PASS: server private page unchanged after fault",
        "PASS: server counter preserved after fault",
        "PASS: vault record unchanged after denied child write",
        "PASS: independent server computes 100 + 23 after fault",
        "PASS: independent server state advances after fault",
        "ISOLATION COMPLETE: 27 checks passed; crasher stopped, services alive",
    ]
    namespace_markers = [
        "NAMESPACE|NOTES|PASS: reads its own namespace",
        "NAMESPACE|NOTES|PASS: writes and reads back its own namespace",
        "NAMESPACE|NOTES|PASS: rejects caller-selected namespace fields",
        "NAMESPACE|NOTES|PASS: malformed requests left its namespace unchanged",
        "NAMESPACE|CONTACTS|PASS: reads its own namespace",
        "NAMESPACE|CONTACTS|PASS: writes and reads back its own namespace",
        "NAMESPACE|CONTACTS|PASS: rejects caller-selected namespace fields",
        "NAMESPACE|CONTACTS|PASS: malformed requests left its namespace unchanged",
    ]
    output = bytearray()
    process = subprocess.Popen(qemu_command(disk_image), stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    deadline = time.monotonic() + timeout
    completed_at = None
    forbidden = [b"FAIL:", b"MON|ERROR", b"Kernel panic"]
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                for key, _ in selector.select(timeout=0.1):
                    data = os.read(key.fileobj.fileno(), 65536)
                    if not data:
                        break
                    output.extend(data)
                    sys.stdout.buffer.write(data)
                    sys.stdout.buffer.flush()
                # Allow the guest to finish its diagnostic line after either
                # outcome; debug-console characters can arrive one at a time.
                namespace_tests_done = all(marker.encode() in output
                                           for marker in namespace_markers)
                if ((expected[-1].encode() in output and namespace_tests_done) or
                        any(token in output for token in forbidden)) and completed_at is None:
                    completed_at = time.monotonic()
                if process.poll() is not None:
                    raise RuntimeError(f"QEMU exited unexpectedly ({process.returncode})")
                if completed_at is not None and time.monotonic() - completed_at > 0.5:
                    break
    finally:
        process.terminate()
        try:
            tail, _ = process.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            tail, _ = process.communicate()
        output.extend(tail)
        (BUILD / log_name).write_bytes(output)
    text = output.decode(errors="replace")
    cursor = 0
    missing = []
    for line in expected:
        position = text.find(line, cursor)
        if position < 0:
            missing.append(line)
        else:
            cursor = position + len(line)
    missing_namespaces = [marker for marker in namespace_markers if marker not in text]
    recovered = "VAULT: recovered committed namespace records from disk" in text
    if (missing or missing_namespaces or any(token in output for token in forbidden) or
            (not reset_disk and not recovered)):
        raise RuntimeError(f"Boot test failed; missing/out of order: {missing}; "
                           f"missing namespace checks: {missing_namespaces}; "
                           f"disk recovery observed: {recovered}. See build/{log_name}")
    if reset_disk:
        print("Host and namespace checks: PASS. Saved build/serial.log and build/build-info.json.")
    else:
        print("Persistence check: PASS. The regular system recovered its committed vault record on a second QEMU boot.")


def verify_encrypted_disk(path):
    image = Path(path).read_bytes()
    partition_offset = 2048 * 512
    namespace_first_blocks = [0, 4, 6]
    small_commit_salt = 0x6A09E667F3BCC909
    blob_commit_salt = 0x3C6EF372FE94F82B
    demo_values = [
        0x4E4F5445,
        0x4E4F544553415050,
        0x434F4E5441435453,
    ]
    found = []
    for namespace, first_block in enumerate(namespace_first_blocks):
        for slot_index in range(2):
            block = first_block + slot_index
            start = partition_offset + block * 4096
            slot = image[start:start + 4096]
            if len(slot) != 4096:
                raise RuntimeError(f"vault disk block {block} is truncated")
            if slot[:8] == b"PVLTREC1":
                version = int.from_bytes(slot[8:12], "little")
                generation = int.from_bytes(slot[12:20], "little")
                marker = int.from_bytes(slot[56:64], "little")
                expected_nonce = b"PV1" + bytes([namespace]) + generation.to_bytes(8, "little")
                if (version != 1 or generation == 0 or
                        marker != (generation ^ small_commit_salt) or
                        slot[20:32] != expected_nonce or any(slot[64:])):
                    raise RuntimeError(f"vault disk block {block} has invalid scalar metadata")
                encrypted_record = slot[:72]
            elif slot[:8] == b"PVLTBLB1":
                version = int.from_bytes(slot[8:12], "little")
                generation = int.from_bytes(slot[12:20], "little")
                length = int.from_bytes(slot[20:24], "little")
                marker_offset = 36 + length + 16
                if (version != 1 or generation == 0 or length > 4036 or
                        marker_offset + 8 > 4096):
                    raise RuntimeError(f"vault disk block {block} has invalid blob metadata")
                marker = int.from_bytes(slot[marker_offset:marker_offset + 8], "little")
                expected_nonce = b"PB1" + bytes([namespace]) + generation.to_bytes(8, "little")
                if (marker != (generation ^ blob_commit_salt) or
                        slot[24:36] != expected_nonce or any(slot[marker_offset + 8:])):
                    raise RuntimeError(f"vault disk block {block} has invalid blob metadata")
                encrypted_record = slot[36:marker_offset - 8]
            else:
                raise RuntimeError(f"vault disk block {block} is not an encrypted record")
            if any(value.to_bytes(8, "little") in encrypted_record for value in demo_values):
                raise RuntimeError(f"vault disk block {block} contains a plaintext demo value")
            found.append((namespace, generation))
    if len(found) != 6:
        raise RuntimeError("vault disk inspection did not find six encrypted slots")
    print("Encrypted disk check: PASS. Six committed scalar/blob records contain ciphertext, not the demo values.")


def run_backup_cli(*arguments):
    run(backup_cli_command(*arguments), cwd=ROOT)


def backup_cli_command(*arguments):
    return [tool("cargo"), "+nightly-2026-09-25", "run", "--locked", "--features",
            "host-backup", "--bin", "vault_backup_cli", "--manifest-path",
            ROOT / "rust/Cargo.toml", "--", *arguments]


def run_backup_cli_expect_failure(expected, *arguments):
    result = subprocess.run(backup_cli_command(*arguments), cwd=ROOT, text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if result.returncode == 0 or expected not in result.stdout:
        raise RuntimeError(
            f"backup CLI failure check did not match {expected!r}; output:\n{result.stdout}"
        )


def ensure_disk_stopped(path):
    resolved = str(Path(path).resolve())
    processes = subprocess.check_output(["ps", "-axo", "args="], text=True)
    active = any("qemu" in command.lower() and resolved in command
                 for command in processes.splitlines())
    if active:
        raise RuntimeError(
            f"Refusing to back up an active disk image at {resolved}; stop its QEMU/UTM VM first"
        )


def backup_round_trip_test(timeout):
    archive = BUILD / "test-vault-backup.pvlt"
    restored_disk = BUILD / "backup-restored-disk.img"
    older_source = BUILD / "rollback-older-source.img"
    older_archive = BUILD / "rollback-older-backup.pvlt"
    rejected_restore = BUILD / "rollback-rejected.img"
    allowed_restore = BUILD / "rollback-allowed.img"
    for path in (archive, restored_disk, older_source, older_archive,
                 rejected_restore, allowed_restore):
        if path.exists():
            path.unlink()
    source_digest = sha256(TEST_DISK)
    run_backup_cli("export", TEST_DISK, archive)
    if archive.stat().st_size != 16 + 3 * 4096:
        raise RuntimeError("vault backup archive is not the expected full-block format")
    run_backup_cli("restore", archive, TEST_DISK, restored_disk)
    if sha256(TEST_DISK) != source_digest:
        raise RuntimeError("backup restore modified its source disk image")
    test(timeout, reset_disk=False, disk_image=restored_disk, prepare_disk=False,
         app_generation=3, log_name="backup-restore.log")
    verify_encrypted_disk(restored_disk)
    print("Backup round-trip check: PASS. Exported records restored into a new disk image and recovered by QEMU.")

    make_older_generation_copy(TEST_DISK, older_source)
    run_backup_cli("export", older_source, older_archive)
    rollback_error = "backup would roll back"
    source_digest = sha256(TEST_DISK)
    run_backup_cli_expect_failure(
        rollback_error, "restore", older_archive, TEST_DISK, rejected_restore
    )
    if rejected_restore.exists() or sha256(TEST_DISK) != source_digest:
        raise RuntimeError("rollback refusal created an output or modified the source disk")
    run_backup_cli("restore", older_archive, TEST_DISK, allowed_restore, "--allow-rollback")
    if not allowed_restore.exists() or sha256(TEST_DISK) != source_digest:
        raise RuntimeError("explicit rollback restore failed or modified the source disk")
    print("Rollback guard check: PASS. Older generations are refused unless explicitly allowed.")


def make_older_generation_copy(source, output):
    shutil.copyfile(source, output)
    partition_start = 2048 * 512
    namespace_blocks = (0, 4, 6)
    small_commit_salt = 0x6A09E667F3BCC909
    blob_commit_salt = 0x3C6EF372FE94F82B
    with Path(output).open("r+b") as disk:
        for namespace, first_block in enumerate(namespace_blocks):
            committed = []
            for slot_index in range(2):
                block = first_block + slot_index
                disk.seek(partition_start + block * 4096)
                slot = disk.read(4096)
                if len(slot) == 4096 and slot[:8] == b"PVLTREC1":
                    generation = int.from_bytes(slot[12:20], "little")
                    marker = int.from_bytes(slot[56:64], "little")
                    if generation ^ small_commit_salt == marker:
                        committed.append((generation, slot_index, block))
                elif len(slot) == 4096 and slot[:8] == b"PVLTBLB1":
                    generation = int.from_bytes(slot[12:20], "little")
                    length = int.from_bytes(slot[20:24], "little")
                    marker_offset = 36 + length + 16
                    if (length <= 4036 and marker_offset + 8 <= 4096 and
                            generation ^ blob_commit_salt == int.from_bytes(
                                slot[marker_offset:marker_offset + 8], "little")):
                        committed.append((generation, slot_index, block))
            if len(committed) != 2 or committed[0][0] == committed[1][0]:
                raise RuntimeError(
                    f"namespace {namespace} does not have two generations for rollback test"
                )
            _, _, newest_block = max(committed)
            disk.seek(partition_start + newest_block * 4096)
            disk.write(bytes(4096))
        disk.flush()
        os.fsync(disk.fileno())


def prepare_legacy_test_disk(path):
    prepare_vault_disk(path, reset=True)
    mask = (1 << 64) - 1
    commit_salt = 0x6A09E667F3BCC909
    checksum_salt = 0xBB67AE8584CAA73B
    legacy = [
        (0, 1, 9, 0x4E4F5445),
        (1, 5, 2, 0x4E4F544553415050),
        (2, 7, 2, 0x434F4E5441435453),
    ]
    with Path(path).open("r+b") as disk:
        for _namespace, block, generation, value in legacy:
            rotate_left = ((generation << 17) | (generation >> 47)) & mask
            rotate_right = ((value >> 9) | (value << 55)) & mask
            checksum = rotate_left ^ rotate_right ^ checksum_salt
            body = struct.pack(
                "<QQQQ", generation, value, checksum, generation ^ commit_salt
            )
            disk.seek(2048 * 512 + block * 4096)
            disk.write(body + bytes(4096 - len(body)))
        disk.flush()
        os.fsync(disk.fileno())


