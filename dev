    if any(marker in trace for marker in forbidden):
        raise RuntimeError(f"Network echo_server guest faulted after DHCP; inspect {serial_log}")
    if "Failed to bind the UDP socket" in trace or "Failed to open a UDP socket" in trace:
        raise RuntimeError(f"Network echo_server failed to bind UDP; inspect {serial_log}")
    print(
        f"VirtIO network smoke: PASS; both echo clients got DHCP and UDP echo "
        f"returned through SLIRP; serial saved to {serial_log}"
    )
