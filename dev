def storage_snapshot_replay_test(timeout, pristine_disk):
    """Restore a complete pre-boot VM snapshot and compare short RNG fingerprints."""
    qemu_img = tool("qemu-img")
    case_dir = STORAGE_BUILD / "snapshot-replay"
    if case_dir.exists():
        shutil.rmtree(case_dir)
    case_dir.mkdir(parents=True)
    snapshot_disk = case_dir / "snapshot-disk.qcow2"
    run([qemu_img, "convert", "-f", "raw", "-O", "qcow2", pristine_disk,
         snapshot_disk])
    qmp_directory = tempfile.TemporaryDirectory(prefix="pssr-", dir="/tmp")
    qmp_path = Path(qmp_directory.name) / "q.sock"
    log_path = case_dir / "qmp-snapshot-replay.log"
    output = bytearray()
    master, slave = pty.openpty()
    process = subprocess.Popen(
        storage_qemu_command(STORAGE_BUILD / "loader.img", snapshot_disk, qmp_path,
                             disk_format="qcow2", paused=True),
        cwd=case_dir, stdin=slave, stdout=slave, stderr=subprocess.STDOUT,
        close_fds=True,
    )
    os.close(slave)
    qmp_connection = qmp_stream = None
    fingerprints = []
    forbidden = (b"FAIL:", b"MON|ERROR", b"Kernel panic")
    fingerprint_re = re.compile(rb"STORAGE\|ENTROPY\|FINGERPRINT:([0-9a-f]{16})")
    deadline = time.monotonic() + timeout

    def collect_until_fingerprint(count):
        with selectors.DefaultSelector() as selector:
            selector.register(master, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                for key, _ in selector.select(timeout=0.1):
                    try:
                        data = os.read(key.fd, 65536)
                    except OSError:
                        data = b""
                    if data:
                        output.extend(data)
                        sys.stdout.buffer.write(data)
                        sys.stdout.buffer.flush()
                        found = fingerprint_re.findall(output)
                        if len(found) >= count:
                            return [value.decode("ascii") for value in found]
                if any(token in output for token in forbidden):
                    raise RuntimeError("guest reported a failure during snapshot replay test")
                if process.poll() is not None:
                    raise RuntimeError(
                        f"QEMU exited during snapshot replay test ({process.returncode})"
                    )
        raise RuntimeError(f"timed out waiting for RNG fingerprint {count}")

    try:
        qmp_connection, qmp_stream = qmp_connect(qmp_path, process, timeout)
        qmp_hmp(qmp_stream, "savevm entropy-before-boot")
        qmp_execute(qmp_stream, "cont")
        fingerprints = collect_until_fingerprint(1)
        qmp_execute(qmp_stream, "stop")
        qmp_hmp(qmp_stream, "loadvm entropy-before-boot")
        qmp_execute(qmp_stream, "cont")
        fingerprints = collect_until_fingerprint(2)
    finally:
        if qmp_stream is not None:
            qmp_stream.close()
        if qmp_connection is not None:
            qmp_connection.close()
        if process.poll() is None:
            process.send_signal(signal.SIGTERM)
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        try:
            while True:
                data = os.read(master, 65536)
                if not data:
                    break
                output.extend(data)
        except OSError:
            pass
        os.close(master)
        log_path.write_bytes(output)
        qmp_directory.cleanup()

    if len(fingerprints) < 2 or fingerprints[0] == fingerprints[1]:
        raise RuntimeError(
            f"VM snapshot replayed the RNG fingerprint ({fingerprints}); see {log_path}"
        )
    print("VM snapshot replay check: PASS. Restoring the pre-boot VM snapshot delivered a different 64-bit RNG fingerprint.")


def storage_snapshot_clone_test(timeout, pristine_disk):
    """Boot two independent QEMU clones from the same saved pre-boot VM state."""
    qemu_img = tool("qemu-img")
    case_dir = STORAGE_BUILD / "snapshot-clones"
    if case_dir.exists():
        shutil.rmtree(case_dir)
    case_dir.mkdir(parents=True)
    template_disk = case_dir / "snapshot-template.qcow2"
    run([qemu_img, "convert", "-f", "raw", "-O", "qcow2", pristine_disk,
         template_disk])
    qmp_directory = tempfile.TemporaryDirectory(prefix="pssc-", dir="/tmp")
    fingerprint_re = re.compile(rb"STORAGE\|ENTROPY\|FINGERPRINT:([0-9a-f]{16})")
    names = ("clone-a", "clone-b")
    vms = []

    def start_vm(name, disk):
        qmp_path = Path(qmp_directory.name) / f"{name}.sock"
        log_path = case_dir / f"{name}.log"
        master, slave = pty.openpty()
        process = subprocess.Popen(
            storage_qemu_command(STORAGE_BUILD / "loader.img", disk, qmp_path,
                                 disk_format="qcow2", paused=True),
            cwd=case_dir, stdin=slave, stdout=slave, stderr=subprocess.STDOUT,
            close_fds=True,
        )
        os.close(slave)
        return {"name": name, "master": master, "process": process,
                "qmp_path": qmp_path, "qmp_connection": None, "qmp_stream": None,
                "output": bytearray(), "log_path": log_path}

    def stop_vm(vm):
        stream = vm["qmp_stream"]
        connection = vm["qmp_connection"]
        if stream is not None:
            stream.close()
        if connection is not None:
            connection.close()
        process = vm["process"]
        if process.poll() is None:
            process.send_signal(signal.SIGTERM)
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        try:
            while True:
                data = os.read(vm["master"], 65536)
                if not data:
                    break
                vm["output"].extend(data)
        except OSError:
            pass
        os.close(vm["master"])
        vm["log_path"].write_bytes(vm["output"])

    seed_disk = template_disk
    seed = start_vm("snapshot-seed", seed_disk)
    vms.append(seed)
    try:
        seed["qmp_connection"], seed["qmp_stream"] = qmp_connect(
            seed["qmp_path"], seed["process"], timeout
        )
        qmp_hmp(seed["qmp_stream"], "savevm entropy-before-boot")
    finally:
        stop_vm(seed)
        vms.remove(seed)

    fingerprints = {}
    forbidden = (b"FAIL:", b"MON|ERROR", b"Kernel panic")
    deadline = time.monotonic() + timeout
    try:
        for name in names:
            clone_disk = case_dir / f"{name}.qcow2"
            shutil.copyfile(template_disk, clone_disk)
            vms.append(start_vm(name, clone_disk))
        for vm in vms:
            vm["qmp_connection"], vm["qmp_stream"] = qmp_connect(
                vm["qmp_path"], vm["process"], timeout
            )
            qmp_hmp(vm["qmp_stream"], "loadvm entropy-before-boot")
        for vm in vms:
            qmp_execute(vm["qmp_stream"], "cont")

        with selectors.DefaultSelector() as selector:
            for vm in vms:
                selector.register(vm["master"], selectors.EVENT_READ, vm)
            while time.monotonic() < deadline and len(fingerprints) < len(vms):
                for key, _ in selector.select(timeout=0.1):
                    vm = key.data
                    try:
                        data = os.read(key.fd, 65536)
                    except OSError:
                        data = b""
                    if data:
                        vm["output"].extend(data)
                        sys.stdout.buffer.write(data)
                        sys.stdout.buffer.flush()
                        found = fingerprint_re.findall(vm["output"])
                        if found:
                            fingerprints[vm["name"]] = found[0].decode("ascii")
                for vm in vms:
                    if any(token in vm["output"] for token in forbidden):
                        raise RuntimeError(f"{vm['name']} reported a guest failure")
                    if vm["process"].poll() is not None:
                        raise RuntimeError(
                            f"{vm['name']} QEMU exited ({vm['process'].returncode})"
                        )
        if len(fingerprints) != len(vms):
            raise RuntimeError(
                f"timed out waiting for both clone fingerprints: {fingerprints}"
            )
    finally:
        for vm in vms:
            stop_vm(vm)
        qmp_directory.cleanup()

    if fingerprints[names[0]] == fingerprints[names[1]]:
        raise RuntimeError(
            f"independent VM clones returned the same RNG fingerprint: {fingerprints}"
        )
    print("VM snapshot clone check: PASS. Independent QEMU instances restored from the same VM snapshot delivered different 64-bit RNG fingerprints.")


