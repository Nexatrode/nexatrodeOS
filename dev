    reboot_frame = gpu_build / "input-reboot-frame.ppm"
    reboot_qmp = Path(tempfile.gettempdir()) / f"pgpuos-input-reboot-{uuid.uuid4().hex[:8]}.sock"
    command = list(qemu_command)
    command[command.index("-serial") + 1] = f"file:{reboot_serial}"
    command[command.index("-qmp") + 1] = f"unix:{reboot_qmp},server=on,wait=off"
    reboot_serial.unlink(missing_ok=True)
    reboot_frame.unlink(missing_ok=True)
    process = None
    try:
        with reboot_errors.open("wb") as errors:
            process = subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=errors)
            connection, stream = qmp_connect(reboot_qmp, process, timeout)
            with connection, stream:
                deadline = time.monotonic() + timeout
                while time.monotonic() < deadline:
                    trace = reboot_serial.read_text(errors="replace") if reboot_serial.exists() else ""
                    if "faulting PD:" in trace or "Failed assertion" in trace or "MON|ERROR" in trace:
                        raise RuntimeError(f"QEMU cold-boot persistence run faulted; inspect {reboot_serial}")
                    if ("UIINPUT|READY:" in trace and
                            "ISOLATION COMPLETE: 27 checks passed" in trace):
                        break
                    time.sleep(0.05)
                else:
                    raise RuntimeError(f"QEMU cold-boot persistence run did not initialize; inspect {reboot_serial}")

                def tap(x, y):
                    qmp_execute(stream, "input-send-event", {"events": [
                        {"type": "abs", "data": {"axis": "x", "value": x}},
                        {"type": "abs", "data": {"axis": "y", "value": y}},
                        {"type": "btn", "data": {"down": True, "button": "left"}},
                        {"type": "btn", "data": {"down": False, "button": "left"}},
                    ]})

                def tap_pixel(x, y):
                    tap((x * 32767 + 298) // 299, (y * 32767 + 398) // 399)

                def wait_for_saved_frame(focus, text="", scroll_start_line=None,
                                         notes_mode="edit", note_count=1,
                                         selected_note=0, delete_armed=False,
                                         notes_field="body"):
                    expected_key = input_frame_key(
                        focus, text, scroll_start_line, notes_mode, note_count,
                        selected_note, delete_armed, notes_field
                    )
                    park_x = (290 * 32767 + 298) // 299
                    park_y = (390 * 32767 + 398) // 399

                    def park_cursor():
                        qmp_execute(stream, "input-send-event", {"events": [
                            {"type": "abs", "data": {"axis": "x", "value": park_x}},
                            {"type": "abs", "data": {"axis": "y", "value": park_y}},
                        ]})

                    park_cursor()
                    deadline = time.monotonic() + timeout
                    attempt = 0
                    while time.monotonic() < deadline:
                        if attempt > 0 and attempt % 8 == 0:
                            park_cursor()
                        qmp_hmp(stream, f"screendump {reboot_frame}")
                        frame = reboot_frame.read_bytes() if reboot_frame.exists() else b""
                        parts = frame.split(b"\n", 3)
                        if (len(parts) == 4 and parts[0] == b"P6" and parts[2] == b"255" and
                                parts[3] == expected_pixels[expected_key]):
                            return
                        attempt += 1
                        time.sleep(0.05)
                    raise RuntimeError(
                        f"{focus} field did not restore as {text!r} after QEMU cold boot; inspect {reboot_serial}"
                    )

                tap_pixel(91, 84)  # Open the Notes card from the launcher.
                wait_for_saved_frame("notes", "AB", note_count=2, selected_note=1)
                tap_pixel(44, 208)  # Open the saved note list.
                wait_for_saved_frame("notes", "1 NOTE 1\n2 TWO", notes_mode="list",
                                     note_count=2, selected_note=1)
                tap_pixel(100, 137)  # Reopen the original multiline note.
                wait_for_saved_frame("notes", "AB\nCD\nEF\nGH", 1,
                                     note_count=2, selected_note=0)
                tap_pixel(44, 208)
                wait_for_saved_frame("notes", "1 NOTE 1\n2 TWO", notes_mode="list",
                                     note_count=2, selected_note=0)
                tap_pixel(255, 208)
                wait_for_saved_frame("notes", "1 NOTE 1\n2 TWO", notes_mode="list",
                                     note_count=2, selected_note=0, delete_armed=True)
                tap_pixel(255, 208)
                wait_for_saved_frame("notes", "1 TWO", notes_mode="list",
                                     note_count=1, selected_note=0)
                tap_pixel(83, 24)  # Open the persisted Contacts list.
                wait_for_saved_frame("contacts", "CONTACT 1 OF 2\nNAME B\nPHONE 5551234\nKEY BE12")
                tap_pixel(146, 208)  # Select the next contact with the DOWN control.
                wait_for_saved_frame("contacts", "CONTACT 2 OF 2\nNAME C\nPHONE 8675309\nKEY -")
                tap_pixel(235, 208)  # Remove the selected contact with DELETE.
                wait_for_saved_frame("contacts", "CONTACT 1 OF 1\nNAME B\nPHONE 5551234\nKEY BE12")
                tap_pixel(30, 24)  # Home
                wait_for_saved_frame("none")
                tap_pixel(80, 165)  # Open Calendar from the launcher.
                wait_for_saved_frame("calendar", "- MEET\n  0101 1200")
                tap_pixel(30, 24)
                wait_for_saved_frame("none")
                tap_pixel(220, 165)  # Open Messages shell from the launcher.
                wait_for_saved_frame("messages", "- KEY BE12CD34\n  SEALED 1")
                tap_pixel(30, 24)
                wait_for_saved_frame("none")
                tap_pixel(150, 206)  # Open Settings stub from the launcher.
                wait_for_saved_frame("settings", "LOCAL ONLY\nVAULT LOCAL\nNO NET YET\nNO ALERTS YET")
                qmp_execute(stream, "quit")
                process.wait(timeout=5)
    finally:
        if process is not None and process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
        reboot_qmp.unlink(missing_ok=True)

    trace = reboot_serial.read_text(errors="replace") if reboot_serial.exists() else ""
    if "ISOLATION COMPLETE: 27 checks passed" not in trace or "FAIL:" in trace:
        raise RuntimeError(f"QEMU cold-boot persistence run failed; inspect {reboot_serial}")


