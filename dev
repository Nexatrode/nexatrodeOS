    for elf_name in (
        "eth_driver.elf", "dhcp_client.elf", "network_virt_rx.elf",
        "network_virt_tx.elf", "network_copy.elf", "timer_driver.elf",
    ):
        shutil.copy2(fragment_build / elf_name, BUILD / elf_name)

    merged_system = net_build / "net-system.system"
    run([tool("python3"), ROOT / "tests/merge_network_system.py",
         "--base", BUILD / "system.system",
         "--network", fragment_build / "net.system",
         "--output", merged_system,
         "--elf-dir", BUILD])
    loader = net_build / "net-system-loader.img"
    run([SDK / "bin/microkit", merged_system, "--search-path", BUILD,
         "--board", LOCK["board"], "--config", LOCK["configuration"],
         "-o", loader, "-r", net_build / "net-system-report.txt"])
    guest_b_loader = fragment_build / "loader.img"
    if not guest_b_loader.exists():
        raise RuntimeError(f"net fragment build did not produce {guest_b_loader}")
    if not loader.exists():
        raise RuntimeError(f"merged net image is missing: {loader}")
